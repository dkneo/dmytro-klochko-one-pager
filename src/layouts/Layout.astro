---
import "../styles/global.css";
import AsciiShader from "../components/AsciiShader.astro";

interface Props {
  title: string;
  description: string;
  current?: "home" | "at-work" | "library";
}

const { title, description, current = "home" } = Astro.props;

const ogTitle = "dmytro klochko";
const ogDescription = "ceo at replika. product and engineering, out of art, chess and theatre.";

// Pages only. The in-page anchors belonged in the page, not in a header that
// then changed meaning on every other page.
const nav = [
  { label: "about", href: "/" },
  { label: "at work", href: "/at-work" },
  { label: "media", href: "/library" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="dmytro klochko" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
  </head>
  <body>
    <!--
                        ______
                     .-"      "-.
                    /            \
                   |,  .-.  .-.  ,|
                   | )(_o/  \o_)( |
                   |/     /\     \|
         (@_       (_     ^^     _)
    _     ) \_______\__|IIIIII|__/_______________________
   (_)@8@8{}<________|-\IIIIII/-|________________________>
          )_/        \          /
         (@           `--------`

              SEE YOU SPACE COWBOY...

    you read the source. that is the correct instinct.
    1@dmklochko.com
    -->
    <a class="skip-link" href="#main">skip to content</a>

    <div class="stars" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>

    <header class="site-header">
      <a class="masthead" href="/">
        dmytro klochko <span>/ ceo, replika</span>
      </a>
      <nav class="site-nav" aria-label="pages">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={
              (item.href === "/" ? current === "home" : item.href === `/${current}`)
                ? "page"
                : undefined
            }>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <AsciiShader
        class="ascii--bebop"
        src="/ascii/bebop-sheet.jpg"
        frames={28}
        cols={100}
        fps={11}
        black={0.1}
        white={0.99}
        gamma={1.15}
      />
      <p class="signoff">see you space cowboy&hellip;</p>
      <div class="foot-row">
        <p>© 2026 dmytro klochko</p>
        <a class="to-top" href="#top">back to top ↑</a>
      </div>
    </footer>

    <!--
      The only JavaScript on the site, and it removes motion rather than adding
      it. Looping autoplay is moving content that never stops, so WCAG 2.2.2
      wants a way out, and CSS cannot pause a video.
    -->
    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const v of document.querySelectorAll("video[autoplay]")) {
          v.removeAttribute("autoplay");
          v.pause();
        }
      }
    </script>
  </body>
</html>
