---
import "../styles/global.css";
import "../styles/dream.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "taste";
  /** Reachable by url, kept out of search. Not a robots.txt block: a blocked
      page is never crawled, so the tag below is never read and the bare url
      can still surface. */
  unlisted?: boolean;
}

const { title, description, current = "home", unlisted = false } = Astro.props;

const ogTitle = "dmytro klochko";
const ogDescription = "ceo at replika. product and engineering, out of art, chess and theatre.";

// No nav: one page, and the masthead is the way home. The crumb still names
// where you are when you are not on it.
---

<html lang="en" data-mode="dream">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#131a2b" />
    <!--
      One art direction now. Bebop lived here behind a toggle until the page
      it was skinning moved on without it; it is in the history if it is ever
      wanted back.
    -->
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {unlisted && <meta name="robots" content="noindex, follow" />}

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png?v=3", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="dmytro klochko" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL("/og.png?v=3", Astro.site)} />
  </head>
  <body>
    <!--
                        ______
                     .-"      "-.
                    /            \
                   |,  .-.  .-.  ,|
                   | )(_o/  \o_)( |
                   |/     /\     \|
         (@_       (_     ^^     _)
    _     ) \_______\__|IIIIII|__/_______________________
   (_)@8@8{}<________|-\IIIIII/-|________________________>
          )_/        \          /
         (@           `--------`

              SEE YOU SPACE COWBOY...

    you read the source. that is the correct instinct.
    1@dmklochko.com
    -->
    <a class="skip-link" href="#main">skip to content</a>

    <div class="stars" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
      <span class="stars-glow"></span>
    </div>

    <!-- The journey. Each chapter of the page names a scene — his own
         paintings — and the sky crossfades to match as you scroll. All
         layers are fixed; only opacity and compositor transforms move. -->
    <div class="scenes" aria-hidden="true">
      <i data-s="fire"></i>
      <i data-s="estuary"></i>
      <span class="sunpulse"></span>
      <span class="firelight"></span>
      <span class="glints"><s></s><s></s><s></s><s></s></span>
    </div>

    <div class="weather weather--fire" aria-hidden="true">
      <s></s><s></s><s></s><s></s><s></s><s></s><s></s><s></s><s></s><s></s>
    </div>

    <div class="weather weather--snow" aria-hidden="true">
      <s></s><s></s><s></s><s></s><s></s><s></s><s></s><s></s>
      <s></s><s></s><s></s><s></s><s></s><s></s><s></s><s></s>
    </div>

    <!-- The dream sky: an orange moon and a slow field of stars, after
         katherine bradford's Swimmers Under Orange Moon, which hangs on the
         taste page and lends this whole mode its palette. -->
    <div class="dream-sky" aria-hidden="true">
      <span class="moon"></span>
      <i></i><i></i>
      <b></b><b></b><b></b><b></b><b></b><b></b>
    </div>


    <header class="site-header">
      <a class="masthead" href="/">dmytro klochko</a>
      {current !== "home" && <span class="crumb">/ {current.replace("-", " ")}</span>}
      <nav class="site-nav" aria-label="elsewhere">
        {/* Absolute, so it reaches the section from the pages that do not
            have one of their own. */}
        <a class="dance-link" href="/#contact">say hi</a>
        <a class="dance-link" href="/dance">dance</a>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="signoff">see you space cowboy&hellip;</p>
      <span class="foot-links">
        <a class="dance-link dance-link--foot" href="/dance">dance</a>
      </span>
      <div class="foot-row">
        <p>© 2026 dmytro klochko</p>
        <a class="to-top" href="#top">back to top<span class="arw" aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <!--
      The sky leans toward the cursor. Two custom properties on the root, read
      by CSS; no layout is touched and nothing is measured per frame, so it
      costs a pointermove listener and a compositor transform. Skipped
      entirely for reduced motion and for coarse pointers, where there is no
      cursor to follow.
    -->
    <script is:inline>
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const root = document.documentElement;
        // Direct write, no requestAnimationFrame: rAF is throttled in
        // embedded and background contexts, and a sky that only falls dark
        // on some frames is worse than one style write per scroll event.
        const onScroll = () => {
          root.style.setProperty("--scroll",
            Math.min(1.2, scrollY / (innerHeight * 1.2)).toFixed(4));
        };
        addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
        addEventListener("pointermove", (e) => {
          tx = (e.clientX / innerWidth - 0.5) * 2;
          ty = (e.clientY / innerHeight - 0.5) * 2;
          root.style.setProperty("--mx", (e.clientX / innerWidth) * 100 + "%");
          root.style.setProperty("--my", (e.clientY / innerHeight) * 100 + "%");
          if (!raf) raf = requestAnimationFrame(ease);
        }, { passive: true });
        function ease() {
          x += (tx - x) * 0.06;
          y += (ty - y) * 0.06;
          root.style.setProperty("--px", x.toFixed(4));
          root.style.setProperty("--py", y.toFixed(4));
          raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(ease) : 0;
        }
      })();
    </script>

    <!--
      Motion removed rather than added: looping autoplay is moving content that
      never stops, so WCAG 2.2.2 wants a way out, and CSS cannot pause a video.
    -->
    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const v of document.querySelectorAll("video[autoplay]")) {
          v.removeAttribute("autoplay");
          v.pause();
        }
      }
    </script>

    <!-- The pile of prints leans toward the cursor while it is over them,
         and eases back when it leaves. Hover-and-fine-pointer only, and
         silent under reduced motion. -->
    <script is:inline>
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        for (const pile of document.querySelectorAll(".hero-stack, .hi-stack")) {
          pile.addEventListener("pointermove", (e) => {
            const r = pile.getBoundingClientRect();
            pile.style.setProperty("--tx", (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(3));
            pile.style.setProperty("--ty", (((e.clientY - r.top) / r.height - 0.5) * 2).toFixed(3));
          }, { passive: true });
          pile.addEventListener("pointerleave", () => {
            pile.style.setProperty("--tx", "0");
            pile.style.setProperty("--ty", "0");
          });
        }
      })();
    </script>

    <!-- Click his name and the night shudders: the masthead shakes, the sky
         shivers behind it, and a few embers jump off the fire. On the home
         page the click is caught so nothing reloads; elsewhere it still
         goes home, because that is what a masthead is for. -->
    <script is:inline>
      (() => {
        const name = document.querySelector(".masthead");
        if (!name) return;
        const root = document.documentElement;
        let busy = false;
        name.addEventListener("click", (e) => {
          const home = location.pathname === "/" || location.pathname === "/index.html";
          if (!home) return;
          e.preventDefault();
          if (busy) return;
          busy = true;
          name.classList.add("is-shook");
          root.classList.add("is-shook");
          const sky = document.querySelector(".dream-sky");
          if (sky && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            for (let n = 0; n < 7; n++) {
              const p = document.createElement("b");
              p.style.left = (66 + Math.random() * 16) + "%";
              p.style.setProperty("--fall", (1.8 + Math.random() * 1.6) + "s");
              p.style.setProperty("--wait", (Math.random() * 0.5) + "s");
              p.style.setProperty("--sway", (Math.random() * 90 - 45) + "px");
              p.style.animationIterationCount = "1";
              sky.appendChild(p);
              setTimeout(() => p.remove(), 4200);
            }
          }
          setTimeout(() => {
            name.classList.remove("is-shook");
            root.classList.remove("is-shook");
            busy = false;
          }, 760);
        });
      })();
    </script>

    <!-- Type l-i-s-a anywhere and the sky answers with a shower of petals.
         She was the first rep; she gets to be in the source. -->
    <script is:inline>
      (() => {
        let buf = "";
        addEventListener("keydown", (e) => {
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          buf = (buf + (e.key || "").toLowerCase()).slice(-4);
          if (buf !== "lisa") return;
          buf = "";
          const sky = document.querySelector(".dream-sky");
          if (!sky) return;
          for (let n = 0; n < 16; n++) {
            const p = document.createElement("b");
            p.style.left = Math.random() * 100 + "%";
            p.style.setProperty("--fall", (2.4 + Math.random() * 2.6) + "s");
            p.style.setProperty("--wait", (Math.random() * 0.9) + "s");
            p.style.setProperty("--sway", (Math.random() * 140 - 70) + "px");
            p.style.animationIterationCount = "1";
            sky.appendChild(p);
            setTimeout(() => p.remove(), 6500);
          }
          console.log("%clisa says hi 🌸", "color:#ff9bc0");
        }, { passive: true });
      })();
    </script>

    <!-- Clicking an email link also copies the address and says so in the
         little label beside it, then puts the label back. -->
    <script is:inline>
      for (const a of document.querySelectorAll('a[href^="mailto:"]')) {
        a.addEventListener("click", () => {
          const em = a.parentElement?.querySelector("em");
          try { navigator.clipboard?.writeText(a.getAttribute("href").slice(7)); } catch {}
          if (!em || em.dataset.flash) return;
          em.dataset.flash = "1";
          const old = em.textContent;
          em.textContent = "copied ✓";
          em.classList.add("copied-flash");
          setTimeout(() => {
            em.textContent = old;
            em.classList.remove("copied-flash");
            delete em.dataset.flash;
          }, 1400);
        });
      }
    </script>

    <!-- Scene switching: the section nearest the middle of the window owns
         the sky. IntersectionObserver with a centred band, no scroll math,
         and the first scene is painted before any observation happens. -->
    <script is:inline>
      (() => {
        const sections = document.querySelectorAll("[data-scene]");
        if (!sections.length) return;
        const root = document.documentElement;
        root.dataset.scene = sections[0].dataset.scene;
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) root.dataset.scene = e.target.dataset.scene;
          }
        }, { rootMargin: "-42% 0px -42% 0px" });
        for (const s of sections) io.observe(s);
        // the rest of the journey loads once the page is idle, so the first
        // paint only ever waits on the scene it is actually showing.
        let warmed = false;
        const later = () => {
          if (warmed) return;
          warmed = true;
          for (const i of document.querySelectorAll(".scenes i")) {
            const img = new Image();
            img.src = `/images/scenes/${i.dataset.s}.webp`;
          }
        };
        const idle = () => ("requestIdleCallback" in window)
          ? requestIdleCallback(later, { timeout: 4000 }) : setTimeout(later, 2500);
        idle();
      })();
    </script>

  </body>
</html>
