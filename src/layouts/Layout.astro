---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "archive";
}

const { title, description, current = "home" } = Astro.props;

const ogTitle = "dmytro klochko";
const ogDescription = "ceo at replika. product and engineering, out of art, chess and theatre.";

// Pages only. The in-page anchors belonged in the page, not in a header that
// then changed meaning on every other page.
const nav = [
  { label: "readme", href: "/" },
  { label: "archive", href: "/archive" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="dmytro klochko" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
  </head>
  <body>
    <!--
                        ______
                     .-"      "-.
                    /            \
                   |,  .-.  .-.  ,|
                   | )(_o/  \o_)( |
                   |/     /\     \|
         (@_       (_     ^^     _)
    _     ) \_______\__|IIIIII|__/_______________________
   (_)@8@8{}<________|-\IIIIII/-|________________________>
          )_/        \          /
         (@           `--------`

              SEE YOU SPACE COWBOY...

    you read the source. that is the correct instinct.
    1@dmklochko.com
    -->
    <a class="skip-link" href="#main">skip to content</a>

    <div class="stars" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
      <span class="stars-glow"></span>
    </div>

    <header class="site-header">
      <a class="masthead" href="/">dmytro klochko</a>
      {current !== "home" && <span class="crumb">/ {current.replace("-", " ")}</span>}
      <nav class="site-nav" aria-label="pages">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={
              (item.href === "/" ? current === "home" : item.href === `/${current}`)
                ? "page"
                : undefined
            }>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="signoff">see you space cowboy&hellip;</p>
      <nav class="foot-nav" aria-label="pages">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                (item.href === "/" ? current === "home" : item.href === `/${current}`)
                  ? "page"
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="foot-row">
        <p>© 2026 dmytro klochko</p>
        <a class="to-top" href="#top">back to top<span class="arw" aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <!--
      The only JavaScript on the site, and it removes motion rather than adding
      it. Looping autoplay is moving content that never stops, so WCAG 2.2.2
      wants a way out, and CSS cannot pause a video.
    -->
    <!--
      The sky leans toward the cursor. Two custom properties on the root, read
      by CSS; no layout is touched and nothing is measured per frame, so it
      costs a pointermove listener and a compositor transform. Skipped
      entirely for reduced motion and for coarse pointers, where there is no
      cursor to follow.
    -->
    <script is:inline>
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        const root = document.documentElement;
        let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
        addEventListener("pointermove", (e) => {
          tx = (e.clientX / innerWidth - 0.5) * 2;
          ty = (e.clientY / innerHeight - 0.5) * 2;
          root.style.setProperty("--mx", (e.clientX / innerWidth) * 100 + "%");
          root.style.setProperty("--my", (e.clientY / innerHeight) * 100 + "%");
          if (!raf) raf = requestAnimationFrame(ease);
        }, { passive: true });
        function ease() {
          x += (tx - x) * 0.06;
          y += (ty - y) * 0.06;
          root.style.setProperty("--px", x.toFixed(4));
          root.style.setProperty("--py", y.toFixed(4));
          raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(ease) : 0;
        }
      })();
    </script>

    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const v of document.querySelectorAll("video[autoplay]")) {
          v.removeAttribute("autoplay");
          v.pause();
        }
      }
    </script>
  </body>
</html>
