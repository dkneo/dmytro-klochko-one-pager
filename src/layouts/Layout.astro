---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Which nav item is the current page. */
  current?: "home" | "watch" | "taste";
}

const { title, description, current = "home" } = Astro.props;

// One name, said once. The old set repeated "art & technology" in the title,
// the og:title, the og:description and twice inside the image itself, so a
// shared link read as a slogan rather than as a person.
const ogTitle = "dmytro klochko";
const ogDescription = "ceo at replika. product and engineering, out of art, chess and theatre.";

const nav = [
  { label: "about", href: "/#about", key: "home" },
  { label: "career", href: "/#career", key: "home" },
  { label: "watch", href: "/watch", key: "watch" },
  { label: "taste", href: "/taste", key: "taste" },
  { label: "say hi", href: "/#contact", key: "home" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4efe4" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="dmytro klochko" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
  </head>
  <body>
    <!--
                        ______
                     .-"      "-.
                    /            \
                   |,  .-.  .-.  ,|
                   | )(_o/  \o_)( |
                   |/     /\     \|
         (@_       (_     ^^     _)
    _     ) \_______\__|IIIIII|__/_______________________
   (_)@8@8{}<________|-\IIIIII/-|________________________>
          )_/        \          /
         (@           `--------`

              SEE YOU SPACE COWBOY...

    you read the source. that is the correct instinct.
    1@dmklochko.com
    -->
    <a class="skip-link" href="#main-content">skip to content</a>

    <header class="site-header" aria-label="primary navigation">
      <a class="masthead" href="/" aria-label="dmytro klochko, home">
        <span>dmytro</span> <em>klochko</em>
      </a>

      <nav class="site-nav" aria-label="main menu">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.key === current && item.key !== "home" ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="page-shell site-footer">
      <p>© 2026 dmytro klochko</p>
      <p class="signoff">see you space cowboy&hellip;</p>
      <a class="to-top" href="#top">
        back to top <span aria-hidden="true" class="arrow">↑</span>
      </a>
    </footer>

    <!--
      The only JavaScript on the site, and it exists to remove motion, not add
      it. Looping autoplay is moving content that never stops, so WCAG 2.2.2
      wants a way out; CSS cannot pause a video, so prefers-reduced-motion has
      to be honoured here. Five lines, no library.
    -->
    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const v of document.querySelectorAll("video[autoplay]")) {
          v.removeAttribute("autoplay");
          v.pause();
        }
      }
    </script>
  </body>
</html>
