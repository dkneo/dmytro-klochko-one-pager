---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const ogTitle = "dmytro klochko · art & technology";
const ogDescription = "jaywalker at the intersection of art and technology.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="generator" content={Astro.generator} />

    <!--
      The mark is a raster drawing, so there is no SVG variant to prefer; the
      .ico carries both 16 and 32, because at 16 the flag needs its own
      rendering rather than a downscale of the 32.
    -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content={ogTitle}/>

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
  </head>
  <body>
    <slot />

    <!--
      The only JavaScript on the site, and it exists to remove motion, not add
      it. Looping autoplay is moving content that never stops, so WCAG 2.2.2
      wants a way out; CSS cannot pause a video, so prefers-reduced-motion has
      to be honoured here. Five lines, no library.
    -->
    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const v of document.querySelectorAll("video[autoplay]")) {
          v.removeAttribute("autoplay");
          v.pause();
        }
      }
    </script>
  </body>
</html>
