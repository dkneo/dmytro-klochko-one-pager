---
import "../styles/global.css";
import "../styles/dream.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "taste";
}

const { title, description, current = "home" } = Astro.props;

const ogTitle = "dmytro klochko";
const ogDescription = "ceo at replika. product and engineering, out of art, chess and theatre.";

// Pages only. The in-page anchors belonged in the page, not in a header that
// then changed meaning on every other page.
const nav = [
  { label: "readme", href: "/" },
  { label: "taste", href: "/taste" },
];
---

<html lang="en" data-mode="dream">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#2c3357" />
    <!--
      Two art directions share this markup. "dream" is the default; "bebop"
      is the terminal in deep space this site used to default to. The choice
      is read before first paint so neither mode ever flashes as the other.
    -->
    <script is:inline>
      (() => {
        try {
          const m = localStorage.getItem("mode");
          if (m === "bebop" || m === "dream") document.documentElement.dataset.mode = m;
        } catch {}
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          "content",
          document.documentElement.dataset.mode === "bebop" ? "#0b0b0d" : "#2c3357"
        );
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="dmytro klochko" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />
  </head>
  <body>
    <!--
                        ______
                     .-"      "-.
                    /            \
                   |,  .-.  .-.  ,|
                   | )(_o/  \o_)( |
                   |/     /\     \|
         (@_       (_     ^^     _)
    _     ) \_______\__|IIIIII|__/_______________________
   (_)@8@8{}<________|-\IIIIII/-|________________________>
          )_/        \          /
         (@           `--------`

              SEE YOU SPACE COWBOY...

    you read the source. that is the correct instinct.
    1@dmklochko.com
    -->
    <a class="skip-link" href="#main">skip to content</a>

    <div class="stars" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
      <span class="stars-glow"></span>
    </div>

    <!-- The dream sky: an orange moon and a slow field of stars, after
         katherine bradford's Swimmers Under Orange Moon, which hangs on the
         taste page and lends this whole mode its palette. -->
    <div class="dream-sky" aria-hidden="true">
      <span class="moon"></span>
      <i></i><i></i>
    </div>

    <header class="site-header">
      <a class="masthead" href="/">dmytro klochko</a>
      {current !== "home" && <span class="crumb">/ {current.replace("-", " ")}</span>}
      <nav class="site-nav" aria-label="pages">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={
              (item.href === "/" ? current === "home" : item.href === `/${current}`)
                ? "page"
                : undefined
            }>
              {item.label}
            </a>
          ))
        }
        <button class="mode-toggle" type="button">
          <span class="only-dream">✦ bebop mode</span>
          <span class="only-bebop">☾ go dreamy</span>
        </button>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="signoff">
        <span class="only-bebop">see you space cowboy&hellip;</span>
        <span class="only-dream">we got time to go dreamy.</span>
      </p>
      <nav class="foot-nav" aria-label="pages">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                (item.href === "/" ? current === "home" : item.href === `/${current}`)
                  ? "page"
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="foot-row">
        <p>© 2026 dmytro klochko</p>
        <a class="to-top" href="#top">back to top<span class="arw" aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <!--
      The only JavaScript on the site, and it removes motion rather than adding
      it. Looping autoplay is moving content that never stops, so WCAG 2.2.2
      wants a way out, and CSS cannot pause a video.
    -->
    <!--
      The sky leans toward the cursor. Two custom properties on the root, read
      by CSS; no layout is touched and nothing is measured per frame, so it
      costs a pointermove listener and a compositor transform. Skipped
      entirely for reduced motion and for coarse pointers, where there is no
      cursor to follow.
    -->
    <script is:inline>
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        const root = document.documentElement;
        let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
        addEventListener("pointermove", (e) => {
          tx = (e.clientX / innerWidth - 0.5) * 2;
          ty = (e.clientY / innerHeight - 0.5) * 2;
          root.style.setProperty("--mx", (e.clientX / innerWidth) * 100 + "%");
          root.style.setProperty("--my", (e.clientY / innerHeight) * 100 + "%");
          if (!raf) raf = requestAnimationFrame(ease);
        }, { passive: true });
        function ease() {
          x += (tx - x) * 0.06;
          y += (ty - y) * 0.06;
          root.style.setProperty("--px", x.toFixed(4));
          root.style.setProperty("--py", y.toFixed(4));
          raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(ease) : 0;
        }
      })();
    </script>

    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const v of document.querySelectorAll("video[autoplay]")) {
          v.removeAttribute("autoplay");
          v.pause();
        }
      }
    </script>

    <script is:inline>
      for (const b of document.querySelectorAll(".mode-toggle")) {
        b.addEventListener("click", () => {
          const next = document.documentElement.dataset.mode === "bebop" ? "dream" : "bebop";
          document.documentElement.dataset.mode = next;
          try { localStorage.setItem("mode", next); } catch {}
          document.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content", next === "bebop" ? "#0b0b0d" : "#2c3357"
          );
        });
      }
    </script>

    <!--
      The peek. Hovering a word that names something real lifts a small stack
      of photographs of it above the cursor, like prints dropped on a desk.
      Hover only, so phones never see a half-working version; the words are
      plain text there. The photograph sits on the line it is evidence for —
      this is that rule at its logical extreme.
    -->
    <script is:inline>
      (() => {
        if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        let pop = null, raf = 0, x = 0, y = 0, tx = 0, ty = 0;
        const ease = () => {
          x += (tx - x) * 0.22;
          y += (ty - y) * 0.22;
          if (pop) pop.style.transform = `translate(${x}px, ${y}px)`;
          raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(ease) : 0;
        };
        for (const el of document.querySelectorAll("[data-peek]")) {
          el.addEventListener("pointerenter", (e) => {
            pop?.remove();
            pop = document.createElement("div");
            pop.className = "peek-pop";
            if (e.clientY < 230) pop.classList.add("below");
            for (const src of el.dataset.peek.split(",")) {
              const img = new Image();
              img.src = src.trim();
              img.alt = "";
              pop.appendChild(img);
            }
            document.body.appendChild(pop);
            x = tx = e.clientX; y = ty = e.clientY;
            pop.style.transform = `translate(${x}px, ${y}px)`;
            // Flush styles, then reveal on a timer rather than a frame:
            // requestAnimationFrame is throttled in background/embedded
            // contexts and the stack would silently never appear.
            pop.getBoundingClientRect();
            const p = pop;
            setTimeout(() => { if (p === pop) p.classList.add("on"); }, 20);
          });
          el.addEventListener("pointermove", (e) => {
            tx = e.clientX; ty = e.clientY;
            if (!raf) raf = requestAnimationFrame(ease);
          });
          el.addEventListener("pointerleave", () => {
            const dying = pop;
            pop = null;
            if (!dying) return;
            dying.classList.remove("on");
            setTimeout(() => dying.remove(), 220);
          });
        }
      })();
    </script>
  </body>
</html>
