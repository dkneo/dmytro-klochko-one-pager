---
import Layout from "../layouts/Layout.astro";

const vlogs = [
  { label: "kbs interview", place: "korea", href: "https://www.instagram.com/p/DYhL6c9Ti8M/", video: "vlog-kbs" },
  { label: "vienna", place: "austria", href: "https://www.instagram.com/p/DYXLh6rI2JI/", video: "vlog-vienna" },
  { label: "in paris", place: "france", href: "https://www.instagram.com/p/DYheZtSNZxM/", video: "vlog-paris" },
  { label: "london", place: "the film", video: "film-london" },
  { label: "live on tvnz", place: "new zealand", video: "tvnz-live" },
  { label: "finding connection", place: "dok.fest münchen", video: "dokfest" },
] as const;

const outs = [
  {
    name: "the replika manifesto",
    what: "ai isn't the problem, it just forgot real life. i wrote it.",
    kind: "essay",
    href: "https://replika.com/manifesto",
  },
  {
    name: "5 predictions for ai in 2026",
    what: "time, davos collection",
    kind: "press",
    href: "https://time.com/collections/davos-2026/7339222/ai-predictions-2026/",
  },
  {
    name: "chatbots as social companions",
    what: "guingrich & graziano, princeton",
    kind: "research",
    href: "https://arxiv.org/abs/2311.10599",
  },
  {
    name: "replika 2025 merch",
    what: "i designed it, down to the label",
    kind: "made",
    href: "https://x.com/replika/status/1991136959385817336",
  },
] as const;

const shelf = [
  "the lord of the rings, j.r.r. tolkien",
  "upstream, mary oliver",
  "gaspard de la nuit, aloysius bertrand (also the ravel suite)",
  "man's search for meaning, viktor frankl",
  "rumours, fleetwood mac",
] as const;

const title = "highlights · dmytro klochko";
const description = "films, interviews, press, the things he made, and two poems.";
---

<Layout title={title} description={description} current="highlights">
  <section class="shell session" id="top" aria-labelledby="h1">
    <div class="card">
      <p class="card-no">01</p>
      <h1 class="card-title" id="h1">on camera</h1>
      <p class="card-what">films, vlogs, broadcast</p>
    </div>

    <div class="reel">
      {
        vlogs.map((v) =>
          v.href ? (
            <a href={v.href} target="_blank" rel="noreferrer">
              <span class="frame">
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={`/video/${v.video}-poster.jpg`}
                  aria-hidden="true"
                >
                  <source src={`/video/${v.video}.webm`} type="video/webm" />
                  <source src={`/video/${v.video}.mp4`} type="video/mp4" />
                </video>
              </span>
              <span class="cap">
                {v.label} — {v.place} ↗
              </span>
            </a>
          ) : (
            <figure>
              <span class="frame">
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={`/video/${v.video}-poster.jpg`}
                  aria-hidden="true"
                >
                  <source src={`/video/${v.video}.webm`} type="video/webm" />
                  <source src={`/video/${v.video}.mp4`} type="video/mp4" />
                </video>
              </span>
              <span class="cap">
                {v.label} — {v.place}
              </span>
            </figure>
          )
        )
      }
    </div>
  </section>

  <section class="shell session" id="read" aria-labelledby="h2">
    <div class="card">
      <p class="card-no">02</p>
      <h2 class="card-title" id="h2">on record</h2>
      <p class="card-what">writing, press, research, objects</p>
    </div>

    <ul class="outs">
      {
        outs.map((o) => (
          <li>
            <a href={o.href} target="_blank" rel="noreferrer">
              <b>{o.name} ↗</b>
              <span>{o.what}</span>
              <em>{o.kind}</em>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="shot-row">
      <figure class="shot">
        <img src="/images/swag-label.jpg" alt="A garment label reading: glad we're in this together. Replika, 2025" loading="lazy" />
        <figcaption>“glad we're in this together.”</figcaption>
      </figure>
      <figure class="shot">
        <img src="/images/swag-hoodie.jpg" alt="A green Replika hoodie on a chair against a deep blue backdrop" loading="lazy" />
        <figcaption>the hoodie</figcaption>
      </figure>
      <figure class="shot">
        <img src="/images/swag-team.jpg" alt="Dmytro and a colleague in Replika swag by a lake, autumn hills behind them" loading="lazy" />
        <figcaption>worn in</figcaption>
      </figure>
    </div>
  </section>

  <section class="shell session" id="taste" aria-labelledby="h3">
    <div class="card">
      <p class="card-no">03</p>
      <h2 class="card-title" id="h3">taste</h2>
      <p class="card-what">what he keeps going back to</p>
    </div>

    <div class="bay">
      <ol class="log shelf">
        {shelf.map((item) => <li>{item}</li>)}
      </ol>

      <figure class="shot">
        <img src="/images/taste-museum.jpg" alt="Dmytro standing in a gallery in front of a large canvas" loading="lazy" />
      </figure>
    </div>

    <div class="poems">
      <blockquote class="poem">
        i am lost in sorrento<br />
        for i am the taste of its lemons and its women's feet<br />
        i'm the salt of its breeze<br />
        i'm so glad i can't breathe<br />
        i'm so tall i am whole twelve feet
      </blockquote>
      <blockquote class="poem">
        this girl is the warm sensation of young sun on my bare chest<br />
        her chestnut irises, and the greens in them, glimmer with playful unrest<br />
        when she whispers her spells, her tricks, and her promises, i couldn't get any slumber<br />
        for she carries inside her an eternal summer, an eternal summer
      </blockquote>
    </div>
  </section>
</Layout>
