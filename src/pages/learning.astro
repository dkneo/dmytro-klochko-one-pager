---
import Layout from "../layouts/Layout.astro";
import "../styles/pages/learning.css";
import { readdirSync, readFileSync, existsSync } from "node:fs";
import { join } from "node:path";

// Links come from the vault, same as everything else, so a thing he sends is
// filed once and shows up wherever it belongs rather than being pasted here.
function links() {
  const dir = "vault/links";
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((f) => f.endsWith(".md") && !f.startsWith("_"))
    .map((f) => {
      const text = readFileSync(join(dir, f), "utf8");
      const head = text.slice(4, text.indexOf("\n---", 3)).split("\n");
      const o = {};
      for (let i = 0; i < head.length; i++) {
        const m = /^([A-Za-z_][\w-]*):\s*(.*)$/.exec(head[i]);
        if (!m) continue;
        if (m[2] === "|-" || m[2] === "|") {
          const ls = [];
          while (i + 1 < head.length && /^\s{2,}/.test(head[i + 1])) ls.push(head[++i].slice(2));
          o[m[1]] = ls.join("\n").trim();
        } else {
          o[m[1]] = m[2].replace(/^"|"$/g, "");
        }
      }
      return o;
    })
    .sort((a, b) => String(b.added).localeCompare(String(a.added)));
}

// What he is actually working on, written as what it is rather than as a
// syllabus. Kept here because it changes often and nothing else depends on it.
const now = [
  {
    subject: "the vocabulary of interface",
    why:
      "i want to explain ui to models better. i can tell instantly when a screen is wrong, but \u201cmake it feel less heavy\u201d is not a prompt. dead space, optical alignment, a sheet and not a modal: the more exact my words, the more exact what comes back.",
    doing:
      "a field guide of the terms people actually use when shipping and reviewing ui. mark the ones you genuinely know, and the drill quizzes you on exactly those, because the useful question is not what you have read but what stuck.",
    artefact: {
      // The asset server drops .html and redirects, so link where it lands.
      href: "/learning/ui-vernacular",
      label: "the field guide",
      shot: "/images/learning-ui-vernacular.webp",
      alt: "A dark reference app of interface terms laid out as cards, with a search field",
    },
  },
  {
    subject: "the terminal, played properly",
    why:
      "i live in a terminal next to my agents all day and still catch myself arrow-keying through an eighty-character command. the shell has a whole editor inside it, with a clipboard, undo, and history search, and every move that gets into your hands pays rent daily.",
    doing:
      "a field guide of the keystrokes actually worth owning: the line editor, the kill ring, history, jobs, the zsh party tricks. mark what you genuinely know and the drill quizzes exactly those. it never asks you to press the chords in the browser, because ctrl w closes the tab.",
    artefact: {
      href: "/learning/terminal",
      label: "the field guide",
      shot: "/images/learning-terminal.webp",
      alt: "A light reference page of terminal keystrokes as cards, with a search field and a drill button",
    },
  },
  {
    subject: "the words for motion",
    why:
      "same problem, narrower: i can feel that a transition is wrong and not say why. emil kowalski\u2019s writing is the closest thing to a dictionary for it, and the terms come with numbers attached, which is what makes them usable in a prompt.",
    doing:
      "the rules i keep coming back to, in his words as far as i understand them: three tests before anything moves, under 300ms or it reads as slow, ease-out for anything entering, scale 0.97 on press, never grow from nothing, and never animate what someone triggers from the keyboard a hundred times a day.",
  },
];

const all = links();
const worth = all.filter((l) => l.status !== "queued");
const queued = all.filter((l) => l.status === "queued");

const title = "learning · dmytro klochko";
const description = "what dmytro klochko is learning right now, in the open.";
---

<Layout title={title} description={description} current="learning" scenes={["study"]}>
  <section class="shell session learn" data-scene="study" aria-labelledby="ln">
    <div class="card">
      <h1 class="card-title" id="ln">learning now</h1>
    </div>

    <p class="today-how">
      no curriculum. just what i’m into this week. most of it needs{" "}
      <b>a bit of ui</b> before it’s any use, so i build the smallest thing
      that works and leave it here for anyone.
    </p>

    {now.map((n) => (
      <article class="learn-now">
        <h2 class="learn-subject">{n.subject}</h2>
        <div class="prose learn-prose">
          <p>{n.why}</p>
          <p>{n.doing}</p>
        </div>

        {n.artefact && (
          <a class="learn-artefact" href={n.artefact.href}>
            <span class="cell">
              <img src={n.artefact.shot} alt={n.artefact.alt} width="1200" height="833" loading="lazy" decoding="async" />
            </span>
            <span class="learn-open">{n.artefact.label}<span class="arw" aria-hidden="true">→</span></span>
          </a>
        )}
      </article>
    ))}

    <h2 class="learn-head">worth coming back to</h2>
    {worth.length ? (
      <ol class="learn-links">
        {worth.map((l) => (
          <li>
            <a class="learn-link" href={l.url} target="_blank" rel="noreferrer">
              {l.title}<span class="arw">↗</span>
            </a>
            <p class="learn-sum">{l.summary}</p>
            <p class="learn-meta">
              {l.who && <b>{l.who}</b>}
              {l.tags && <span>{l.tags}</span>}
              {l.added && <em>{l.added}</em>}
            </p>
          </li>
        ))}
      </ol>
    ) : (
      <p class="learn-empty">
        nothing filed yet. send me a link and it lands here with a summary
        written when it is filed, rather than a bookmark that rots unread.
      </p>
    )}

    {queued.length > 0 && (
      <>
        <h2 class="learn-head">still to read</h2>
        <ul class="learn-queue">
          {queued.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noreferrer">{l.title}<span class="arw">↗</span></a>
              {l.who && <b>{l.who}</b>}
              {l.tags && <span>{l.tags}</span>}
            </li>
          ))}
        </ul>
        <p class="learn-empty">
          these get a summary here once they have actually been read, not
          before. the list only shrinks by reading.
        </p>
      </>
    )}

    <a class="onward onward--back" href="/">
      <span class="arw" aria-hidden="true">↖</span><span>back to the main page</span>
    </a>
  </section>
</Layout>
