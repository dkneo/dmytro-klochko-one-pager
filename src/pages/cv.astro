---
import Layout from "../layouts/Layout.astro";

// His own wording, tightened. No dates, no revenue figures, no summary — the
// company descriptors are the same ones the main page uses so the two never
// drift apart. Contacts are the say-hi list, verbatim.
const jobs = [
  {
    co: "replika",
    what: "#1 ai friend. 42m users worldwide",
    role: "chief executive officer",
    href: "https://replika.com",
    mark: "/images/marks/replika.png",
    points: [
      "tripled revenue and made the company profitable",
      "x1.8 arpu, +58% d30 retention",
      "grew it to 42m people across 145+ countries",
      "commissioned <b>studio dumbar</b> for a full rebrand, then redesigned the app around it",
      'ran peer-reviewed research with <a href="https://www.hbs.edu/faculty/Pages/item.aspx?num=67360" target="_blank" rel="noreferrer">harvard<span class="arw">↗</span></a>, <a href="https://www.nature.com/articles/s44184-023-00047-6" target="_blank" rel="noreferrer">stanford<span class="arw">↗</span></a>, <a href="https://arxiv.org/abs/2311.10599" target="_blank" rel="noreferrer">princeton<span class="arw">↗</span></a> and the <a href="https://www.univie.ac.at/en/" target="_blank" rel="noreferrer">university of vienna<span class="arw">↗</span></a>',
      "rebuilt the team around phds, true artists and pirates",
      "put replika back in the zeitgeist {time, cnn, bbc, reuters, cbs, kbs, german national tv, australian and new zealand primetime, mastermind paris}",
      "spun a product out of the company and sold it for multiple millions",
      "cut product and infrastructure cost by 90% while retention kept climbing",
      "went to war for the company in legislatures and in public, from the <b>u.s. senate</b> to european governments",
      "won as much of it with public stunts as with lawyers",
      'designed the merch myself, <a href="https://x.com/replika/status/1991136959385817336" target="_blank" rel="noreferrer">down to the label<span class="arw">↗</span></a>',
    ],
  },
  {
    co: "hunch",
    what: "remote team happiness saas",
    role: "founder and chief executive officer",
    mark: "/images/marks/homa.png",
    points: [
      "founded it and took it to hundreds of thousands in arr",
      "raised pre-seed from top silicon valley angels",
      "closed the first 14 contracts myself {four of them enterprise} on 600+ customer calls",
      "recruited the founding engineering and design team",
      "shipped a self-service skills marketplace, opened weekly by over half of each client's team",
    ],
  },
  {
    co: "chatfuel",
    what: "marketing ai agent. 150k+ businesses",
    role: "head of marketing and expansion",
    mark: "/images/marks/chatfuel.png",
    href: "https://chatfuel.com",
    points: [
      "opened the product into new markets across three continents",
      "repositioned it, which unlocked new acquisition channels",
      "worked with the ml and ai teams on where the product could go",
      'made the <a href="/video/meta-chatfuel.mp4" target="_blank" rel="noreferrer">meta ad<span class="arw">↗</span></a> that turned into a hit',
      'hosted a <a href="https://www.youtube.com/watch?v=WOm_XzkFNWE" target="_blank" rel="noreferrer">podcast<span class="arw">↗</span></a> people still write to me about',
    ],
  },
  {
    co: "hily",
    what: "#3 dating app in the u.s. by downloads",
    role: "strategic product manager",
    mark: "/images/marks/hily.png",
    href: "https://hily.com",
    points: [
      "ran tens of winning experiments on the flagship, an app 300k people opened every day",
      "turned the company's testing into a startup accelerator, from one concept a month to thirty of the riskiest a week",
      "founded a new app out of an insight from pmf expansion discovery",
      'lectured for the company and for its <a href="/images/cv-lecture.jpg" target="_blank" rel="noreferrer">users<span class="arw">↗</span></a>',
    ],
  },
  {
    co: "vk",
    what: "largest european social network. 100m+ mau",
    role: "senior product manager",
    mark: "/images/marks/vk.png",
    href: "https://vk.com",
    points: [
      "changed what millions of people do daily on the largest social network, from doomscrolling to microlearning",
      "built ml pipelines that read interest and aptitude at that scale, education above all",
      "redrew ui and ux patterns inside a machine that size",
      "raised retention and time spent, and made the time worth spending",
    ],
  },
  {
    co: "skyeng",
    what: "#1 1:1 education platform in europe",
    role: "product manager",
    mark: "/images/marks/skyeng.png",
    href: "https://skyeng.ru",
    points: [
      "ran a one-person accelerator inside the company, launching products 0→1 and rebuilding the ones that stayed",
      "owned every funnel, gate and conversion rate in the company, for every user, from the front page to app onboarding",
      "built hundreds of landing pages, 43 of them in a single night",
      "rebuilt mobile onboarding and experimented until conversion and activation doubled",
      "taught onboarding to spot which influencer had just sent you and rebuild itself around them, 3.7x funnel conversion",
      "fixed mobile marketing analytics in ten days, first time ever touching it, after years of it defeating everyone",
      "ran growth and product for skyeng's magazine, millions of visitors, turning its stories into personalised self-serve funnels",
      "rebuilt the data pipelines under all of it",
      'wrote for it too: <a href="https://skyeng.ru/magazine/moj-edinstvennyj-uchitel-anglijskogo-bomzh-na-gorodskoj-ploshadi/" target="_blank" rel="noreferrer">the only english teacher i had<span class="arw">↗</span></a> and <a href="https://vc.ru/hr/192417-pochemu-prodaktu-vazhno-ostavatsya-chelovekom-i-pochemu-eto-polezno-dlya-biznesa" target="_blank" rel="noreferrer">on staying human<span class="arw">↗</span></a>',
    ],
  },
] as const;

// The things that run underneath all of it.
const also = [
  { what: "lecturer", where: "british higher school of art & design", href: "https://britishdesign.ru/about/tutors/196920/" },
  { what: "lecturer", where: "university of vienna", href: "https://www.univie.ac.at/en/" },
  { what: "mentor", where: "50+ product people and designers" },
  { what: "volunteer", where: "ukrainian causes" },
] as const;

// The same list the main page ends on.
const ways = [
  { href: "mailto:1@dmklochko.com", label: "1@dmklochko.com", note: "personal" },
  { href: "mailto:1@replika.com", label: "1@replika.com", note: "replika" },
  { href: "https://x.com/dkreplika", label: "@dkreplika", note: "x", out: true },
  { href: "https://instagram.com/dmytrotoday", label: "@dmytrotoday", note: "instagram", out: true },
  { href: "https://substack.com/@dkreplika", label: "@dkreplika", note: "substack", out: true },
  { href: "https://t.me/deoparis", label: "@deoparis", note: "telegram", out: true },
  { href: "https://www.linkedin.com/in/heydmytro/", label: "heydmytro", note: "linkedin", out: true },
] as const;

const title = "cv · dmytro klochko";
const description =
  "dmytro klochko. replika, hunch, chatfuel, hily, vk, skyeng.";
---

<Layout title={title} description={description} current="home">
  <section class="shell session cv" id="cv" data-scene="fire" aria-labelledby="c1">
    <div class="card">
      <h1 class="card-title" id="c1">curriculum vitae</h1>
    </div>

    <p class="lede cv-lede">
      hands-on in every one of these: i write the architecture and the prompts,
      push code to production, and i hit all-nighters.
    </p>

    <ol class="cv-jobs">
      {
        jobs.map((j) => (
          <li>
            <p class="cv-line">
              <span class="tl-mark" style={`--mark:url(${j.mark})`} aria-hidden="true" />
              <span class="cv-co">
                {"href" in j && j.href
                  ? <a href={j.href} target="_blank" rel="noreferrer">{j.co}<span class="arw">↗</span></a>
                  : j.co}
              </span>
              <span class="cv-what">{j.what}</span>
            </p>
            <p class="cv-role">{j.role}</p>
            <ul class="cv-points">
              {j.points.map((p) => <li set:html={p} />)}
            </ul>
          </li>
        ))
      }
    </ol>

    <h2 class="cv-head">alongside</h2>
    <ul class="cv-list cv-also">
      {
        also.map((a) => (
          <li>
            <b>{a.what}</b>
            <span>
              {"href" in a && a.href
                ? <a href={a.href} target="_blank" rel="noreferrer">{a.where}<span class="arw">↗</span></a>
                : a.where}
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="cv-head">say hi</h2>
    <ul class="ways cv-ways">
      {
        ways.map((w) => (
          <li>
            <a href={w.href} {...(w.out ? { target: "_blank", rel: "noreferrer" } : {})}>
              {w.label}{w.out && <span class="arw">↗</span>}
            </a>
            <em>{w.note}</em>
          </li>
        ))
      }
    </ul>

    <a class="onward onward--back" href="/">
      <span class="arw" aria-hidden="true">↖</span><span>back to the main page</span>
    </a>
  </section>
</Layout>
