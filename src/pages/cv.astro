---
import Layout from "../layouts/Layout.astro";

// His own wording, tightened. No dates, no revenue figures, no summary — the
// company descriptors are the same ones the main page uses so the two never
// drift apart. Contacts are the say-hi list, verbatim.
const jobs = [
  {
    co: "replika",
    what: "#1 ai friend. 42m users worldwide",
    role: "chief executive officer",
    href: "https://replika.com",
    mark: "/images/marks/replika.png",
    points: [
      "took a company that was burning cash and made it profitable – tripling revenue on the way",
      "x1.8 arpu and +58% d30 retention: the two numbers that decide whether a consumer product lives",
      "grew it to 42m people worldwide, across 145+ countries",
      "commissioned <b>studio dumbar</b> to rebuild the brand from the ground up, then redesigned the app around it – replika stopped looking like a chatbot and started looking like a company you would trust with your inner life",
      'made independent science a pillar of the product rather than a press release: peer-reviewed work with <a href="https://www.hbs.edu/faculty/Pages/item.aspx?num=67360" target="_blank" rel="noreferrer">harvard<span class="arw">↗</span></a>, <a href="https://www.nature.com/articles/s44184-023-00047-6" target="_blank" rel="noreferrer">stanford<span class="arw">↗</span></a>, <a href="https://arxiv.org/abs/2311.10599" target="_blank" rel="noreferrer">princeton<span class="arw">↗</span></a> and the <a href="https://www.univie.ac.at/en/" target="_blank" rel="noreferrer">university of vienna<span class="arw">↗</span></a> – so every claim we make about wellbeing is one a scientist will defend',
      "rebuilt the team from the ground up around phds, true artists and pirates",
      "put replika on the desks of time, cnn, bbc and reuters",
      "sold a managed product for multiple millions",
      "cut infrastructure cost by 90% and shipped faster afterwards",
      "answered for the company in front of the <b>u.s. senate</b> and european governments, and came out the other side with the business whole",
    ],
  },
  {
    co: "hunch",
    what: "remote team happiness saas",
    role: "founder and chief executive officer",
    mark: "/images/marks/homa.png",
    points: [
      "founded it and took it from an empty repository to hundreds of thousands in arr",
      "raised pre-seed from the silicon valley angels everyone wants on the cap table",
      "closed the first 14 contracts myself – four of them enterprise – on 600+ customer calls",
      "recruited a founding team of engineers and designers most startups never get near",
      "shipped a self-service skills marketplace that more than half of each client's team opened every week",
    ],
  },
  {
    co: "chatfuel",
    what: "marketing ai agent. 150k+ businesses",
    role: "head of marketing and expansion",
    mark: "/images/marks/chatfuel.png",
    href: "https://chatfuel.com",
    points: [
      "opened the product into new markets across three continents",
      "repositioned it, and in doing so unlocked acquisition channels that had been shut",
      "worked shoulder to shoulder with the ml and ai teams on what the product could become",
    ],
  },
  {
    co: "hily",
    what: "#3 dating app in the u.s. by downloads",
    role: "strategic product manager",
    mark: "/images/marks/hily.png",
    href: "https://hily.com",
    points: [
      "grew the flagship – 300k people opening it every day – through tens of winning experiments",
      "built a factory for testing the craziest ideas in days instead of quarters",
      "found the insight in pmf expansion discovery that became an entirely new app, and founded it",
    ],
  },
  {
    co: "vk",
    what: "largest european social network. 100m+ mau",
    role: "senior product manager",
    mark: "/images/marks/vk.png",
    href: "https://vk.com",
    points: [
      "built ml pipelines with the ml teams that served millions of people a day",
      "and work that stays under nda",
    ],
  },
  {
    co: "skyeng",
    what: "#1 1:1 education platform in europe",
    role: "product manager",
    mark: "/images/marks/skyeng.png",
    href: "https://skyeng.ru",
    points: [
      "launched a run of products 0→1",
      "ran over a hundred winning experiments and campaigns",
      "doubled mobile conversion and activation",
      "fixed the problems nobody else in the building would touch",
    ],
  },
] as const;

// The same list the main page ends on.
const ways = [
  { href: "mailto:1@dmklochko.com", label: "1@dmklochko.com", note: "personal" },
  { href: "mailto:1@replika.com", label: "1@replika.com", note: "replika" },
  { href: "https://x.com/dkreplika", label: "@dkreplika", note: "x", out: true },
  { href: "https://instagram.com/dmytrotoday", label: "@dmytrotoday", note: "instagram", out: true },
  { href: "https://substack.com/@dkreplika", label: "@dkreplika", note: "substack", out: true },
  { href: "https://t.me/deoparis", label: "@deoparis", note: "telegram", out: true },
  { href: "https://www.linkedin.com/in/heydmytro/", label: "heydmytro", note: "linkedin", out: true },
] as const;

const title = "cv · dmytro klochko";
const description =
  "dmytro klochko — replika, hunch, chatfuel, hily, vk, skyeng.";
---

<Layout title={title} description={description} current="home">
  <section class="shell session cv" id="cv" data-scene="fire" aria-labelledby="c1">
    <div class="card">
      <h1 class="card-title" id="c1">curriculum vitae</h1>
    </div>

    <ol class="cv-jobs">
      {
        jobs.map((j) => (
          <li>
            <p class="cv-line">
              <span class="tl-mark" style={`--mark:url(${j.mark})`} aria-hidden="true" />
              <span class="cv-co">
                {"href" in j && j.href
                  ? <a href={j.href} target="_blank" rel="noreferrer">{j.co}<span class="arw">↗</span></a>
                  : j.co}
              </span>
              <span class="cv-what">{j.what}</span>
            </p>
            <p class="cv-role">{j.role}</p>
            <ul class="cv-points">
              {j.points.map((p) => <li set:html={p} />)}
            </ul>
          </li>
        ))
      }
    </ol>

    <h2 class="cv-head">say hi</h2>
    <ul class="ways cv-ways">
      {
        ways.map((w) => (
          <li>
            <a href={w.href} {...(w.out ? { target: "_blank", rel: "noreferrer" } : {})}>
              {w.label}{w.out && <span class="arw">↗</span>}
            </a>
            <em>{w.note}</em>
          </li>
        ))
      }
    </ul>

    <a class="onward onward--back" href="/">
      <span class="arw" aria-hidden="true">↖</span><span>back to the main page</span>
    </a>
  </section>
</Layout>
