---
import palettes from "../../data/palettes.json";

// The instrument, before anything is built on it.
//
// A reading is an object, not a wallpaper: the field is painted onto a form
// you can turn, sitting in its own frame on the page rather than swallowing
// the window. Five knobs play one hand-tuned shader — nothing is ever
// generated, the answers only turn knobs.
//
// Colour comes only from palettes.json, five stops sampled by k-means from
// the eight paintings that carry the weathers on /today, so a reading can
// look like Turner's storm or Whistler's nocturne and can never look like a
// default gradient.
//
// The poem is wrapped around the form and its letterforms displace the field
// beneath them, which is the difference between a shader and a poem moving.
//
// ?grid renders all thirty-two corners of the five-knob space at once. That
// is how a bad range gets caught: a corner that is ugly means the range is
// wrong, never that the question is.

const pals = palettes.palettes;

// Bashō, 1686, in a plain rendering made for this site.
const POEM = "the old pond —\na frog jumps in,\nthe sound of water";

const KNOBS = [
  { id: "watch",   label: "knows you are reading it", a: "unaware",   b: "watching" },
  { id: "gather",  label: "looking at / away from",   a: "away",      b: "at" },
  { id: "comfort", label: "comforts / refuses",       a: "refuses",   b: "comforts" },
  { id: "arrive",  label: "arrives / keeps leaving",  a: "leaving",   b: "arriving" },
  { id: "certain", label: "certain / performing it",  a: "performing", b: "certain" },
];

const SHAPES = ["globe", "pyramid", "flower", "shard"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>the instrument · lab</title>
    <meta name="description" content="a poem, read by turning five knobs. the paint is borrowed from real paintings." />
    <meta property="og:title" content="the instrument" />
    <meta property="og:description" content="a poem, read by turning five knobs. the paint is borrowed from real paintings." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://dmklochko.com/images/lab-shader-og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="the instrument" />
    <meta name="twitter:description" content="a poem, read by turning five knobs. the paint is borrowed from real paintings." />
    <meta name="twitter:image" content="https://dmklochko.com/images/lab-shader-og.jpg" />
    <style is:global>
      :root {
        --void: #262b44; --bone: #ece6d9; --dim: #a9aecb; --hot: #ff9bc0;
        --deck: #2f3554; --rule: rgb(236 230 217 / 12%);
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        background: var(--void); color: var(--bone); font-family: var(--mono);
        min-height: 100vh; padding: clamp(1rem, 3vw, 2.5rem);
        display: grid; gap: 1.4rem;
        grid-template-columns: minmax(0, 1fr) 21rem;
        align-items: start;
      }
      @media (max-width: 900px) { body { grid-template-columns: minmax(0, 1fr); } }

      h1 { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
           color: var(--dim); font-weight: 400; margin-bottom: 0.7rem; }

      @font-face { font-family: "Newsreader"; src: url("/fonts/newsreader-400i.woff2") format("woff2");
                   font-style: italic; font-weight: 400; font-display: swap; }

      /* The poem is set, not painted. Its letterforms still stir the paint
         underneath — invisibly — so it is in the image without being stuck
         onto it. */
      .poem {
        font-family: "Newsreader", Georgia, serif; font-style: italic;
        font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1.7;
        color: var(--bone); margin: 0 auto 1rem; text-align: center;
        max-width: min(78vh, 720px);
      }
      .poem span { display: block; }

      .reading {
        max-width: min(78vh, 720px); margin: 0.8rem auto 0; text-align: center;
        font-size: 0.72rem; letter-spacing: 0.08em; color: var(--dim);
      }
      .reading b { color: var(--hot); font-weight: 400; }

      /* the form sits in its own frame, not behind everything */
      .frame {
        position: relative;
        aspect-ratio: 1;
        max-height: min(78vh, 720px);
        margin-inline: auto;
        width: 100%;
        max-width: min(78vh, 720px);
        border: 1px solid var(--rule);
        border-radius: 14px;
        overflow: hidden;
        background: radial-gradient(120% 100% at 50% 8%, #2d3352, #1e2338 70%);
        cursor: grab;
        touch-action: pan-y;
      }
      .frame:active { cursor: grabbing; }
      .frame canvas { display: block; width: 100%; height: 100%; }

      .rig { display: grid; gap: 0.55rem; align-content: start; }
      .knob { display: grid; gap: 0.15rem; }
      .knob-top { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--dim); }
      .knob-top b { color: var(--bone); font-weight: 400; }
      .knob input { width: 100%; accent-color: var(--hot); }
      .ends { display: flex; justify-content: space-between; font-size: 0.62rem; color: var(--dim); opacity: 0.75; }
      .ends i { font-style: normal; }
      .row { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; margin-top: 0.2rem; }
      .row button, .row a {
        font: inherit; font-size: 0.7rem; color: var(--bone);
        background: transparent; border: 1px solid var(--rule);
        border-radius: 999px; padding: 0.35rem 0.7rem; cursor: pointer; text-decoration: none;
      }
      .row button.on, .row a.on { border-color: var(--hot); color: var(--hot); }
      .swatch { padding: 0.3rem 0.35rem; line-height: 0; flex: none; }
      .pal { display: flex; gap: 2px; }
      .pal i { width: 11px; height: 11px; border-radius: 2px; display: block; flex: none; }
      .who { font-size: 0.62rem; color: var(--dim); margin-top: 0.15rem; }

      .sheet { grid-column: 1 / -1; }
      .sheet canvas { width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 8px; }
    </style>
  </head>
  <body>
    <div>
      <h1>the instrument</h1>
      <p class="poem">{POEM.split("\n").map((l) => <span>{l}</span>)}</p>
      <div class="frame" id="frame"></div>
      <p class="reading" id="reading"></p>
    </div>

    <div class="rig" id="rig">
      {KNOBS.map((k) => (
        <label class="knob">
          <span class="knob-top">{k.label}<b data-out={k.id}>0.50</b></span>
          <input type="range" min="0" max="1" step="0.01" value="0.5" data-knob={k.id} />
          <span class="ends"><i>{k.a}</i><i>{k.b}</i></span>
        </label>
      ))}

      <div class="row" id="shapes">
        {SHAPES.map((s) => (
          <button type="button" data-shape={s}>{s}</button>
        ))}
      </div>

      <div class="row" id="pals"></div>
      <p class="who" id="who"></p>

      <div class="row">
        <button type="button" id="roll">random</button>
      </div>
      <div class="row">
        <button type="button" id="copy">copy link</button>
        <button type="button" id="save">save image</button>
        <a href="?grid">32 corners →</a>
      </div>
    </div>

    <script is:inline type="application/json" id="pal-data" set:html={JSON.stringify({ pals, poem: POEM })} />

    <script>
      import * as THREE from "three";
      import { mergeGeometries } from "three/examples/jsm/utils/BufferGeometryUtils.js";

      (() => {
        const { pals, poem } = JSON.parse(document.getElementById("pal-data").textContent);
        const params = new URLSearchParams(location.search);
        const grid = params.has("grid");
        const poster = params.has("poster");
        const palIndex = Math.min(pals.length - 1, Math.max(0, +(params.get("pal") || 0)));
        const shape0 = ["globe", "pyramid", "flower", "shard"].includes(params.get("shape")) ? params.get("shape") : "globe";
        // A reading is its five answers, its painting and its form, so that
        // is all a link needs to carry: open someone's link and you are
        // looking at their object, not at a page about it.
        const KEYS = ["watch", "gather", "comfort", "arrive", "certain"];
        const fromUrl = (params.get("k") || "").split(",").map(Number);
        const start = KEYS.map((k, i) => Number.isFinite(fromUrl[i]) ? Math.min(100, Math.max(0, fromUrl[i])) / 100 : 0.5);

        // ── the poem, as a texture wrapped round the form ─────────────────
        const VERT = `
          varying vec2 vUv; varying vec3 vN; varying vec3 vPos; varying vec3 vView;
          void main(){
            vUv = uv;
            vN = normalize(normalMatrix * normal);
            vPos = position;
            vec4 mv = modelViewMatrix * vec4(position, 1.0);
            vView = normalize(-mv.xyz);
            gl_Position = projectionMatrix * mv;
          }`;

        const FRAG = `
          precision highp float;
          varying vec2 vUv; varying vec3 vN; varying vec3 vPos; varying vec3 vView;
          uniform float uTime, uWatch, uGather, uComfort, uArrive, uCertain;
          uniform vec2 uMouse, uRes;
          uniform vec3 uPal0, uPal1, uPal2, uPal3, uPal4;
          uniform float uEdge, uBand, uGrain, uGlaze, uCalm;

          float hash(vec3 p){ return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453123); }
          float noise(vec3 p){
            vec3 i = floor(p), f = fract(p);
            f = f * f * (3.0 - 2.0 * f);
            float n000 = hash(i), n100 = hash(i + vec3(1,0,0));
            float n010 = hash(i + vec3(0,1,0)), n110 = hash(i + vec3(1,1,0));
            float n001 = hash(i + vec3(0,0,1)), n101 = hash(i + vec3(1,0,1));
            float n011 = hash(i + vec3(0,1,1)), n111 = hash(i + vec3(1,1,1));
            return mix(mix(mix(n000,n100,f.x), mix(n010,n110,f.x), f.y),
                       mix(mix(n001,n101,f.x), mix(n011,n111,f.x), f.y), f.z);
          }
          float fbm(vec3 p){
            float v = 0.0, a = 0.5;
            for (int i = 0; i < 5; i++){ v += a * noise(p); p = p * 2.03 + vec3(1.7, 9.2, 4.4); a *= 0.5; }
            return v;
          }
          float ridge(vec3 p){
            float v = 0.0, a = 0.5;
            for (int i = 0; i < 4; i++){
              float n = 1.0 - abs(noise(p) * 2.0 - 1.0);
              v += a * n * n; p = p * 2.11 + vec3(4.1, 2.3, 7.9); a *= 0.5;
            }
            return v;
          }
          vec3 ramp(float t){
            t = clamp(t, 0.0, 1.0) * 4.0;
            float s = smoothstep(0.0, 1.0, fract(t));
            if (t < 1.0) return mix(uPal0, uPal1, s);
            if (t < 2.0) return mix(uPal1, uPal2, s);
            if (t < 3.0) return mix(uPal2, uPal3, s);
            return mix(uPal3, uPal4, s);
          }

          void main(){
            float t = uTime;

            // The poem is not in here. Two attempts put it in — the
            // letterforms displacing the paint, then the same softened to a
            // mass — and both left a rectangle of disturbance in the middle
            // of every object. It is set in type above instead, where it can
            // be read, and the paint is only paint.

            // watching: the field leans toward where the reader is looking
            vec3 m = vec3((uMouse - 0.5) * 2.0, 0.85);
            float pull = uWatch * 2.6 * exp(-length(vPos - m) * 1.1);

            float dir = mix(-1.0, 1.0, uArrive);
            float tremor = 1.0 - uCertain;

            vec3 q = vPos * mix(5.2, 0.5, uGather);
            q += normalize(vPos + vec3(1e-4)) * dir * t * mix(0.01, 0.62, abs(uArrive - 0.5) * 2.0);
            q -= (vPos - m) * pull;

            vec3 w = vec3(fbm(q + vec3(0.0, t * 0.05, 0.0)), fbm(q + vec3(5.2, 1.3, 2.1) - t * 0.04), fbm(q - vec3(3.3, 0.7, 6.4)));
            q += (w - 0.5) * (0.45 + tremor * 3.4);
            q += (vec3(fbm(q * 4.2 + t * 0.35), fbm(q * 4.4 - t * 0.3), fbm(q * 4.0)) - 0.5) * tremor * 1.5;

            float smoothF = fbm(q * 1.45);
            float ridged = ridge(q * 1.8);
            float bands = 0.5 + 0.5 * sin((smoothF * (5.0 + 9.0 * uBand) + t * 0.05) * 3.14159 * mix(1.0, 3.2, uCertain));

            // The knobs are the reading; the manner is the hand holding the
            // brush. Turner has no edges and endless glaze, af Klint draws
            // hard geometry, Monet is all broken stroke, Hammershøi holds
            // still. Each painter biases the field without overruling it.
            float f = mix(mix(ridged, smoothF, 0.35 + 0.3 * uGlaze),
                          mix(smoothF, bands, 0.25 + 0.6 * uBand), uCertain);
            f = mix(f, ridged, uGrain * 0.35 * (1.0 - uCertain));
            f += (noise(q * 9.0) - 0.5) * uGrain * 0.22;          // broken stroke

            // glaze: a second, slower layer read through the first, the way
            // thin paint is laid over dry paint
            float glazeLayer = fbm(q * 0.55 + vec3(3.1, 1.4, 0.7));
            f = mix(f, f * (0.55 + 0.9 * glazeLayer), uGlaze * 0.7);


            // gathered toward the pole the reader faces, or pushed outward
            float facing = clamp(dot(normalize(vN), normalize(vView)), 0.0, 1.0);
            // gathered into a single lit core, or thrown out to the rim
            float core = pow(facing, mix(1.0, 6.0, uGather));
            f *= mix(0.25 + 1.7 * pow(1.0 - facing, 1.6), 0.3 + 1.9 * core, uGather);

            float c = clamp(f, 0.0, 1.0);
            float bite = mix(1.6, 7.5, uEdge) * mix(1.0, 0.5, uCalm);
            float hard = clamp((c - 0.48) * mix(bite, 0.85, uComfort) + 0.46, 0.0, 1.0);
            // refusing goes all the way to hard steps of colour
            float steps = floor(hard * 5.0) / 5.0;
            hard = mix(steps, hard, clamp(uComfort * 2.0, 0.0, 1.0));
            float soft = smoothstep(-0.05 - 0.25 * uGlaze, 1.05 + 0.2 * uGlaze, c + 0.12 * fbm(q * 0.5));
            c = mix(hard, soft, mix(uComfort, 0.5 + 0.5 * uComfort, 1.0 - uEdge));

            vec3 col = ramp(c);
            float gray = dot(col, vec3(0.299, 0.587, 0.114));
            col = mix(vec3(gray), col, 0.85 + 0.3 * uComfort);

            // the form reads as a form: light gathers along its turning edge
            float rim = pow(1.0 - facing, 2.6);
            col += rim * uPal4 * (0.18 + 0.3 * uComfort + 0.25 * uGlaze);
            col *= 0.72 + 0.5 * facing;

            col = col * 1.06 / (1.0 + col * 0.42);

            // The poem is not drawn here. It is set in type beside the
            // object; what it does inside the paint is push it around, which
            // is why the structure below is the poem's and not noise.

            gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
          }`;

        // ── the forms ─────────────────────────────────────────────────────
        function geometry(name) {
          // A wide pyramid rather than a spire: the poem has to fit inside
          // the silhouette it is painted on.
          if (name === "pyramid") return new THREE.ConeGeometry(1.7, 2.0, 4, 32, false);
          // Sharp, unsubdivided: a subdivided octahedron is just a lumpy ball.
          if (name === "shard") return new THREE.OctahedronGeometry(1.55, 0);
          if (name === "flower") {
            // Petals, not lobes. Pushing a sphere outward only ever gives
            // blobs, because the topology fights you: five flattened blades
            // splayed around a throat is what actually reads as a bloom.
            const parts = [new THREE.SphereGeometry(0.42, 48, 32)];
            for (let i = 0; i < 5; i++) {
              const petal = new THREE.SphereGeometry(1, 44, 28);
              petal.scale(0.5, 0.13, 0.95);
              petal.translate(0, 0, 0.95);
              petal.rotateX(-0.5);
              petal.rotateY((i / 5) * Math.PI * 2);
              parts.push(petal);
            }
            const g = mergeGeometries(parts, false);
            g.computeVertexNormals();
            g.scale(0.8, 0.8, 0.8);
            g.computeBoundingSphere();                     // sit it in the frame
            const c = g.boundingSphere.center;
            g.translate(-c.x, -c.y, -c.z);
            return g;
          }
          return new THREE.SphereGeometry(1.35, 160, 120);
        }

        const hex2rgb = (h) => new THREE.Color(h);

        function makeScene(width, height) {
          const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
          renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
          renderer.setSize(width, height, false);
          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 100);
          camera.position.z = 4.4;
          const uniforms = {
            uTime: { value: 0 }, uMouse: { value: new THREE.Vector2(0.5, 0.5) },
            uRes: { value: new THREE.Vector2(width, height) },
            uWatch: { value: start[0] }, uGather: { value: start[1] }, uComfort: { value: start[2] },
            uArrive: { value: start[3] }, uCertain: { value: start[4] },
            uPal0: { value: new THREE.Color() }, uPal1: { value: new THREE.Color() },
            uPal2: { value: new THREE.Color() }, uPal3: { value: new THREE.Color() },
            uPal4: { value: new THREE.Color() },
            uEdge: { value: 0.4 }, uBand: { value: 0.3 }, uGrain: { value: 0.4 },
            uGlaze: { value: 0.5 }, uCalm: { value: 0.6 },
          };
          const material = new THREE.ShaderMaterial({ vertexShader: VERT, fragmentShader: FRAG, uniforms });
          const mesh = new THREE.Mesh(geometry(shape0), material);
          scene.add(mesh);
          return { renderer, scene, camera, mesh, uniforms, material };
        }

        function setPalette(uniforms, p) {
          p.stops.forEach((s, i) => uniforms["uPal" + i].value.set(s));
          const m = p.manner || {};
          for (const k of ["edge", "band", "grain", "glaze", "calm"]) {
            if (typeof m[k] === "number") uniforms["u" + k[0].toUpperCase() + k.slice(1)].value = m[k];
          }
        }

        const state = { watch: 0.5, gather: 0.5, comfort: 0.5, arrive: 0.5, certain: 0.5, ink: 1 };
        let palette = pals[palIndex];

        // ── the contact sheet ─────────────────────────────────────────────
        if (grid) {
          document.body.innerHTML = "<div class='sheet'><h1>every corner of the five knobs · "
            + (palette.weather || palette.title) + " · " + palette.who + "</h1></div>";
          const holder = document.querySelector(".sheet");
          const TW = 300, TH = 300, COLS = 8, ROWS = 4, PAD = 22;
          const S = makeScene(TW, TH);
          S.uniforms.uRes.value.set(TW * S.renderer.getPixelRatio(), TH * S.renderer.getPixelRatio());
              setPalette(S.uniforms, palette);
          const sheet = document.createElement("canvas");
          sheet.width = COLS * TW; sheet.height = ROWS * (TH + PAD);
          const g = sheet.getContext("2d");
          g.fillStyle = "#262b44"; g.fillRect(0, 0, sheet.width, sheet.height);
          const keys = ["watch", "gather", "comfort", "arrive", "certain"];
          S.mesh.rotation.set(0.25, 0.7, 0);   // the sheet always shows the globe
          for (let i = 0; i < 32; i++) {
            keys.forEach((k, b) => { S.uniforms["u" + k[0].toUpperCase() + k.slice(1)].value = (i >> b) & 1; });
            S.uniforms.uTime.value = 8;
            S.renderer.render(S.scene, S.camera);
            const x = (i % COLS) * TW, y = Math.floor(i / COLS) * (TH + PAD);
            g.drawImage(S.renderer.domElement, x, y, TW, TH);
            g.fillStyle = "#a9aecb";
            g.font = "12px ui-monospace, monospace";
            g.fillText(keys.map((k, b) => ((i >> b) & 1) ? k[0].toUpperCase() : "·").join(" "), x + 6, y + TH + 15);
          }
          holder.appendChild(sheet);
          return;
        }

        // ── the live instrument ───────────────────────────────────────────
        if (poster) {
          // The object alone, filling the window: what a pasted link shows.
          // Hidden, not removed — the controls are still wired up below and
          // removing them threw before the first frame ever rendered.
          document.getElementById("rig").style.display = "none";
          document.querySelector("h1").style.display = "none";
          document.body.style.gridTemplateColumns = "minmax(0, 1fr)";
          const f = document.getElementById("frame");
          f.style.maxHeight = "58vh";
          f.style.maxWidth = "58vh";
          f.style.border = "0";
        }
        const frame = document.getElementById("frame");
        const rect = () => frame.getBoundingClientRect();
        const S = makeScene(Math.max(1, rect().width), Math.max(1, rect().height));
        S.uniforms.uRes.value.set(rect().width * S.renderer.getPixelRatio(), rect().height * S.renderer.getPixelRatio());
        frame.appendChild(S.renderer.domElement);
        setPalette(S.uniforms, palette);

        const whoLine = document.getElementById("who");
        // his own paintings carry a title where the museum ones carry a weather
        const showWho = () => { whoLine.textContent = (palette.weather || palette.title) + " · " + palette.who; };
        showWho();

        addEventListener("resize", () => {
          const r = rect();
          S.renderer.setSize(r.width, r.height, false);
          S.uniforms.uRes.value.set(r.width * S.renderer.getPixelRatio(), r.height * S.renderer.getPixelRatio());
          S.camera.aspect = r.width / r.height;
          S.camera.updateProjectionMatrix();
        }, { passive: true });

        const TILT = { globe: 0.18, pyramid: 0.06, flower: 0.95, shard: 0.3 };
        let spinY = 0.6, spinX = TILT[shape0] ?? 0.18, vy = 0, dragging = false, lx = 0, ly = 0;
        frame.addEventListener("pointerdown", (e) => { dragging = true; lx = e.clientX; ly = e.clientY; frame.setPointerCapture(e.pointerId); });
        frame.addEventListener("pointermove", (e) => {
          const r = rect();
          S.uniforms.uMouse.value.set((e.clientX - r.left) / r.width, 1 - (e.clientY - r.top) / r.height);
          if (!dragging) return;
          vy = (e.clientX - lx) * 0.006;
          spinY += vy;
          spinX = Math.max(-1.1, Math.min(1.1, spinX + (e.clientY - ly) * 0.005));
          lx = e.clientX; ly = e.clientY;
        });
        const drop = () => { dragging = false; };
        frame.addEventListener("pointerup", drop);
        frame.addEventListener("pointercancel", drop);

        const out = (id, v) => { document.querySelector(`[data-out="${id}"]`).textContent = v.toFixed(2); };
        KEYS.forEach((k, i) => {
          const input = document.querySelector(`[data-knob="${k}"]`);
          input.value = start[i];
          out(k, start[i]);
        });
        for (const input of document.querySelectorAll("[data-knob]")) {
          input.addEventListener("input", () => {
            const k = input.dataset.knob;
            S.uniforms["u" + k[0].toUpperCase() + k.slice(1)].value = +input.value;
            out(k, +input.value);
            sayReading();
          });
        }
        for (const b of document.querySelectorAll("[data-shape]")) {
          if (b.dataset.shape === shape0) b.classList.add("on");
          b.addEventListener("click", () => {
            S.mesh.geometry.dispose();
            S.mesh.geometry = geometry(b.dataset.shape);
            spinX = TILT[b.dataset.shape] ?? 0.18;
            for (const o of b.parentElement.children) o.classList.remove("on");
            b.classList.add("on");
          });
        }
        document.getElementById("roll").addEventListener("click", () => {
          for (const input of document.querySelectorAll("[data-knob]")) {
            input.value = Math.random().toFixed(2);
            input.dispatchEvent(new Event("input"));
          }
        });
        const palRow = document.getElementById("pals");
        pals.forEach((p, i) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "swatch" + (i === palIndex ? " on" : "");
          b.title = `${p.weather} · ${p.who}`;
          b.innerHTML = `<span class="pal">${p.stops.map((s) => `<i style="background:${s}"></i>`).join("")}</span>`;
          b.addEventListener("click", () => {
            palette = p;
            setPalette(S.uniforms, p);
            showWho();
            for (const o of palRow.children) o.classList.remove("on");
            b.classList.add("on");
          });
          palRow.appendChild(b);
        });

        // ── the reading, said plainly ─────────────────────────────────────
        // Five sliders are not self-explanatory. This says what you have just
        // claimed about the poem, in the words of the questions themselves.
        const WORDS = {
          watch:   ["unaware of you", "half-aware", "watching you"],
          gather:  ["looking away", "unfixed", "looking at one thing"],
          comfort: ["refusing comfort", "even", "comforting"],
          arrive:  ["keeps leaving", "suspended", "arriving"],
          certain: ["performing certainty", "unsure", "certain"],
        };
        const readingLine = document.getElementById("reading");
        const sayReading = () => {
          readingLine.innerHTML = KEYS.map((k) => {
            const v = S.uniforms["u" + k[0].toUpperCase() + k.slice(1)].value;
            const w = WORDS[k][v < 0.34 ? 0 : v < 0.67 ? 1 : 2];
            return `<b>${w}</b>`;
          }).join(" · ");
        };

        // ── sharing ──────────────────────────────────────────────────────
        const readingUrl = () => {
          const u = new URL(location.href);
          u.search = "";
          u.searchParams.set("pal", String(pals.indexOf(palette)));
          u.searchParams.set("shape", document.querySelector("[data-shape].on").dataset.shape);
          u.searchParams.set("k", KEYS.map((k) =>
            Math.round(S.uniforms["u" + k[0].toUpperCase() + k.slice(1)].value * 100)).join(","));
          return u.toString();
        };

        const flash = (btn, word) => {
          const had = btn.textContent;
          btn.textContent = word;
          btn.classList.add("on");
          setTimeout(() => { btn.textContent = had; btn.classList.remove("on"); }, 1400);
        };

        document.getElementById("copy").addEventListener("click", async (e) => {
          const url = readingUrl();
          history.replaceState(null, "", url);
          try {
            await navigator.clipboard.writeText(url);
            flash(e.target, "copied ✓");
          } catch {
            // no clipboard permission: put the link somewhere the keystroke
            // can actually reach, rather than telling them to press a key
            // with nothing selected
            const field = document.createElement("input");
            field.value = url;
            field.style.cssText = "position:fixed;left:1rem;bottom:4.5rem;z-index:9;width:min(30rem,90vw);font:inherit;font-size:.7rem;padding:.4rem .6rem;color:var(--bone);background:var(--deck);border:1px solid var(--hot);border-radius:8px";
            document.body.appendChild(field);
            field.select();
            flash(e.target, "select & copy");
            field.addEventListener("blur", () => field.remove());
          }
        });

        // The still is rendered fresh at poster size rather than scaled up
        // from the canvas on screen, so what gets posted is sharp.
        document.getElementById("save").addEventListener("click", (e) => {
          const W = 1600, H = 1000;
          const P = makeScene(W, H);
          P.uniforms.uRes.value.set(W, H);
          P.mesh.geometry.dispose();
          P.mesh.geometry = geometry(document.querySelector("[data-shape].on").dataset.shape);
          P.mesh.rotation.copy(S.mesh.rotation);
          for (const k of ["Watch", "Gather", "Comfort", "Arrive", "Certain"]) {
            P.uniforms["u" + k].value = S.uniforms["u" + k].value;
          }
          P.uniforms.uMouse.value.copy(S.uniforms.uMouse.value);
          P.uniforms.uTime.value = S.uniforms.uTime.value;
          setPalette(P.uniforms, palette);
          P.renderer.render(P.scene, P.camera);
          P.renderer.domElement.toBlob((blob) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(blob);
            a.download = `reading-${palette.title.replace(/\W+/g, "-")}.png`;
            a.click();
            setTimeout(() => { URL.revokeObjectURL(a.href); P.renderer.dispose(); }, 4000);
            flash(e.target, "saved ✓");
          }, "image/png");
        });

        sayReading();

        const t0 = performance.now();
        S.renderer.setAnimationLoop(() => {
          const now = (performance.now() - t0) / 1000;
          S.uniforms.uTime.value = now;
          if (!dragging) { spinY += 0.0016 + vy; vy *= 0.94; }
          // a watching object turns to face the reader; an unaware one does
          // not notice them at all
          const w = S.uniforms.uWatch.value;
          const mx = S.uniforms.uMouse.value.x - 0.5, my = S.uniforms.uMouse.value.y - 0.5;
          S.mesh.rotation.y = spinY + w * mx * 1.1;
          S.mesh.rotation.x = spinX - w * my * 0.8;
          S.renderer.render(S.scene, S.camera);
        });
      })();
    </script>
  </body>
</html>
