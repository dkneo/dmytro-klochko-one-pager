---
import palettes from "../../data/palettes.json";

// The instrument, before anything is built on it.
//
// Five knobs, one shader, no questions and no poem-picking yet. The point of
// this page is to answer one question honestly: is the thing beautiful at
// every setting? If it is not beautiful here it will never be beautiful with
// questions attached, and we will have spent a day instead of a project.
//
// Two rules hold the whole design up:
//
//   Nothing is generated but light. Colour comes only from `palettes.json`,
//   five stops sampled by k-means from the actual paintings that carry the
//   weathers on /today. No answer, knob or accident can invent a colour.
//
//   The poem is the composition. Its letterforms render to a texture that
//   displaces the field, so there is always legible structure underneath
//   rather than noise. It is the difference between a shader and a poem
//   moving.
//
// ?grid renders all thirty-two corners of the five-knob space at once, which
// is how we check that no combination is ugly. A bad corner means a badly
// chosen range, and the range gets retuned — never the question.

const pals = palettes.palettes;

// Bashō, 1686, translated for this site rather than quoted from an edition.
const POEM = "the old pond —\na frog jumps in,\nthe sound of water";

const KNOBS = [
  { id: "watch",   label: "knows you are reading it", a: "unaware", b: "watching" },
  { id: "gather",  label: "looking at / away from",   a: "away",    b: "at" },
  { id: "comfort", label: "comforts / refuses",       a: "refuses", b: "comforts" },
  { id: "arrive",  label: "arrives / keeps leaving",  a: "leaving", b: "arriving" },
  { id: "certain", label: "certain / performing it",  a: "performing", b: "certain" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>the instrument · lab</title>
    <style>
      :root {
        --void: #262b44; --bone: #ece6d9; --dim: #a9aecb; --hot: #ff9bc0;
        --deck: #2f3554; --rule: rgb(236 230 217 / 12%);
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; margin: 0; }
      body { background: var(--void); color: var(--bone); font-family: var(--mono); }

      .stage { position: fixed; inset: 0; }
      .stage canvas { display: block; width: 100%; height: 100%; }

      .rig {
        position: fixed; left: 1rem; bottom: 1rem; z-index: 3;
        display: grid; gap: 0.5rem;
        padding: 0.9rem 1rem 1rem;
        background: rgb(38 43 68 / 82%);
        backdrop-filter: blur(14px);
        border: 1px solid var(--rule); border-radius: 10px;
        width: min(24rem, calc(100vw - 2rem));
      }
      .rig h1 { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); font-weight: 400; }
      .knob { display: grid; gap: 0.15rem; }
      .knob-top { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--dim); }
      .knob-top b { color: var(--bone); font-weight: 400; }
      .knob input { width: 100%; accent-color: var(--hot); }
      .ends { display: flex; justify-content: space-between; font-size: 0.62rem; color: var(--dim); opacity: 0.75; }
      .row { display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center; }
      .row button, .row a {
        font: inherit; font-size: 0.7rem; color: var(--bone);
        background: transparent; border: 1px solid var(--rule);
        border-radius: 999px; padding: 0.35rem 0.7rem; cursor: pointer; text-decoration: none;
      }
      .row button.on { border-color: var(--hot); color: var(--hot); }
      .swatch { padding: 0.3rem 0.35rem; line-height: 0; flex: none; }
      .pal { display: flex; gap: 2px; }
      .pal i { width: 11px; height: 11px; border-radius: 2px; display: block; flex: none; }

      .sheet { padding: 1rem; }
      .sheet h1 { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); font-weight: 400; margin-bottom: 0.8rem; }
      .sheet canvas { width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 8px; }
    </style>
  </head>
  <body>
    <div class="stage" id="stage"></div>

    <div class="rig" id="rig">
      <h1>the instrument</h1>
      {KNOBS.map((k) => (
        <label class="knob">
          <span class="knob-top">{k.label}<b data-out={k.id}>0.50</b></span>
          <input type="range" min="0" max="1" step="0.01" value="0.5" data-knob={k.id} />
          <span class="ends"><i>{k.a}</i><i>{k.b}</i></span>
        </label>
      ))}
      <div class="row" id="pals"></div>
      <div class="row">
        <button type="button" id="ink" class="on">poem on</button>
        <button type="button" id="roll">random</button>
        <a href="?grid">32 corners →</a>
        <button type="button" id="hide">hide</button>
      </div>
    </div>

    <script is:inline type="application/json" id="pal-data" set:html={JSON.stringify({ pals, poem: POEM })} />

    <script is:inline>
      (() => {
        const { pals, poem } = JSON.parse(document.getElementById("pal-data").textContent);
        const params = new URLSearchParams(location.search);
        const grid = params.has("grid");
        const palIndex = Math.min(pals.length - 1, Math.max(0, +(params.get("pal") || 0)));

        // ── the poem, as a texture ────────────────────────────────────────
        // Its letterforms are the only structure in the image; everything
        // else is light moving over them.
        function poemCanvas(w, h) {
          const c = document.createElement("canvas");
          c.width = w; c.height = h;
          const g = c.getContext("2d");
          const lines = poem.split("\n");
          g.textAlign = "center";
          g.textBaseline = "middle";
          g.fillStyle = "#fff";
          // Shrink until the longest line clears the margins: a poem running
          // off its own edges is not a reading, it is a crop.
          const room = w * 0.74;
          let size = Math.round(Math.min(w / 16, h / 8));
          for (let i = 0; i < 40; i++) {
            g.font = `italic ${size}px Georgia, serif`;
            const widest = Math.max(...lines.map((l) => g.measureText(l).width));
            if (widest <= room && size * 1.55 * lines.length <= h * 0.72) break;
            size = Math.round(size * 0.94);
          }
          const lead = size * 1.55;
          let y = h * 0.38 - (lines.length - 1) * lead / 2;
          for (const l of lines) { g.fillText(l, w / 2, y); y += lead; }
          return c;
        }

        const VERT = `attribute vec2 aPos; varying vec2 vUv;
          void main(){ vUv = aPos * 0.5 + 0.5; gl_Position = vec4(aPos, 0.0, 1.0); }`;

        const FRAG = `precision highp float;
          varying vec2 vUv;
          uniform vec2 uRes; uniform float uTime; uniform vec2 uMouse;
          uniform float uWatch, uGather, uComfort, uArrive, uCertain, uInk;
          uniform vec3 uPal0, uPal1, uPal2, uPal3, uPal4;
          uniform sampler2D uText;

          float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }
          float noise(vec2 p){
            vec2 i = floor(p), f = fract(p);
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
                       mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
          }
          float fbm(vec2 p){
            float v = 0.0, a = 0.5;
            for (int i = 0; i < 5; i++) { v += a * noise(p); p = p * 2.03 + vec2(1.7, 9.2); a *= 0.5; }
            return v;
          }
          // ridged noise gives filaments where fbm only gives fog
          float ridge(vec2 p){
            float v = 0.0, a = 0.5;
            for (int i = 0; i < 4; i++) {
              float n = 1.0 - abs(noise(p) * 2.0 - 1.0);
              v += a * n * n; p = p * 2.11 + vec2(4.1, 2.3); a *= 0.5;
            }
            return v;
          }
          vec3 ramp(float t){
            t = clamp(t, 0.0, 1.0) * 4.0;
            float s = smoothstep(0.0, 1.0, fract(t));
            if (t < 1.0) return mix(uPal0, uPal1, s);
            if (t < 2.0) return mix(uPal1, uPal2, s);
            if (t < 3.0) return mix(uPal2, uPal3, s);
            return mix(uPal3, uPal4, s);
          }

          void main(){
            float asp = uRes.x / max(uRes.y, 1.0);
            vec2 uv = vUv;
            vec2 p = (uv - 0.5) * vec2(asp, 1.0);
            float t = uTime;

            // ── the poem, and its slope ────────────────────────────────
            // Sampling the letterforms three times gives their gradient, and
            // the gradient is what stirs the field: the text does not sit on
            // the image, it pushes it around.
            vec2 px = vec2(1.4 / uRes.x, 1.4 / uRes.y);
            float ink  = texture2D(uText, uv).a;
            float inkX = texture2D(uText, uv + vec2(px.x, 0.0)).a - texture2D(uText, uv - vec2(px.x, 0.0)).a;
            float inkY = texture2D(uText, uv + vec2(0.0, px.y)).a - texture2D(uText, uv - vec2(0.0, px.y)).a;
            vec2 inkGrad = vec2(inkX, inkY);

            // ── watching ───────────────────────────────────────────────
            vec2 m = (uMouse - 0.5) * vec2(asp, 1.0);
            vec2 toM = p - m;
            float pull = uWatch * 0.85 * exp(-length(toM) * 2.6);

            // ── arriving or leaving ────────────────────────────────────
            float dir = mix(-1.0, 1.0, uArrive);
            vec2 radial = normalize(p + vec2(1e-4));
            vec2 flow = radial * dir * mix(0.05, 0.42, abs(uArrive - 0.5) * 2.0);

            float tremor = (1.0 - uCertain);

            // ── the field ──────────────────────────────────────────────
            vec2 q = p * mix(2.6, 0.9, uGather);
            q += flow * t * 0.2;
            q -= toM * pull;
            q -= inkGrad * uInk * (9.0 + 14.0 * uComfort);   // the poem stirs it

            vec2 w = vec2(fbm(q + vec2(0.0, t * 0.06)), fbm(q + vec2(5.2, 1.3) - t * 0.05));
            q += (w - 0.5) * (0.7 + tremor * 2.2);
            q += (vec2(fbm(q * 4.2 + t * 0.4), fbm(q * 4.5 - t * 0.36)) - 0.5) * tremor * 0.8;

            float smoothF = fbm(q * 1.5);
            float ridged  = ridge(q * 1.9);
            // certain: clean banded geometry. performing: filaments and grain.
            float bands = 0.5 + 0.5 * sin((smoothF * 6.2 + t * 0.05) * 3.14159);
            float f = mix(mix(ridged, smoothF, 0.35), mix(smoothF, bands, 0.55), uCertain);

            f += ink * uInk * 0.5;

            // ── gathered, or gone to the edges ─────────────────────────
            float r = length(p) / (0.5 * asp + 0.5);
            float centred = 1.0 - smoothstep(-0.35, 1.5, r);
            float edged = smoothstep(-0.2, 1.5, r);
            f *= mix(0.45 + 1.0 * edged, 0.55 + 0.95 * centred, uGather);

            // ── comforting light, or held contrast ─────────────────────
            float c = clamp(f, 0.0, 1.0);
            float hard = clamp((c - 0.48) * mix(3.4, 1.0, uComfort) + 0.46, 0.0, 1.0);
            float soft = smoothstep(-0.05, 1.05, c + 0.14 * fbm(q * 0.5));
            c = mix(hard, soft, uComfort);

            vec3 col = ramp(c);
            // saturation lifts a touch with comfort, never inventing a hue
            float gray = dot(col, vec3(0.299, 0.587, 0.114));
            col = mix(vec3(gray), col, 0.85 + 0.3 * uComfort);
            col += uComfort * 0.14 * pow(clamp(f, 0.0, 1.0), 4.0) * uPal4;

            // Highlights roll off instead of clipping. Without this the
            // gathered-and-comforting corner went to flat white and swallowed
            // the poem: a bad range, not a bad question.
            col = col * 1.06 / (1.0 + col * 0.42);

            // The poem is legible at every setting by construction: it takes
            // whichever end of its own painting's palette the field is not
            // already using, so it can never be white on white.
            float under = dot(col, vec3(0.299, 0.587, 0.114));
            vec3 letter = mix(uPal4, uPal0, smoothstep(0.42, 0.72, under));
            col = mix(col, letter, ink * uInk * 0.62);
            col += length(inkGrad) * uInk * 0.9 * letter * (0.3 + 0.4 * uCertain);

            col += (hash(uv * uRes + t) - 0.5) * 0.022;
            gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
          }`;

        function makeGL(canvas) {
          const gl = canvas.getContext("webgl", { antialias: true, preserveDrawingBuffer: true });
          if (!gl) return null;
          const sh = (type, src) => {
            const s = gl.createShader(type);
            gl.shaderSource(s, src); gl.compileShader(s);
            if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s));
            return s;
          };
          const prog = gl.createProgram();
          gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
          gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
          gl.linkProgram(prog);
          if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog));
          gl.useProgram(prog);
          const buf = gl.createBuffer();
          gl.bindBuffer(gl.ARRAY_BUFFER, buf);
          gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
          const loc = gl.getAttribLocation(prog, "aPos");
          gl.enableVertexAttribArray(loc);
          gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
          const U = (n) => gl.getUniformLocation(prog, n);
          const tex = gl.createTexture();
          gl.bindTexture(gl.TEXTURE_2D, tex);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
          return { gl, U, tex };
        }

        const hex2rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);

        function draw(ctx, w, h, state, palette, time, textCanvas) {
          const { gl, U, tex } = ctx;
          gl.viewport(0, 0, w, h);
          gl.bindTexture(gl.TEXTURE_2D, tex);
          gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, false);
          gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);   // canvases arrive bottom-up
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, textCanvas);
          gl.uniform1i(U("uText"), 0);
          gl.uniform2f(U("uRes"), w, h);
          gl.uniform1f(U("uTime"), time);
          gl.uniform2f(U("uMouse"), state.mx, state.my);
          for (const k of ["watch", "gather", "comfort", "arrive", "certain", "ink"]) {
            gl.uniform1f(U("u" + k[0].toUpperCase() + k.slice(1)), state[k]);
          }
          palette.stops.forEach((s, i) => gl.uniform3fv(U("uPal" + i), hex2rgb(s)));
          gl.drawArrays(gl.TRIANGLES, 0, 3);
        }

        const state = { watch: 0.5, gather: 0.5, comfort: 0.5, arrive: 0.5, certain: 0.5, ink: 1, mx: 0.5, my: 0.5 };
        let palette = pals[palIndex];

        // ── the contact sheet: all thirty-two corners at once ─────────────
        if (grid) {
          document.getElementById("rig").remove();
          const stage = document.getElementById("stage");
          stage.className = "sheet";
          stage.innerHTML = "<h1>every corner of the five knobs · " + palette.weather + "</h1>";
          const TW = 300, TH = 190, COLS = 8, ROWS = 4, PAD = 22;
          const off = document.createElement("canvas");
          off.width = TW; off.height = TH;
          const ctx = makeGL(off);
          const sheet = document.createElement("canvas");
          sheet.width = COLS * TW; sheet.height = ROWS * (TH + PAD);
          const g = sheet.getContext("2d");
          g.fillStyle = "#262b44"; g.fillRect(0, 0, sheet.width, sheet.height);
          const text = poemCanvas(TW, TH);
          const keys = ["watch", "gather", "comfort", "arrive", "certain"];
          for (let i = 0; i < 32; i++) {
            keys.forEach((k, b) => { state[k] = (i >> b) & 1; });
            draw(ctx, TW, TH, state, palette, 8.0, text);
            const x = (i % COLS) * TW, y = Math.floor(i / COLS) * (TH + PAD);
            g.drawImage(off, x, y);
            g.fillStyle = "#a9aecb";
            g.font = "12px ui-monospace, monospace";
            g.fillText(keys.map((k, b) => ((i >> b) & 1) ? k[0].toUpperCase() : "·").join(" "), x + 6, y + TH + 15);
          }
          stage.appendChild(sheet);
          return;
        }

        // ── the live instrument ───────────────────────────────────────────
        const stage = document.getElementById("stage");
        const canvas = document.createElement("canvas");
        stage.appendChild(canvas);
        const ctx = makeGL(canvas);
        if (!ctx) { stage.innerHTML = "<p style='padding:2rem'>this page needs webgl.</p>"; return; }

        let text = poemCanvas(1024, 640);
        const size = () => {
          const dpr = Math.min(devicePixelRatio || 1, 2);
          canvas.width = Math.round(innerWidth * dpr);
          canvas.height = Math.round(innerHeight * dpr);
          text = poemCanvas(canvas.width, canvas.height);
        };
        size();
        addEventListener("resize", size, { passive: true });
        addEventListener("pointermove", (e) => {
          state.mx = e.clientX / innerWidth;
          state.my = 1 - e.clientY / innerHeight;
        }, { passive: true });

        const out = (id, v) => { document.querySelector(`[data-out="${id}"]`).textContent = v.toFixed(2); };
        for (const input of document.querySelectorAll("[data-knob]")) {
          input.addEventListener("input", () => {
            state[input.dataset.knob] = +input.value;
            out(input.dataset.knob, +input.value);
          });
        }
        document.getElementById("ink").addEventListener("click", (e) => {
          state.ink = state.ink ? 0 : 1;
          e.target.classList.toggle("on", !!state.ink);
          e.target.textContent = state.ink ? "poem on" : "poem off";
        });
        document.getElementById("roll").addEventListener("click", () => {
          for (const input of document.querySelectorAll("[data-knob]")) {
            input.value = Math.random().toFixed(2);
            state[input.dataset.knob] = +input.value;
            out(input.dataset.knob, +input.value);
          }
        });
        const palRow = document.getElementById("pals");
        pals.forEach((p, i) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "swatch" + (i === palIndex ? " on" : "");
          b.title = `${p.weather} · ${p.who}`;
          b.innerHTML = `<span class="pal">${p.stops.map((s) => `<i style="background:${s}"></i>`).join("")}</span>`;
          b.addEventListener("click", () => {
            palette = p;
            for (const o of palRow.children) o.classList.remove("on");
            b.classList.add("on");
          });
          palRow.appendChild(b);
        });

        // the rig gets out of the way: press h, or the button
        const rig = document.getElementById("rig");
        const toggleRig = () => {
          const gone = rig.style.display === "none";
          rig.style.display = gone ? "" : "none";
          if (!gone) {
            const pill = document.createElement("button");
            pill.id = "unhide";
            pill.textContent = "knobs";
            pill.style.cssText = "position:fixed;left:1rem;bottom:1rem;z-index:4;font:inherit;font-size:.7rem;color:var(--bone);background:rgb(38 43 68 / 82%);border:1px solid var(--rule);border-radius:999px;padding:.4rem .8rem;cursor:pointer";
            pill.addEventListener("click", () => { pill.remove(); rig.style.display = ""; });
            document.body.appendChild(pill);
          }
        };
        document.getElementById("hide").addEventListener("click", toggleRig);
        addEventListener("keydown", (e) => { if (e.key === "h") toggleRig(); });

        const t0 = performance.now();
        const tick = () => {
          draw(ctx, canvas.width, canvas.height, state, palette, (performance.now() - t0) / 1000, text);
          requestAnimationFrame(tick);
        };
        tick();
      })();
    </script>
  </body>
</html>
