---
import EidosLayout from "../../layouts/EidosLayout.astro";
import EidosHeader from "../../components/eidos/EidosHeader.astro";
import map from "../../data/map.json";
import "../../styles/pages/eidos-places.css";

const plateFor = (src: string) => src.replace("/images/", "/images/plates/").replace(/\.[^.]+$/, ".webp");
const artworkKinds = new Set(["painting", "print", "poster"]);
const allWorks = map.items.filter((item: any) =>
  artworkKinds.has(item.type) && item.src && !item.id.startsWith("his-")
);
const works = allWorks
  .filter((item: any) => item.collectionCity && item.collection && item.collectionUrl && !/^his own|google art project$/i.test(item.collection))
  .sort((a: any, b: any) => a.collectionCity.localeCompare(b.collectionCity) || a.collection.localeCompare(b.collection) || a.who.localeCompare(b.who));
const unlocated = allWorks.length - works.length;
const institutions = new Set(works.map((item: any) => item.collection)).size;
const onView = works.filter((item: any) => /^on view\b/i.test(item.displayStatus || ""));
const slug = (value: string) => value.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const cities = [...new Set(works.map((item: any) => item.collectionCity))].map((city) => ({
  city,
  id: `city-${slug(city)}`,
  works: works.filter((item: any) => item.collectionCity === city),
}));
---

<EidosLayout title="map · eidos" description="the verified museums and cities holding works in dmytro's moodboard.">
  <div class="eidos-places">
    <EidosHeader current="map" />
    <main class="epl-shell">
      <header class="epl-intro">
        <div>
          <p class="epl-kicker">a map made from museum records</p>
          <h1>the works have addresses.</h1>
        </div>
        <div class="epl-intro-copy">
          <p>this is the practical layer of the moodboard: where the art lives, and what i could actually go meet.</p>
          <small>“collection” names the institution holding a work. it is not a promise that the work is on view today. live display notes include the date they were checked.</small>
        </div>
      </header>

      <dl class="epl-ledger" aria-label="map coverage">
        <div><dt>located</dt><dd>{works.length} works</dd></div>
        <div><dt>institutions</dt><dd>{institutions}</dd></div>
        <div><dt>cities</dt><dd>{cities.length}</dd></div>
        <div><dt>confirmed on view</dt><dd>{onView.length}</dd></div>
      </dl>

      {onView.length > 0 && (
        <section class="epl-now" aria-labelledby="on-view-now">
          <header>
            <p>checked recently</p>
            <h2 id="on-view-now">on view now.</h2>
          </header>
          <ol>
            {onView.map((item: any) => (
              <li>
                <a href={`/eidos/work/${item.id}`}>
                  <span>{item.title || item.line}</span>
                  <small>{item.collection} · {item.collectionCity}</small>
                  <em>{item.displayStatus.replace(/^on view\s*·?\s*/i, "") || "on view"}{item.statusChecked ? ` · checked ${item.statusChecked}` : ""}</em>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}

      <nav class="epl-index" aria-label="cities on the map">
        <p>jump to a city</p>
        <div>
          {cities.map(({ city, id, works: cityWorks }) => (
            <a href={`#${id}`}><span>{city}</span><b>{cityWorks.length}</b></a>
          ))}
        </div>
      </nav>

      <div class="epl-cities">
        {cities.map(({ city, id, works: cityWorks }) => (
          <section class="epl-city" data-place-city={city} aria-labelledby={id}>
            <header>
              <h2 id={id}>{city}</h2>
              <span>{cityWorks.length} {cityWorks.length === 1 ? "work" : "works"}</span>
            </header>
            <div class="epl-works">
              {cityWorks.map((item: any) => (
                <article class="epl-work" data-place-work data-kind={item.type}>
                  <a class="epl-art" href={`/eidos/work/${item.id}`} aria-label={`open ${item.title || item.line}`}>
                    <img src={plateFor(item.src)} alt={item.title || item.line} loading="lazy" decoding="async" />
                  </a>
                  <div>
                    <h3><a href={`/eidos/work/${item.id}`}>{item.title || item.line}</a></h3>
                    <p>{item.who}{item.year ? ` · ${item.year}` : ""}</p>
                    <a class="epl-museum" href={item.collectionUrl}>{item.collection} ↗</a>
                    {item.heightCm && item.widthCm && <small>{item.heightCm} × {item.widthCm} cm</small>}
                    {item.displayStatus && (
                      <small class:list={["epl-status", /^on view\b/i.test(item.displayStatus) && "is-on-view"]}>
                        {item.displayStatus}{item.statusChecked ? ` · checked ${item.statusChecked}` : ""}
                      </small>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <section class="epl-research" aria-labelledby="research-queue">
        <p>research queue</p>
        <h2 id="research-queue">{unlocated} works still need a verified current collection.</h2>
        <div>
          <p>they remain in the moodboard, fully credited and sourced. they stay off this map until an institution record says where they live.</p>
          <a href="/eidos#collection">see the complete moodboard</a>
        </div>
      </section>

      <footer class="epl-footer">
        <a href="/eidos#collection">back to the moodboard</a>
        <span>faun notices · gryphon keeps the addresses</span>
      </footer>
    </main>
  </div>
</EidosLayout>
