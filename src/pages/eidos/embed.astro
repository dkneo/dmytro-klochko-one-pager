---
import Bare from "../../layouts/Bare.astro";
import { buildProfile } from "../../lib/eidos-view.mjs";
import map from "../../data/map.json";
import palettes from "../../data/palettes.json";

// The portrait, alone, for a frame. Anyone who wants to show what he loves on
// their own page drops in one iframe; the numbers, the strip and the plates
// are the same component the library opens with, computed from the vault at
// build time, so an embed can never disagree with the room it points to.
// Links open in the top window: a frame is a window onto the library, not a
// place to be trapped in.
const title = "eidos · what dmytro klochko loves";
const description = "the portrait of a taste library: paintings, poems, songs and lines, filed under eight weathers.";
const profile = buildProfile(map, palettes);
const total = profile.collection.length;
---

<Bare title={title} description={description}>
  <base target="_top" />
  <main class="eidos-embed" data-total={total}>
    <header>
      <p>eidos · a living portrait</p>
      <h1>a taste has a shape.</h1>
    </header>
    <section aria-label="what the archive shows">
      {profile.observations.map((observation) => <p>{observation.text.toLowerCase()}</p>)}
    </section>
    <ol class="ee-weathers" aria-label="eight weathers, cold to warm">
      {profile.weathers.map((weather) => (
        <li style={`--weight:${Math.max(weather.count, 1)};--weather:linear-gradient(90deg,${weather.stops.join(",")})`} title={`${weather.name}: ${weather.count}`}><i></i><span>{weather.name}</span></li>
      ))}
    </ol>
    <footer>
      <span>{total} real things · every one attributed</span>
      <a href="https://dmklochko.com/eidos" target="_top" rel="noreferrer">open the portrait <span aria-hidden="true">↗</span></a>
    </footer>
  </main>

  <style>
    body.bare { margin: 0; background: var(--ep-paper); color: var(--ep-ink); }
    .eidos-embed { display: grid; grid-template-columns: minmax(14rem, 0.72fr) minmax(18rem, 1fr); gap: 2rem 3rem; max-width: 62rem; margin: 0 auto; padding: clamp(1.5rem, 5vw, 4rem); }
    .eidos-embed header p { margin: 0; color: var(--ep-raspberry); font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.13em; text-transform: uppercase; }
    .eidos-embed h1 { max-width: 7ch; margin: 0.45rem 0 0; font-family: var(--display, "Zodiak", var(--serif)); font-size: clamp(3.3rem, 8vw, 7rem); font-weight: 300; letter-spacing: -0.06em; line-height: 0.86; }
    .eidos-embed section { display: grid; align-content: end; gap: 0.75rem; }
    .eidos-embed section p { margin: 0; color: var(--ep-quiet); font-size: 1rem; line-height: 1.5; }
    .ee-weathers { grid-column: 1 / -1; display: flex; gap: 3px; margin: 0.5rem 0 0; padding: 0; list-style: none; }
    .ee-weathers li { flex: var(--weight) 1 0; min-width: 1.2rem; }
    .ee-weathers i { display: block; height: 0.9rem; background: var(--weather); }
    .ee-weathers span { display: none; }
    .eidos-embed footer { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 2rem; padding-top: 1rem; border-top: 1px solid var(--ep-rule); color: var(--ep-quiet); font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .eidos-embed footer a { color: var(--ep-raspberry); }
    @media (max-width: 620px) { .eidos-embed { grid-template-columns: 1fr; } .eidos-embed section, .ee-weathers, .eidos-embed footer { grid-column: 1; } .ee-weathers span { display: none; } }
  </style>
</Bare>
