---
import EidosLayout from "../../layouts/EidosLayout.astro";
import EidosHeader from "../../components/eidos/EidosHeader.astro";
import "../../styles/pages/eidos-studio.css";
import inbox from "../../../public/inbox.json";
import { groupCandidateEditions } from "../../lib/eidos-candidates.mjs";

// Discover is deliberately only paintings, prints and posters. The source
// inbox still carries every other picture, word and link. Nothing is deleted;
// those records wait for their own purpose-built surfaces.
//
// Three things carried over from the sitting it replaces:
//
//   The door is asked up front, not discovered on the first keep. An empty
//   post to the verdict route is a 400 when the cookie is good and a 401
//   when it is not, so the check costs nothing and writes nothing.
//
//   Verdicts are server truth, in KV, so two devices never show the same
//   card twice and nothing is lost to a refresh.
//
//   No ceremony. He judges until he stops; the line says where he is.

const artworkTypes = new Set(["painting", "print", "poster"]);
const rawCandidates = (inbox.candidates || [])
  .filter((c) => c.src && artworkTypes.has(c.type || "painting"))
  .map((c) => ({
    id: c.id,
    type: c.type || "painting",
    who: c.who || "",
    title: c.title || "",
    year: c.year || "",
    weather: c.weather || "",
    src: c.src || "",
    url: c.url || "",
    site: c.site || "",
    source: c.source || "",
    licence: c.licence || "",
  }));
const candidates = groupCandidateEditions(rawCandidates);
const pictures = candidates.length;
const shelfCount = (types) => candidates.filter((c) => types.includes(c.type)).length;
const shelves = [
  { id: "all", label: "all works", count: pictures },
  { id: "paintings", label: "paintings", count: shelfCount(["painting"]) },
  { id: "prints", label: "prints + posters", count: shelfCount(["print", "poster"]) },
].filter((shelf) => shelf.id === "all" || shelf.count > 0);

const title = "discover · eidos";
const description = "discover paintings and posters for the moodboard.";
---

<EidosLayout title={title} description={description}>
  <div class="eidos-studio">
    <EidosHeader current="discover" studio />
    <section class="in-shell" aria-labelledby="ib">
      <header class="in-intro">
        <div>
          <p class="ep-index">private discovery room</p>
          <h1 id="ib">notice. decide. remember.</h1>
        </div>
        <p id="in-lede">paintings and posters, one at a time. keep what pulls you closer and pass what does not.</p>
      </header>

      <form class="in-gate" id="gate" method="POST" action="/names" hidden>
        <span class="in-gate-mark" aria-hidden="true">G</span>
        <input type="hidden" name="next" value="/eidos/inbox" />
        <h2>the archive is private.</h2>
        <p>open it to continue.</p>
        <label>
          <span>password</span>
          <input type="password" name="password" autocomplete="current-password" autocapitalize="none" autocorrect="off" spellcheck="false" required />
        </label>
        <button type="submit">open archive</button>
        <span class="in-gate-note" id="gate-note"></span>
        <span class="in-gate-note">or <a href="/names" target="_blank" rel="noreferrer">open the door in a tab</a> and reload.</span>
      </form>

      <div class="in-workbench" id="workbench">
        <aside class="in-rail" aria-label="incoming queue">
          <div>
            <p class="in-label">incoming</p>
            <p class="in-count" id="count"></p>
          </div>
          <p class="in-shelf" id="shelf">
            <strong>paintings and posters only</strong>
            <span>{pictures} distinct works archived</span>
            <small>earlier swipes and other media stay safely archived.</small>
          </p>
          <nav class="in-filters" aria-label="filter the visual queue">
            <p class="in-label">show me</p>
            {shelves.map((shelf) => (
              <button type="button" data-queue-filter={shelf.id} aria-pressed={shelf.id === "all" ? "true" : "false"}>
                <span>{shelf.label}</span><b>{shelf.count}</b>
              </button>
            ))}
            <small>faun notices. gryphon archives the absolutes.</small>
          </nav>
          <div class="in-history">
            <p class="in-label">this sitting</p>
            <ol id="session-trail"><li class="is-empty">nothing judged yet</li></ol>
          </div>
        </aside>

        <section class="in-center" aria-label="current discovery card">
          <div class="in-stage" id="stage">
            <div class="in-next-edge" aria-hidden="true"></div>
            <article class="in-card" id="card" hidden>
              <div class="in-leaf in-leaf--it">
                <div class="in-art" id="art-wrap">
                  <div class="in-plate-loader" id="plate-loader" data-plate-loader hidden aria-hidden="true">
                    <span class="in-register-ring in-register-ring--ink"></span>
                    <span class="in-register-ring in-register-ring--pink"></span>
                    <span class="in-register-ring in-register-ring--ochre"></span>
                    <i></i>
                    <small>registering plate</small>
                  </div>
                  <img id="art" alt="" decoding="async" />
                  <div class="in-art-miss" id="art-miss" hidden>
                    <p>the picture did not arrive</p>
                    <button type="button" id="art-retry" class="in-btn">reload picture <span aria-hidden="true">↻</span></button>
                  </div>
                </div>
                <p class="in-credit">
                  <b id="c-title"></b>
                  <span id="c-who"></span>
                  <a id="c-source" href="#" target="_blank" rel="noreferrer">source ↗</a>
                </p>
              </div>
              <span class="in-edge in-edge--in" aria-hidden="true">keep</span>
              <span class="in-edge in-edge--out" aria-hidden="true">pass</span>
              <span class="in-favorite-stamp" aria-hidden="true"><b>absolute</b><small>gryphon archives</small></span>
            </article>
            <p class="in-note" id="note-line" hidden></p>
          </div>

          <div class="in-do" id="do">
            <button type="button" id="pass" class="in-btn in-btn--pass" aria-keyshortcuts="ArrowLeft h">pass <kbd>←</kbd></button>
            <button type="button" id="undo" class="in-btn in-btn--undo" aria-keyshortcuts="u z Meta+z" disabled>undo <kbd>u</kbd></button>
            <button type="button" id="keep" class="in-btn in-btn--keep" aria-keyshortcuts="ArrowRight l"><kbd>→</kbd> keep</button>
            <button type="button" id="favorite" class="in-btn in-btn--favorite" aria-keyshortcuts="f"><span aria-hidden="true">✦</span> absolute favorite</button>
            <button type="button" id="keys-open" class="in-btn in-btn--keys" aria-label="keyboard shortcuts" aria-keyshortcuts="?"><kbd>?</kbd></button>
          </div>

          <div class="in-feedback" data-studio-feedback aria-hidden="true">
            <video id="feedback-keep" muted playsinline preload="metadata"><source src="/images/eidos/product/save-to-profile.webm" type="video/webm" /><source src="/images/eidos/product/save-to-profile.mp4" type="video/mp4" /></video>
            <video id="feedback-pass" muted playsinline preload="metadata"><source src="/images/eidos/product/pass-card.webm" type="video/webm" /><source src="/images/eidos/product/pass-card.mp4" type="video/mp4" /></video>
          </div>
        </section>
      </div>

      <dialog class="in-keys" id="keys" aria-labelledby="keys-h">
        <h2 id="keys-h">keys</h2>
        <dl>
          <div><dt><kbd>→</kbd> <kbd>l</kbd></dt><dd>keep</dd></div>
          <div><dt><kbd>f</kbd></dt><dd>absolute favorite</dd></div>
          <div><dt><kbd>←</kbd> <kbd>h</kbd></dt><dd>pass</dd></div>
          <div><dt><kbd>u</kbd> <kbd>⌘z</kbd></dt><dd>undo the last verdict</dd></div>
          <div><dt><kbd>o</kbd> <kbd>↵</kbd></dt><dd>open source</dd></div>
          <div><dt><kbd>r</kbd></dt><dd>reload picture</dd></div>
          <div><dt><kbd>?</kbd></dt><dd>this sheet</dd></div>
        </dl>
        <form method="dialog"><button type="submit" class="in-btn">close <kbd>esc</kbd></button></form>
      </dialog>

      <dialog class="in-comparison" id="comparison" aria-labelledby="comparison-title">
        <p class="in-label">the gryphon asks</p>
        <h2 id="comparison-title">which one stays with you?</h2>
        <p>not the better work. the one you would miss.</p>
        <div class="in-comparison-pair">
          <button type="button" data-comparison-choice="0"><img alt="" /><span></span></button>
          <button type="button" data-comparison-choice="1"><img alt="" /><span></span></button>
        </div>
        <button type="button" class="in-comparison-skip" id="comparison-skip">not now</button>
      </dialog>
    </section>
    <footer class="ep-footer"><a href="/eidos">moodboard</a><span>private discovery room</span><a href="/eidos/map">atlas</a></footer>
  </div>

  <style media="not all">
    /* An author display rule beats the user agent's [hidden]; the sitting
       learned this the hard way when its door would not close. */
    [hidden] { display: none !important; }
    .in-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    /* the composer: one surface, lit from behind */
    .in-throw { position: relative; max-width: 34rem; margin: var(--sp-4) auto 0; }
    .in-throw::before {
      content: "";
      position: absolute;
      inset: -18px;
      /* the light's corner follows the surface's, plus the spill */
      border-radius: calc(var(--r-row) + 18px);
      background: conic-gradient(from 210deg,
        rgb(255 155 192 / 0.42), rgb(120 160 255 / 0.30), rgb(255 200 140 / 0.34),
        rgb(255 155 192 / 0.18), rgb(255 155 192 / 0.42));
      filter: blur(26px);
      /* visible at rest — the reference halo is ambient, not a focus-only
         effect — and fully lit when the caret lands */
      opacity: 0.58;
      pointer-events: none;
      transition: opacity 240ms var(--ease);
    }
    .in-throw:focus-within::before { opacity: 0.9; }
    .in-throw-surface {
      position: relative;
      display: grid; gap: 0.15rem;
      padding: 0.9rem 1rem 0.65rem;
      background: color-mix(in srgb, var(--deck) 78%, black);
      border: 1px solid rgb(236 230 217 / 14%);
      border-radius: var(--r-row);
    }
    .in-url { position: relative; display: block; min-width: 0; }
    .in-throw input {
      width: 100%; font: inherit; color: var(--bone); background: transparent; border: 0; padding: 0.3rem 0;
      font-family: var(--serif); font-size: var(--t-prose);
    }
    .in-url input { padding-right: 2.6rem; }
    .in-tab {
      position: absolute; right: 0; top: 50%; translate: 0 -50%;
      font-family: var(--mono); font-size: var(--t-xs); color: var(--dim);
      padding: 0.15rem 0.45rem; border: 1px solid rgb(236 230 217 / 16%); border-radius: var(--r-row);
      opacity: 0; transition: opacity var(--dur) var(--ease);
    }
    .in-url:focus-within .in-tab { opacity: 1; }
    .in-throw input::placeholder { color: var(--dim); opacity: 1; }
    .in-throw input:focus { outline: none; }
    .in-tools { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.35rem; }
    .in-tool {
      display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%;
      background: rgb(236 230 217 / 8%); color: var(--dim); font-size: 1.1rem; line-height: 1;
    }
    .in-tool-hint { margin-right: auto; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.06em; color: var(--dim); }
    .in-send {
      display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
      background: transparent; border: 0; color: var(--dim); cursor: pointer;
      transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
    }
    .in-throw:focus-within .in-send { color: var(--bone); }
    .in-send:hover { background: var(--hot); color: var(--void); }
    .in-send:disabled { opacity: 0.4; cursor: default; }
    .in-throw-note {
      margin: 0.55rem 0 0 0.25rem; min-height: 1.2em;
      font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.06em; color: var(--dim);
    }
    .in-throw-note a { color: var(--bone); }

    /* the words of a poem or a quote on a card: set, not summarised */
    .in-desc.is-verse { white-space: pre-line; font-family: var(--serif); font-size: var(--t-prose); line-height: 1.5; color: var(--bone); }

    .in-shelf {
      display: flex; flex-wrap: wrap; gap: 0.3rem var(--sp-2);
      margin: var(--sp-2) 0 0;
      font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.08em; color: var(--dim);
    }
    .in-shelf a { color: var(--bone); }

    .in-gate {
      max-width: 34rem;
      margin: var(--sp-3) auto;
      padding: var(--sp-2) var(--sp-2) var(--sp-2);
      background: var(--deck);
      border: 1px solid var(--hot);
      border-radius: var(--r-row);
      display: grid;
      gap: var(--sp-1);
    }
    .in-gate p { margin: 0; font-size: var(--t-md); color: var(--bone); }
    .in-gate label { display: grid; gap: 0.25rem; }
    .in-gate span { font-size: var(--t-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
    .in-gate input { font: inherit; color: var(--bone); background: transparent; border: 1px solid var(--rule); border-radius: var(--r-row); padding: 0.5rem 0.7rem; }
    .in-gate button { justify-self: start; font: inherit; font-size: var(--t-sm); cursor: pointer; color: var(--bone); background: transparent; border: 1px solid var(--hot); border-radius: 999px; padding: 0.5rem 1.1rem; }
    .in-gate-note { color: var(--dim); font-size: var(--t-sm); text-transform: none; letter-spacing: 0; }
    .in-gate-note a { color: var(--bone); text-decoration: underline 1px rgb(255 155 192 / 62%); text-underline-offset: 0.22em; }

    .in-stage {
      position: relative;
      max-width: 34rem;
      margin: var(--sp-3) auto 0;
      touch-action: pan-y;
      overflow-x: clip;
    }
    .in-card {
      position: relative;
      background: var(--deck);
      border: 1px solid var(--rule);
      border-radius: var(--r-panel);
      padding: var(--sp-tight) var(--sp-tight) var(--sp-tight);
      box-shadow: 0 22px 60px var(--shadow-deep);
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      will-change: transform;
    }
    .in-card.is-flying { transition: transform 240ms var(--ease-slick), opacity 220ms var(--ease); }
    .in-card.is-home { transition: transform 220ms var(--ease); }
    .in-card:active { cursor: grabbing; }
    .in-art { position: relative; display: flex; align-items: center; justify-content: center; min-height: min(38svh, 340px); }
    .in-art img.is-loading { opacity: 0.18; transition: opacity var(--dur) var(--ease); }
    .in-art-miss {
      position: absolute; inset: 0; display: grid; place-content: center; gap: var(--sp-2); text-align: center;
      padding: var(--sp-3); color: var(--dim); font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.06em;
    }
    .in-art-miss p { margin: 0; max-width: 28ch; line-height: 1.5; }
    .in-art-miss .in-btn { justify-self: center; }
    .in-art img {
      display: block; width: 100%;
      max-height: min(46svh, 460px);
      object-fit: contain;
      border-radius: var(--r-print);
      pointer-events: none;
    }
    /* a link is words, so its card is set in type, not framed as a picture */
    .in-read { display: grid; gap: var(--sp-1); padding: var(--sp-2) var(--sp-1) var(--sp-1); min-height: min(30svh, 260px); align-content: center; }
    .in-site { margin: 0; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
    .in-title { margin: 0; font-family: var(--serif); font-weight: 400; font-size: var(--t-lede); line-height: 1.25; color: var(--bone); }
    .in-desc { margin: 0; font-family: var(--serif); font-size: var(--t-prose-sm); line-height: 1.55; color: var(--quiet); }
    .in-tags { margin: 0.2rem 0 0; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.06em; color: var(--dim); }
    .in-tags i { font-style: normal; color: var(--hot); margin-right: 0.6em; }
    .in-credit { display: flex; flex-wrap: wrap; gap: 0.25rem 0.7rem; align-items: baseline; margin: var(--sp-tight) 0.15rem 0; font-size: var(--t-sm); }
    .in-credit b { color: var(--bone); font-weight: 500; }
    .in-credit span { color: var(--dim); }
    /* the one link on the card measured 42x21: a thumb needs 24 */
    .in-credit a { display: inline-flex; align-items: center; min-height: 24px; color: var(--dim); font-size: var(--t-xs); margin-left: auto; }
    .in-edge {
      position: absolute; top: 1.4rem;
      font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.14em; text-transform: uppercase;
      padding: 0.35rem 0.6rem; border-radius: var(--r-row); border: 1px solid; opacity: 0; pointer-events: none;
    }
    .in-edge--in { right: 1.4rem; color: var(--hot); border-color: var(--hot); transform: rotate(6deg); }
    .in-edge--out { left: 1.4rem; color: var(--dim); border-color: var(--dim); transform: rotate(-6deg); }
    .in-note { margin: var(--sp-2) 0 0; font-size: var(--t-md); line-height: 1.6; color: var(--dim); }
    .in-note a { color: var(--bone); }
    .in-note .in-kept { display: flex; gap: var(--sp-1); flex-wrap: wrap; margin-top: var(--sp-tight); }
    .in-note .in-kept img { width: 56px; height: 56px; object-fit: cover; border-radius: var(--r-print); }
    .in-note .in-kept i { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: var(--r-print); border: 1px solid var(--rule); font-style: normal; font-family: var(--mono); font-size: var(--t-xs); color: var(--quiet); }
    .in-do { display: flex; justify-content: center; gap: var(--sp-1); margin-top: var(--sp-2); }
    .in-btn {
      border: 1px solid var(--rule); background: transparent; color: var(--bone);
      border-radius: 999px; padding: 0.6rem 1.1rem; font-size: var(--t-sm); cursor: pointer;
      transition: border-color var(--dur) var(--ease), opacity var(--dur) var(--ease);
    }
    .in-btn kbd { font-family: var(--mono); font-size: var(--t-xs); color: var(--dim); }
    .in-btn--keep:hover { border-color: var(--hot); }
    .in-btn--pass:hover { border-color: var(--dim); }
    .in-btn--undo { color: var(--dim); }
    .in-btn--keys { padding-inline: 0.8rem; color: var(--dim); }
    .in-btn--keys:hover { border-color: var(--bone); }
    .in-keys {
      margin: auto; padding: var(--sp-2) var(--sp-3);
      width: min(100% - 2rem, 26rem);
      background: color-mix(in oklab, var(--deck) 88%, black);
      color: var(--bone); border: 1px solid var(--rule); border-radius: var(--r-panel);
      box-shadow: 0 22px 60px var(--shadow-deep);
    }
    .in-keys::backdrop { background: rgb(0 0 0 / 55%); backdrop-filter: blur(6px); }
    .in-keys h2 { margin: 0 0 var(--sp-2); font-family: var(--serif); font-weight: 400; font-size: var(--t-lede); }
    .in-keys dl { margin: 0; display: grid; gap: 0.45rem; }
    .in-keys dl div { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: var(--sp-tight); align-items: baseline; }
    .in-keys dt, .in-keys dd { margin: 0; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.04em; }
    .in-keys dd { color: var(--dim); }
    .in-keys kbd { display: inline-block; min-width: 1.4em; padding: 0.1em 0.4em; border: 1px solid var(--rule); border-radius: var(--r-print); text-align: center; color: var(--bone); }
    .in-keys form { margin-top: var(--sp-2); display: flex; justify-content: flex-end; }
    .in-btn:disabled { opacity: 0.35; cursor: default; }
    /* ── two leaves ─────────────────────────────────────────────────
       Wide, the card opens like a book: the thing on the left, him on the
       right. Narrow, the right leaf comes under. */
    .in-leaf--me { display: grid; gap: var(--sp-tight); padding: var(--sp-tight) var(--sp-hair) 0; }
    .in-say { display: grid; gap: var(--sp-hair); }
    .in-say-k { font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
    .in-say textarea {
      width: 100%; min-height: 7.5rem; resize: none;
      padding: 0.7rem 0.8rem;
      background: color-mix(in oklab, var(--deck) 70%, black);
      border: 1px solid var(--rule); border-radius: var(--r-row);
      color: var(--bone); font-family: var(--serif); font-size: var(--t-prose-sm); line-height: 1.5;
      transition: border-color var(--dur) var(--ease);
    }
    .in-say textarea::placeholder { color: var(--dim); }
    .in-say textarea:focus { outline: none; border-color: var(--hot); }
    .in-say-hint { margin: 0; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.06em; color: var(--dim); }
    .in-say-hint kbd { font-family: inherit; color: var(--bone); }
    .in-file { display: grid; gap: 0.3rem; margin: var(--sp-hair) 0 0; }
    .in-file div { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: var(--sp-tight); align-items: baseline; }
    .in-file dt { margin: 0; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }
    .in-file dd { margin: 0; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.04em; color: var(--bone); overflow-wrap: anywhere; }
    @media (min-width: 60rem) {
      .in-stage { max-width: 62rem; }
      .in-card { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--sp-2); align-items: start; }
      .in-leaf--me { padding: var(--sp-hair) var(--sp-hair) 0 0; align-self: stretch; grid-template-rows: auto 1fr auto auto; }
      .in-say { grid-row: 1 / 3; grid-template-rows: auto 1fr; }
      .in-say textarea { min-height: 100%; }
    }
    /* ── the ground ───────────────────────────────────────────────── */
    .in-ground {
      position: fixed; inset: 0; z-index: -1; pointer-events: none;
      background-repeat: repeat; background-position: center; background-size: 44vmin;
      filter: blur(14px) saturate(0.7) brightness(0.42);
      opacity: 0; transition: opacity 0.9s var(--ease);
    }
    .in-ground.is-lit { opacity: 1; }
    .in-count { margin-top: var(--sp-tight); text-align: center; font-family: var(--mono); font-size: var(--t-xs); letter-spacing: 0.08em; color: var(--dim); }
    @media (prefers-reduced-motion: reduce) {
      .in-ground { transition: none; }
      .in-card.is-flying, .in-card.is-home { transition: opacity 160ms var(--ease); }
      .in-throw::before, .in-send, .in-tab { transition: none; }
    }
    @media (max-width: 600px) {
      .in-tool-hint { display: none; }
    }
  </style>

  <script is:inline type="application/json" id="in-data" set:html={JSON.stringify(candidates)} />
  <script>
    import { prepareCandidateQueue } from "../../lib/eidos-candidates.mjs";

    (() => {
      const harvested = JSON.parse(document.getElementById("in-data").textContent);
      const $ = (id) => document.getElementById(id);
      const card = $("card"), art = $("art"), noteLine = $("note-line"), plateLoader = $("plate-loader");
      const edgeIn = document.querySelector(".in-edge--in");
      const edgeOut = document.querySelector(".in-edge--out");
      const trail = $("session-trail");
      let deck = [], cur = null, sat = 0, positiveThis = [], last = null, busy = false;
      let activeFilter = "all", comparisonPair = [], comparisonShown = false;
      const session = [];
      const filterTypes = {
        paintings: ["painting"],
        prints: ["print", "poster"],
        objects: ["object", "building"],
        photography: ["photograph"],
        people: ["person"],
      };
      const matchesFilter = (cand) => activeFilter === "all" || (filterTypes[activeFilter] || []).includes(cand.type);
      const playFeedback = (kind) => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const video = $(`feedback-${kind}`);
        if (!video) return;
        document.querySelectorAll("[data-studio-feedback] video").forEach((item) => { item.pause(); item.classList.remove("is-playing"); });
        video.currentTime = 0;
        video.classList.add("is-playing");
        video.play().catch(() => video.classList.remove("is-playing"));
      };
      document.querySelectorAll("[data-studio-feedback] video").forEach((video) => video.addEventListener("ended", () => video.classList.remove("is-playing")));
      const renderTrail = () => {
        trail.replaceChildren();
        const recent = session.slice(-5).reverse();
        if (!recent.length) { const li = document.createElement("li"); li.className = "is-empty"; li.textContent = "nothing judged yet"; trail.append(li); return; }
        recent.forEach((entry) => {
          const li = document.createElement("li");
          const mark = document.createElement("b"); mark.textContent = entry.verdict === "favorite" ? "✦" : entry.verdict === "keep" ? "+" : "−";
          const label = document.createElement("span"); label.textContent = entry.cand.title || entry.cand.who || entry.cand.type;
          li.append(mark, label); trail.append(li);
        });
      };
      const record = (cand, verdict) => { session.push({ cand, verdict }); renderTrail(); };

      const renderFilters = () => {
        document.querySelectorAll("[data-queue-filter]").forEach((button) => {
          const id = button.dataset.queueFilter;
          const types = filterTypes[id];
          const all = [...deck, ...(cur ? [cur] : [])];
          const total = id === "all" ? all.length : all.filter((cand) => types.includes(cand.type)).length;
          button.setAttribute("aria-pressed", String(id === activeFilter));
          const n = button.querySelector("b"); if (n) n.textContent = String(total);
        });
      };
      const count = () => {
        const all = [...deck, ...(cur ? [cur] : [])];
        const left = all.filter(matchesFilter).length;
        const suffix = activeFilter === "all" ? `${left} left` : `${left} here · ${all.length} total left`;
        $("count").textContent = all.length ? `${sat} judged${sat ? " today" : ""} · ${suffix}` : "";
        renderFilters();
      };

      // ── the visual deck ─────────────────────────────────────────────
      async function build() {
        let judged = new Set();
        try {
          const r = await fetch("/api/eidos/judged");
          if (r.ok) judged = new Set((await r.json()).judged || []);
        } catch {}
        // A daily shuffle prevents museum batches from becoming the
        // experience. The queue then deals in rounds: one work by every
        // available artist before a second by anyone. Alternate editions of
        // a work share all of their verdict ids, so judging one retires them
        // all without deleting any history.
        let seed = Number(new Date().toISOString().slice(0, 10).replace(/-/g, "")) % 2147483647;
        const rnd = () => (seed = (seed * 48271) % 2147483647) / 2147483647;
        const shuffled = harvested.slice().sort(() => rnd() - 0.5);
        deck = prepareCandidateQueue(shuffled, judged);
        if (!deck.length) return rest_("nothing visual waits. let the harvester bring more artists.");
        if (!(await doorOpen())) return shutOut(null);
        next();
      }
      $("art-retry").addEventListener("click", () => {
        if (!cur || !cur.src) return;
        $("art-miss").hidden = true;
        art.classList.add("is-loading");
        art.removeAttribute("src");
        art.src = cur.src + (cur.src.includes("?") ? "&" : "?") + "r=" + Date.now();
      });
      function prefetch() { const n = deck[0]; if (n && n.src) { const i = new Image(); i.src = n.src; } }
      function show(c) {
        $("c-source").hidden = false;
        // Clear the old picture before the new caption changes. The loader is
        // the registration of a new plate, never a mascot over the artwork.
        art.removeAttribute("src");
        art.classList.add("is-loading");
        plateLoader.hidden = false;
        $("art-miss").hidden = true;
        delete art.dataset.failed;
        art.src = c.src;
        art.alt = `${c.title}, ${c.who}`;
        $("c-title").textContent = c.title;
        $("c-who").textContent = `${c.who}${c.year ? " · " + c.year : ""}${c.type && c.type !== "painting" ? " · " + c.type : ""}`;
        $("c-source").href = c.source || "#";
      }
      function next() {
        const pick = activeFilter === "all" ? 0 : deck.findIndex(matchesFilter);
        cur = pick >= 0 ? deck.splice(pick, 1)[0] : null;
        if (!cur) return rest_(deck.length ? "nothing else waits on this shelf. choose another." : "that is all of the visual queue. let the harvester bring more.");
        art.onload = () => {
          const ratio = art.naturalWidth / art.naturalHeight;
          $("stage").dataset.orientation = ratio < 0.82 ? "portrait" : ratio > 1.22 ? "landscape" : "square";
          art.classList.remove("is-loading"); $("art-miss").hidden = true;
          plateLoader.hidden = true;
        };
        art.onerror = () => {
          if (!cur || !art.getAttribute("src")) return;
          art.classList.remove("is-loading");
          plateLoader.hidden = true;
          $("art-miss").hidden = false;
          $("art-miss").querySelector("p").textContent = `${cur.title} did not arrive from ${(() => { try { return new URL(cur.src, location.href).host.replace(/^www\./, ""); } catch { return "its source"; } })()}`;
        };
        show(cur);
        card.hidden = false;
        card.classList.remove("is-flying", "is-home", "is-favorite");
        card.style.transform = "";
        card.style.opacity = "";
        edgeIn.style.opacity = 0; edgeOut.style.opacity = 0;
        noteLine.hidden = true;
        busy = false;
        count();
        prefetch();
      }
      function rest_(text) {
        cur = null;
        card.hidden = true;
        $("do").hidden = true;
        noteLine.hidden = false;
        noteLine.textContent = "";
        const p = document.createElement("span");
        p.textContent = text || `that is all of them. ${positiveThis.length} kept; they appear in the library once they are taken in.`;
        noteLine.append(p);
        if (positiveThis.length) {
          const row = document.createElement("span");
          row.className = "in-kept";
          for (const k of positiveThis) {
            if (k.src) { const im = document.createElement("img"); im.src = k.src; im.alt = k.title; row.append(im); }
            else { const i = document.createElement("i"); i.textContent = (k.site || "link").slice(0, 10); i.title = k.title || k.url; row.append(i); }
          }
          noteLine.append(row);
        }
        count();
      }

      document.querySelectorAll("[data-queue-filter]").forEach((button) => button.addEventListener("click", () => {
        if (busy || button.dataset.queueFilter === activeFilter) return;
        if (cur) deck.unshift(cur);
        cur = null;
        activeFilter = button.dataset.queueFilter;
        $("do").hidden = false;
        next();
      }));

      // ── the verdicts, spoken to the server ───────────────────────────
      let gated = false;
      const pending = [];
      async function send(cand, verdict, weather) {
        try {
          const r = await fetch("/api/eidos/verdict", {
            method: "POST", headers: { "content-type": "application/json" },
            body: JSON.stringify({ id: cand.id, verdict, weather: weather || cand.weather || "" }),
          });
          if (r.status === 401) { shutOut({ cand, verdict, weather }); return false; }
          if (!r.ok) {
            noteLine.hidden = false;
            noteLine.textContent = `that one did not reach the vault (the server said ${r.status}). undo brings it back; try again in a moment.`;
          }
          return r.ok;
        } catch {
          noteLine.hidden = false;
          noteLine.textContent = "that one did not reach the vault. the connection, not you.";
          return false;
        }
      }
      function shutOut(unsaved) {
        if (unsaved) pending.push(unsaved);
        if (gated) return;
        gated = true;
        $("gate").hidden = false;
        $("workbench").hidden = true;
        $("do").hidden = true;
        $("stage").hidden = true;
        $("gate-note").textContent = pending.length
          ? `${pending.length} judgement${pending.length > 1 ? "s" : ""} waiting to be saved.` : "";
        $("gate").scrollIntoView({ block: "center", behavior: "instant" });
      }
      async function doorOpen() {
        try {
          const r = await fetch("/api/eidos/verdict", { method: "POST", headers: { "content-type": "application/json" }, body: "{}" });
          return r.status !== 401;
        } catch { return true; }
      }
      $("gate").addEventListener("submit", async (e) => {
        const field = e.target.querySelector('input[type="password"]');
        if (!field || !field.value.trim()) return;
        e.preventDefault();
        $("gate-note").textContent = "trying…";
        const body = new URLSearchParams({ password: field.value.trim() });
        let reached = true;
        try { const r = await fetch("/names", { method: "POST", body, redirect: "follow" }); reached = r.status < 500; } catch { reached = false; }
        if (!(await doorOpen())) {
          $("gate-note").textContent = reached ? "that is not it. the same password as /names." : "could not reach the door. check the connection and try again.";
          field.select(); return;
        }
        gated = false; field.value = "";
        $("gate").hidden = true; $("workbench").hidden = false; $("do").hidden = false; $("stage").hidden = false; $("gate-note").textContent = "";
        for (const u of pending.splice(0)) await send(u.cand, u.verdict, u.weather);
        if (!cur) build();
      });

      // ── the judgments ───────────────────────────────────────────────
      const comparison = $("comparison");
      const comparisonButtons = [...comparison.querySelectorAll("[data-comparison-choice]")];
      function maybeCompare() {
        if (comparisonShown || comparison.open) return;
        if (!(positiveThis.length >= 12)) return;
        const latest = positiveThis[positiveThis.length - 1];
        const earlier = positiveThis.slice(0, -1).reverse().find((cand) => cand.who !== latest.who) || positiveThis[0];
        if (!earlier || earlier.id === latest.id) return;
        comparisonPair = [earlier, latest];
        comparisonButtons.forEach((button, index) => {
          const cand = comparisonPair[index];
          const image = button.querySelector("img");
          image.src = cand.src; image.alt = cand.title || cand.who;
          button.querySelector("span").textContent = [cand.title, cand.who].filter(Boolean).join(" · ");
        });
        comparisonShown = true;
        comparison.showModal();
      }
      async function saveComparison(winner) {
        if (!winner || comparisonPair.length !== 2) return;
        await fetch("/api/eidos/pair", {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ weather: "overall", winner: winner.id, pair: comparisonPair.map((cand) => cand.id) }),
        }).catch(() => {});
        comparison.close();
      }
      comparisonButtons.forEach((button, index) => button.addEventListener("click", () => saveComparison(comparisonPair[index])));
      $("comparison-skip").addEventListener("click", () => comparison.close());
      comparison.addEventListener("click", (event) => { if (event.target === comparison) comparison.close(); });

      function fly(dir) {
        card.classList.add("is-flying");
        card.style.transform = `translateX(${dir * 120}vw) rotate(${dir * 16}deg)`;
        card.style.opacity = "0";
      }
      function pass() {
        if (!cur || busy) return;
        busy = true; const cand = cur; last = { cand, verdict: "pass" }; $("undo").disabled = false;
        record(cand, "pass");
        playFeedback("pass"); fly(-1); send(cand, "pass", ""); sat++; setTimeout(next, 240);
      }
      function keep() {
        if (!cur || busy) return;
        busy = true; const cand = cur; last = { cand, verdict: "keep" }; $("undo").disabled = false;
        positiveThis.push(cand); record(cand, "keep");
        playFeedback("keep"); send(cand, "keep", cand.weather); sat++; fly(1); setTimeout(() => { next(); maybeCompare(); }, 240);
      }
      function favorite() {
        if (!cur || busy) return;
        busy = true; const cand = cur; last = { cand, verdict: "favorite" }; $("undo").disabled = false;
        positiveThis.push(cand); record(cand, "favorite");
        card.classList.add("is-favorite");
        playFeedback("keep"); send(cand, "favorite", cand.weather); sat++;
        setTimeout(() => { fly(1); setTimeout(() => { next(); maybeCompare(); }, 220); }, 360);
      }
      function undo() {
        if (!last || busy) return;
        if (last.verdict === "keep" || last.verdict === "favorite") positiveThis = positiveThis.filter((k) => k.id !== last.cand.id);
        if (cur) deck.unshift(cur);
        deck.unshift(last.cand);
        session.pop(); renderTrail();
        sat = Math.max(0, sat - 1); last = null; $("undo").disabled = true; $("do").hidden = false; next();
      }
      function openSource() {
        const href = cur && (cur.url || cur.source);
        if (href && href !== "#") window.open(href, "_blank", "noopener,noreferrer");
      }
      $("undo").addEventListener("click", undo);
      $("pass").addEventListener("click", pass);
      $("keep").addEventListener("click", keep);
      $("favorite").addEventListener("click", favorite);
      const keys = $("keys");
      const toggleKeys = () => (keys.open ? keys.close() : keys.showModal());
      $("keys-open").addEventListener("click", toggleKeys);
      // a click on the backdrop, outside the sheet's own box, closes it
      keys.addEventListener("click", (e) => { if (e.target === keys) keys.close(); });
      // The rules every keyboard-first tool agrees on: single letters do
      // nothing while a field has focus; a held key does not fire twice; a
      // chord with alt or ctrl belongs to the browser, except undo's own.
      const KEYS = {
        ArrowRight: keep, l: keep,
        ArrowLeft: pass, h: pass,
        f: favorite,
        u: undo, z: undo,
        o: openSource, Enter: openSource,
        r: () => { if (cur && cur.src) $("art-retry").click(); },
        "?": toggleKeys,
      };
      document.addEventListener("keydown", (e) => {
        if (e.target && e.target.closest && e.target.closest("input,textarea,select")) return;
        if (keys.open) return; // the dialog answers esc itself; nothing else while it is up
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "z") { e.preventDefault(); undo(); return; }
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const act = KEYS[e.key];
        if (!act) return;
        if (e.repeat && act !== undo) return;
        e.preventDefault();
        act();
      });

      // ── the hand on the card ─────────────────────────────────────────
      let x0 = 0, dx = 0, dragging = false;
      const onDown = (e) => { if (!cur || busy || e.target.closest("a, button, textarea, label")) return; dragging = true; x0 = e.clientX; card.classList.remove("is-flying", "is-home"); card.setPointerCapture?.(e.pointerId); };
      const onMove = (e) => {
        if (!dragging) return;
        dx = e.clientX - x0;
        card.style.transform = `translateX(${dx}px) rotate(${dx / 22}deg)`;
        edgeIn.style.opacity = Math.min(1, Math.max(0, dx / 90));
        edgeOut.style.opacity = Math.min(1, Math.max(0, -dx / 90));
      };
      const onUp = () => {
        if (!dragging) return;
        dragging = false;
        if (dx > 110) keep();
        else if (dx < -110) pass();
        else { card.classList.add("is-home"); card.style.transform = ""; edgeIn.style.opacity = 0; edgeOut.style.opacity = 0; }
        dx = 0;
      };
      card.addEventListener("pointerdown", onDown);
      card.addEventListener("pointermove", onMove);
      card.addEventListener("pointerup", onUp);
      card.addEventListener("pointercancel", onUp);

      build();
    })();
  </script>
</EidosLayout>
