---
import Layout from "../../layouts/Layout.astro";
import inbox from "../../../public/inbox.json";

// The sitting. The map only grows if he judges what the harvester brings, so
// this page makes judging the easiest thing on the site: one painting at a
// time, huge, and one honest motion — right if it is his, left if it is not.
//
// Three decisions shaped it:
//
//   Seven is a sitting. An endless deck becomes a chore and chores get
//   avoided; seven cards is under a minute and leaves him wanting one more,
//   which is the correct amount of wanting.
//
//   Confirm, don't choose. The harvester already filed each candidate under
//   a weather. "filed under cold clarity — rightly?" is one tap; a list of
//   eight is a form. The correction, when he makes one, is the best signal
//   the map ever gets.
//
//   Verdicts are server truth. eidos:verdicts in KV, behind the /names door
//   he already holds. The deck reads what is judged and shrinks; two devices
//   never show him the same card twice.

const candidates = (inbox.candidates || []).map((c) => ({
  id: c.id,
  who: c.who || "",
  title: c.title || "",
  year: c.year || "",
  weather: c.weather || "",
  src: c.src,
  source: c.source || "",
  licence: c.licence || "",
}));

const WEATHERS = [
  "cold clarity", "dissolution", "invincible summer", "nerve",
  "the dark and the lamp", "the plain thing", "vastness", "weight and grace",
];

const title = "the sitting · dmytro klochko";
const description = "one painting at a time. his, or not his.";
---

<Layout title={title} description={description} current="home" scenes={["nightcourt"]} unlisted>
  <section class="shell session eidos-sit" data-scene="nightcourt" aria-labelledby="es">
    <div class="card">
      <h1 class="card-title" id="es">the sitting</h1>
    </div>

    <p class="today-how" id="sit-lede">
      the harvester brings candidates; the map only grows when they are
      judged. right if it is yours, left if it is not. seven is a sitting.
    </p>

    {/* A real form, posting to the real door, so it works with no script at
        all: the worker sets the cookie and sends you back here. The fetch
        below is only an enhancement that saves the round trip. */}
    <form class="sit-gate" id="gate" method="POST" action="/names" hidden>
      <input type="hidden" name="next" value="/eidos/sit" />
      <p>the sitting writes to the vault, so it needs the door first.</p>
      <label>
        <span>password</span>
        <input type="password" name="password" autocomplete="current-password"
               autocapitalize="none" autocorrect="off" spellcheck="false" required />
      </label>
      <button type="submit">come in</button>
      <span class="sit-gate-note" id="gate-note"></span>
      <span class="sit-gate-note">
        or <a href="/names" target="_blank" rel="noreferrer">open the door in a tab</a> and reload this page.
      </span>
    </form>

    <div class="sit-stage" id="stage">
      <article class="sit-card" id="card" hidden>
        <div class="sit-art"><img id="art" alt="" decoding="async" /></div>
        <p class="sit-credit">
          <b id="c-title"></b>
          <span id="c-who"></span>
          <a id="c-source" href="#" target="_blank" rel="noreferrer">source ↗</a>
        </p>
        <span class="sit-edge sit-edge--in" aria-hidden="true">mine</span>
        <span class="sit-edge sit-edge--out" aria-hidden="true">not mine</span>
      </article>


      <p class="sit-note" id="note" hidden></p>
    </div>

    <div class="sit-do" id="do">
      <button type="button" id="pass" class="sit-btn sit-btn--pass">not mine <kbd>←</kbd></button>
      <button type="button" id="undo" class="sit-btn sit-btn--undo" disabled>undo</button>
      <button type="button" id="keep" class="sit-btn sit-btn--keep"><kbd>→</kbd> mine</button>
    </div>

    <p class="sit-count" id="count"></p>

    <a class="onward onward--back" href="/eidos">
      <span class="arw" aria-hidden="true">↖</span><span>back to the map</span>
    </a>
  </section>

  <style>
    /* A display rule in author css beats the user agent's [hidden] { display:
       none }, so every element here that sets display — the gate is a grid,
       the buttons are a flex row — went on showing after hidden was set. The
       door appeared to do nothing because it was hiding a gate that could
       not be hidden. */
    [hidden] { display: none !important; }

    .sit-stage {
      position: relative;
      max-width: 34rem;
      margin: 0 auto;
      touch-action: pan-y;
      /* the card flies to 120vw; clip that sideways, but let the weather
         question still spill downward (clip, not hidden, keeps y visible) */
      overflow-x: clip;
    }

    /* The picture reserves its own height so the deck does not jump between
       a portrait and a landscape, and so nothing reserves a screen of empty
       dark when no card is up. */
    .sit-art {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: min(38svh, 340px);
    }

    .sit-card {
      position: relative;
      background: var(--deck);
      border: 1px solid var(--rule);
      border-radius: 12px;
      padding: 0.9rem 0.9rem 0.8rem;
      box-shadow: 0 22px 60px rgb(6 9 18 / 45%);   /* shadow-deep */
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      will-change: transform;
    }
    .sit-card.is-flying { transition: transform 0.42s var(--ease-slick), opacity 0.42s var(--ease-slick); }
    .sit-card.is-home { transition: transform 0.45s var(--ease); }
    .sit-card:active { cursor: grabbing; }

    .sit-art img {
      display: block;
      width: 100%;
      max-height: min(46svh, 460px);
      object-fit: contain;
      border-radius: 6px;
      pointer-events: none;
      transition: max-height 0.3s var(--ease);
    }


    .sit-credit {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.7rem;
      align-items: baseline;
      margin: 0.7rem 0.15rem 0;
      font-size: 0.875rem;   /* t-sm */
    }
    .sit-credit b { color: var(--bone); font-weight: 500; }
    .sit-credit span { color: var(--dim); }
    .sit-credit a { color: var(--dim); font-size: 0.75rem; margin-left: auto; }

    .sit-edge {
      position: absolute;
      top: 1.4rem;
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 0.78rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
      border: 1px solid;
      opacity: 0;
      pointer-events: none;
    }
    .sit-edge--in { right: 1.4rem; color: var(--hot); border-color: var(--hot); transform: rotate(6deg); }
    .sit-edge--out { left: 1.4rem; color: var(--dim); border-color: var(--dim); transform: rotate(-6deg); }

    /* Asked once, up front. It used to fail silently on every keep and put
       the card back at the front of the deck, so the same painting came
       round seven times and nothing was saved. */
    .sit-gate {
      max-width: 34rem;
      margin: 0 auto var(--sp-3);
      padding: 0.9rem 1rem 1rem;
      background: var(--deck);
      border: 1px solid var(--hot);
      border-radius: 10px;
      display: grid;
      gap: 0.6rem;
    }
    .sit-gate p { margin: 0; font-size: 0.98rem; color: var(--bone); }
    .sit-gate label { display: grid; gap: 0.25rem; }
    .sit-gate span { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
    .sit-gate input {
      font: inherit; color: var(--bone); background: transparent;
      border: 1px solid var(--rule); border-radius: 8px; padding: 0.5rem 0.7rem;
    }
    .sit-gate button {
      justify-self: start; font: inherit; font-size: 0.875rem; cursor: pointer;
      color: var(--bone); background: transparent;
      border: 1px solid var(--hot); border-radius: 999px; padding: 0.5rem 1.1rem;
    }
    .sit-gate-note { color: var(--dim); font-size: 0.8rem; }

    .sit-note {
      margin: 1rem 0 0;
      font-size: 0.98rem;
      line-height: 1.6;
      color: var(--dim);
    }
    .sit-note a { color: var(--bone); }
    .sit-note .sit-kept { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.8rem; }
    .sit-note .sit-kept img { width: 56px; height: 56px; object-fit: cover; border-radius: 4px; }

    .sit-do {
      display: flex;
      justify-content: center;
      gap: 0.6rem;
      margin-top: 1.1rem;
    }
    .sit-btn {
      border: 1px solid var(--rule);
      background: transparent;
      color: var(--bone);
      border-radius: 999px;
      padding: 0.6rem 1.1rem;
      font-size: 0.875rem;
      cursor: pointer;
      transition: border-color var(--dur) var(--ease), opacity var(--dur) var(--ease);
    }
    .sit-btn kbd {
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 0.72rem;
      color: var(--dim);
    }
    .sit-btn--keep:hover { border-color: var(--hot); }
    .sit-btn--pass:hover { border-color: var(--dim); }
    .sit-btn--undo { color: var(--dim); }
    .sit-btn:disabled { opacity: 0.35; cursor: default; }

    .sit-count {
      margin-top: 0.8rem;
      text-align: center;
      font-family: var(--mono, ui-monospace, monospace);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--dim);
    }

    @media (prefers-reduced-motion: reduce) {
      .sit-card.is-flying, .sit-card.is-home { transition: opacity 0.3s ease; }
    }
  </style>

  <script is:inline type="application/json" id="sit-data" set:html={JSON.stringify(candidates)} />

  <script>
    (() => {
      const all = JSON.parse(document.getElementById("sit-data").textContent);
      const $ = (id) => document.getElementById(id);
      const card = $("card"), art = $("art"), note = $("note");
      const SITTING = 7;

      const edgeIn = document.querySelector(".sit-edge--in");
      const edgeOut = document.querySelector(".sit-edge--out");
      let deck = [], cur = null, sat = 0, keptThis = [];
      let last = null;               // { cand, verdict } for undo
      let busy = false;

      const count = () => {
        $("count").textContent = deck.length || cur
          ? `${Math.min(sat + 1, SITTING)} of ${SITTING} · ${deck.length + (cur ? 1 : 0)} wait in all`
          : "";
      };

      // ── the deck: everything the server has not seen judged ────────────
      async function build() {
        // The endpoint answers { judged: [id, ...] }. This asked it for
        // `verdicts` and got undefined, so the filter matched nothing and the
        // whole deck came back every time — ten judgements safe in KV and the
        // Magpie on top of the pile again, looking exactly like lost work.
        let judged = new Set();
        try {
          const r = await fetch("/api/eidos/judged");
          if (r.ok) judged = new Set((await r.json()).judged || []);
        } catch {}
        deck = all.filter((c) => !judged.has(c.id));
        // remote images later in the deck than local ones, so the first
        // card is always instant
        deck.sort((a, b) => (a.src.startsWith("/") ? 0 : 1) - (b.src.startsWith("/") ? 0 : 1));
        if (!deck.length) return rest("nothing waits. every candidate has been judged; the harvester will bring more.");
        if (!(await doorOpen())) return shutOut(null);   // no card behind a shut door
        next();
      }

      function prefetch() {
        if (deck[0]) { const i = new Image(); i.src = deck[0].src; }
      }

      function next() {
        if (sat >= SITTING) return rest();
        cur = deck.shift() || null;
        if (!cur) return rest("the deck is empty. the harvester will bring more.");
        art.onerror = () => {
          // a dead url is not a judgement: drop it and deal the next one
          if (!cur || art.dataset.failed === cur.id) return;
          art.dataset.failed = cur.id;
          note.hidden = false;
          note.textContent = `${cur.title} would not load, so it is skipped.`;
          next();
        };
        art.src = cur.src;
        art.alt = `${cur.title}, ${cur.who}`;
        $("c-title").textContent = cur.title;
        $("c-who").textContent = `${cur.who}${cur.year ? " · " + cur.year : ""}`;
        $("c-source").href = cur.source || "#";
        card.hidden = false;
        card.classList.remove("is-flying", "is-home");
        card.style.transform = "";
        edgeIn.style.opacity = 0;
        edgeOut.style.opacity = 0;
        card.style.opacity = "";
        note.hidden = true;
        busy = false;
        count();
        prefetch();
      }

      function rest(text) {
        cur = null;
        card.hidden = true;
        $("do").hidden = true;
        note.hidden = false;
        note.textContent = "";
        const p = document.createElement("span");
        p.textContent = text || `a sitting is seven, and this one is done. ${keptThis.length} joined the inbox of the vault; they appear on the map once they are taken in.`;
        note.append(p);
        if (keptThis.length) {
          const row = document.createElement("span");
          row.className = "sit-kept";
          for (const k of keptThis) {
            const im = document.createElement("img");
            im.src = k.src; im.alt = k.title;
            row.append(im);
          }
          note.append(row);
        }
        if (!text && deck.length) {
          const more = document.createElement("a");
          more.href = "#";
          more.textContent = ` one more sitting (${deck.length} wait) →`;
          more.addEventListener("click", (e) => {
            e.preventDefault();
            sat = 0; keptThis = [];
            $("do").hidden = false;
            next();
          });
          note.append(document.createTextNode(" "), more);
        }
        count();
      }

      // ── the verdicts, spoken to the server ─────────────────────────────
      // A verdict either lands or it does not. When the door is shut it used
      // to put the card back at the front of the deck and say so in small
      // grey text, which produced the same painting seven times in a row and
      // saved none of them. Now the sitting stops, keeps what is unsaved,
      // and asks for the door.
      let gated = false;
      const pending = [];

      async function send(cand, verdict, weather) {
        try {
          const r = await fetch("/api/eidos/verdict", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ id: cand.id, verdict, weather: weather || cand.weather }),
          });
          if (r.status === 401) { shutOut({ cand, verdict, weather }); return false; }
          return r.ok;
        } catch {
          note.hidden = false;
          note.textContent = "that one did not reach the vault. the connection, not you.";
          return false;
        }
      }

      function shutOut(unsaved) {
        if (unsaved) pending.push(unsaved);
        if (gated) return;
        gated = true;
        $("gate").hidden = false;
        $("do").hidden = true;
        $("stage").hidden = true;      // the deck waits out of sight
        $("gate-note").textContent = pending.length
          ? `${pending.length} judgement${pending.length > 1 ? "s" : ""} waiting to be saved.`
          : "";
        $("gate").scrollIntoView({ block: "center", behavior: "instant" });
      }

      // The door is asked before the first card, not discovered on the first
      // keep. An empty body is a 400 when the cookie is good and a 401 when
      // it is not, so the check costs nothing and writes nothing.
      async function doorOpen() {
        try {
          const r = await fetch("/api/eidos/verdict", {
            method: "POST", headers: { "content-type": "application/json" }, body: "{}",
          });
          return r.status !== 401;
        } catch { return true; }   // offline is not a locked door; let him judge
      }

      $("gate").addEventListener("submit", async (e) => {
        const field = e.target.querySelector('input[type="password"]');
        if (!field || !field.value.trim()) return;    // let the browser complain
        e.preventDefault();
        $("gate-note").textContent = "trying…";
        const body = new URLSearchParams({ password: field.value.trim() });
        let reached = true;
        try {
          const r = await fetch("/names", { method: "POST", body, redirect: "follow" });
          reached = r.status < 500;
        } catch { reached = false; }
        if (!(await doorOpen())) {
          $("gate-note").textContent = reached
            ? "that is not it. the same password as /names."
            : "could not reach the door. check the connection and try again.";
          field.select();
          return;
        }
        // in, and everything that was waiting goes now
        gated = false;
        field.value = "";
        $("gate").hidden = true;
        $("do").hidden = false;
        $("stage").hidden = false;
        $("gate-note").textContent = "";
        for (const u of pending.splice(0)) await send(u.cand, u.verdict, u.weather);
        if (!cur) next();
      });

      function fly(dir) {
        card.classList.add("is-flying");
        card.style.transform = `translateX(${dir * 120}vw) rotate(${dir * 16}deg)`;
        card.style.opacity = "0";
      }

      function pass() {
        if (!cur || busy) return;
        busy = true;
        const cand = cur;
        last = { cand, verdict: "pass" };
        $("undo").disabled = false;
        fly(-1);
        send(cand, "pass");
        sat++;
        setTimeout(next, 300);
      }

      function keep() {
        if (!cur || busy) return;
        busy = true;
        const cand = cur;
        last = { cand, verdict: "keep" };
        $("undo").disabled = false;
        keptThis.push(cand);
        // The harvester already proposed a weather and he kept the painting
        // anyway, which is answer enough. Asking him to confirm it turned a
        // half-second judgement into a form.
        send(cand, "keep", cand.weather);
        sat++;
        fly(1);
        setTimeout(next, 300);
      }


      $("undo").addEventListener("click", () => {
        if (!last) return;
        // the server keys verdicts by id, so judging again simply overwrites
        if (last.verdict === "keep") keptThis = keptThis.filter((k) => k.id !== last.cand.id);
        deck.unshift(last.cand);
        sat = Math.max(0, sat - 1);
        last = null;
        $("undo").disabled = true;
        $("do").hidden = false;
        next();
      });

      $("pass").addEventListener("click", pass);
      $("keep").addEventListener("click", keep);
      document.addEventListener("keydown", (e) => {
        if (e.target && e.target.closest && e.target.closest("input,textarea,select")) return;
        if (e.key === "ArrowLeft") pass();
        if (e.key === "ArrowRight") keep();
      });

      // ── the hand on the card ────────────────────────────────────────────
      let dragging = false, sx = 0, dx = 0;
      card.addEventListener("pointerdown", (e) => {
        if (busy) return;
        dragging = true; sx = e.clientX; dx = 0;
        card.classList.remove("is-home");
        card.setPointerCapture(e.pointerId);
      });
      card.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        dx = e.clientX - sx;
        card.style.transform = `translateX(${dx}px) rotate(${dx * 0.05}deg)`;
        edgeIn.style.opacity = Math.min(1, Math.max(0, dx / 110));
        edgeOut.style.opacity = Math.min(1, Math.max(0, -dx / 110));
      });
      const release = () => {
        if (!dragging) return;
        dragging = false;
        edgeIn.style.opacity = 0;
        edgeOut.style.opacity = 0;
        if (dx > 110) keep();
        else if (dx < -110) pass();
        else {
          card.classList.add("is-home");
          card.style.transform = "";
        }
        dx = 0;
      };
      card.addEventListener("pointerup", release);
      card.addEventListener("pointercancel", release);

      build();
    })();
  </script>
</Layout>
