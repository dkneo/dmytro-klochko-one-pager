---
import Layout from "../../layouts/Layout.astro";
import map from "../../data/map.json";
import palettes from "../../data/palettes.json";
import inbox from "../../../public/inbox.json";

// The library. Everything he loves, filed by feeling.
//
// The weathers are the architecture: eight rooms, running cold to warm,
// because "invincible summer" and "the dark and the lamp" are the only
// taxonomy this collection has ever held. Inside a room nothing is grouped
// by kind — a painting hangs beside the song that feels the same, which is
// the point of the whole exercise.
//
// Three rules, inherited from the map and kept:
//
//   Every mark is a real thing: the paintings are their own images, the
//   poems their own words, every one attributed.
//
//   The library shows what it does not know. Marks with no weather close
//   the page as "the ring", dimmer, waiting.
//
//   Reading is public; teaching is his. The sitting, the sketch's placing
//   tools — those are doors. This page only asks you to look.

const { items, weathers, depth, forms, unplaced } = map;
const candidates = (inbox.candidates || []).length;

const FORM_MARK = { painting: "▣", object: "◈", building: "⌂", poem: "❞", song: "♪", quote: "“", link: "↗", person: "◉", writing: "¶" };
const thumbFor = (src: string) => src
  .replace("/images/", "/images/thumbs/")
  .replace(/\.[^.]+$/, ".webp");

// Art hangs; words are read. A quote squeezed into a square tile is mostly
// empty space wearing a border, and next to a real painting the boxes read
// as placeholders. So each room has a wall and a column, and each kind gets
// the shape it wants.
const HANGS = new Set(["painting", "object", "building", "person"]);

// The links are all craft articles — Emil Kowalski on animation, ThreeUI.
// That is study, not taste, and /learning already keeps them properly.
const shelved = items.filter((it) => it.type !== "link");

const rooms = weathers.slice().sort((a, b) => a.x - b.x).map((w) => {
  const marks = shelved.filter((it) => it.weather === w.name);
  return {
    ...w,
    slug: w.name.replace(/\W+/g, "-"),
    art: marks.filter((it) => HANGS.has(it.type)),
    words: marks.filter((it) => !HANGS.has(it.type)),
    n: marks.length,
    stops: (palettes.palettes.find((p) => p.weather === w.name) || {}).stops || [],
  };
});
const ringMarks = shelved.filter((it) => !it.weather || it.unplaced);
const ring = {
  art: ringMarks.filter((it) => HANGS.has(it.type)),
  words: ringMarks.filter((it) => !HANGS.has(it.type)),
  n: ringMarks.length,
};
const links = items.filter((it) => it.type === "link").length;

// Every number on this page is counted from what the page actually shows.
// depth.notes counts the whole vault, and quoting it here while shelving
// eleven fewer marks made the library overstate itself by exactly the
// number of things it had just sent to /learning.
const shelvedCount = shelved.length;
const namesHere = new Set(shelved.map((it) => it.who).filter(Boolean)).size;

const title = "eidos · dmytro klochko";
const description =
  "the library of what dmytro klochko loves: paintings, poems, songs, people and lines, filed by feeling rather than by kind.";
---

<Layout title={title} description={description} current="home" scenes={["nightcourt"]}>
  <section class="shell session eidos-lib" data-scene="nightcourt" aria-labelledby="el">
    <div class="card">
      <h1 class="card-title" id="el">eidos</h1>
    </div>

    <p class="today-how">
      <em>eidos</em>, the greek for the form of a thing, the shape you know it
      by. this is the library of what i love — {shelvedCount} real things,
      every one attributed — filed under eight weathers i made up, because
      feeling is the only filing system that has ever held. it runs cold to
      warm.
    </p>

    <dl class="lib-counts" aria-label="what the library holds">
      <div><dt>marks</dt><dd>{shelvedCount}</dd></div>
      <div><dt>makers</dt><dd>{namesHere}</dd></div>
      <div><dt>weathers</dt><dd>{weathers.length}</dd></div>
      <div class="is-open"><dt>on the ring</dt><dd>{ring.n}</dd></div>
    </dl>

    {/* ── ways of looking, and the door ───────────────────────────── */}
    <p class="lib-views">
      other ways to look: <a href="/eidos/map">the sketch</a> ·{" "}
      <a href="/eidos/orbit">the orbit</a> · and the library grows by{" "}
      <a href="/eidos/sit">sittings</a>, {candidates} waiting.
    </p>

    {/* ── filters, shared across every room ───────────────────────── */}
    <div class="em-controls" role="group" aria-label="filter the library">
      <button class="em-chip is-on" data-filter="all" type="button">everything</button>
      {forms.filter((f) => f.n && f.form !== "link").map((f) => (
        <button class="em-chip" data-filter={f.form} type="button">
          <i aria-hidden="true">{FORM_MARK[f.form]}</i>{f.form}s<b>{f.n}</b>
        </button>
      ))}
    </div>

    {/* ── room index ──────────────────────────────────────────────── */}
    <nav class="lib-toc" aria-label="the rooms">
      {rooms.map((r) => <a href={`#w-${r.slug}`}>{r.name}</a>)}
      <a href="#the-ring" class="lib-toc-ring">the ring</a>
    </nav>

    {/* ── the rooms ───────────────────────────────────────────────── */}
    {rooms.map((r) => (
      <section class="lib-room" id={`w-${r.slug}`} aria-label={r.name}>
        <header class="lib-door">
          <span class="lib-chips" aria-hidden="true">
            {r.stops.map((c) => <i style={`background:${c}`} />)}
          </span>
          <h2>{r.name}</h2>
          <p>{r.why} <span class="lib-n">· {r.n} mark{r.n === 1 ? "" : "s"}</span></p>
        </header>

        <div class={`lib-body${r.art.length > 4 ? " lib-body--wide" : ""}`}>
        {r.art.length > 0 && (
          <div class="lib-wall">
            {r.art.map((it) => (
              <button class={`lib-card lib-card--${it.type}`} type="button"
                      data-id={it.id} data-form={it.type}
                      aria-label={`${it.type}: ${it.line || it.title}${it.who ? " by " + it.who : ""}`}>
                <img src={thumbFor(it.src)} alt="" width="320" height="320" loading="lazy" decoding="async" />
                <span class="lib-cap">{it.who || it.title}</span>
              </button>
            ))}
          </div>
        )}

        {r.words.length > 0 && (
          <ul class="lib-words">
            {r.words.map((it) => (
              <li>
                <button class={`lib-said lib-said--${it.type}`} type="button"
                        data-id={it.id} data-form={it.type}
                        aria-label={`${it.type}: ${it.line || it.title}${it.who ? " by " + it.who : ""}`}>
                  <span class="lib-mark" aria-hidden="true">{FORM_MARK[it.type]}</span>
                  <span class="lib-line">{it.line || it.title}</span>
                  <span class="lib-by">{it.who}{it.year ? " · " + it.year : ""}</span>
                </button>
              </li>
            ))}
          </ul>
        )}
        </div>
      </section>
    ))}

    {/* ── the ring: filed nowhere yet ─────────────────────────────── */}
    {ring.n > 0 && (
      <section class="lib-room lib-room--ring" id="the-ring" aria-label="the ring">
        <header class="lib-door">
          <h2>the ring</h2>
          <p>
            {ring.n} marks that have never been told how they feel. they join
            a room when a <a href="/eidos/sit">sitting</a> or{" "}
            <a href="/eidos/map">the sketch</a> files them.
          </p>
        </header>

        <div class={`lib-body${ring.art.length > 4 ? " lib-body--wide" : ""}`}>
        {ring.art.length > 0 && (
          <div class="lib-wall">
            {ring.art.map((it) => (
              <button class={`lib-card lib-card--${it.type}`} type="button"
                      data-id={it.id} data-form={it.type}
                      aria-label={`${it.type}: ${it.line || it.title}${it.who ? " by " + it.who : ""}`}>
                <img src={thumbFor(it.src)} alt="" width="320" height="320" loading="lazy" decoding="async" />
                <span class="lib-cap">{it.who || it.title}</span>
              </button>
            ))}
          </div>
        )}

        {ring.words.length > 0 && (
          <ul class="lib-words">
            {ring.words.map((it) => (
              <li>
                <button class={`lib-said lib-said--${it.type}`} type="button"
                        data-id={it.id} data-form={it.type}
                        aria-label={`${it.type}: ${it.line || it.title}${it.who ? " by " + it.who : ""}`}>
                  <span class="lib-mark" aria-hidden="true">{FORM_MARK[it.type]}</span>
                  <span class="lib-line">{it.line || it.title}</span>
                  <span class="lib-by">{it.who}{it.year ? " · " + it.year : ""}</span>
                </button>
              </li>
            ))}
          </ul>
        )}
        </div>
      </section>
    )}

    <p class="lib-elsewhere">
      {links} craft links are kept on <a href="/learning">learning</a>, where
      they are read. this is the taste library; study lives next door.
    </p>

    {/* ── what a card says when it is pressed ─────────────────────── */}
    <aside class="em-detail lib-detail" id="detail" hidden aria-live="polite">
      <button class="em-close" type="button" aria-label="close">close</button>
      <div class="em-detail-body"></div>
    </aside>

    <a class="onward onward--back" href="/">
      <span class="arw" aria-hidden="true">↖</span><span>back to the main page</span>
    </a>
  </section>

  <script is:inline type="application/json" id="lib-data"
          set:html={JSON.stringify(items.map(({ id, type, weather, line, title, who, year, where, note, src, url, source }) =>
            ({ id, type, weather, line, title, who, year, where, note, src, url, source })))} />

  <script>
    (() => {
      const items = JSON.parse(document.getElementById("lib-data").textContent);
      const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

      // ── filtering: a room with nothing to show folds away ──────────
      const chips = [...document.querySelectorAll(".em-chip")];
      chips.forEach((c) => c.addEventListener("click", () => {
        chips.forEach((x) => x.classList.toggle("is-on", x === c));
        const f = c.dataset.filter;
        for (const el of document.querySelectorAll(".lib-card, .lib-said")) {
          const item = el.closest("li") || el;
          item.hidden = f !== "all" && el.dataset.form !== f;
        }
        // a wall or a column with nothing left in it folds, and so does a
        // room that has neither
        for (const group of document.querySelectorAll(".lib-wall, .lib-words")) {
          group.hidden = ![...group.querySelectorAll(".lib-card, .lib-said")]
            .some((x) => !(x.closest("li") || x).hidden);
        }
        for (const room of document.querySelectorAll(".lib-room")) {
          room.hidden = ![...room.querySelectorAll(".lib-wall, .lib-words")].some((g) => !g.hidden);
        }
      }));

      // ── a card, pressed ─────────────────────────────────────────────
      const detail = document.getElementById("detail");
      const body = detail.querySelector(".em-detail-body");
      document.querySelectorAll(".lib-card, .lib-said").forEach((card) => card.addEventListener("click", () => {
        const it = items.find((x) => x.id === card.dataset.id);
        if (!it) return;
        body.innerHTML =
          (it.src ? `<img src="${esc(it.src)}" alt="">` : "") +
          `<p class="em-d-kind">${esc(it.type)}${it.weather ? " · " + esc(it.weather) : " · on the ring"}</p>` +
          `<p class="em-d-line">${esc(it.line || it.title)}</p>` +
          (it.who ? `<p class="em-d-who">${esc(it.who)}${it.year ? ", " + esc(it.year) : ""}${it.where ? " · " + esc(it.where) : ""}</p>` : "") +
          (it.note ? `<p class="em-d-note">${esc(it.note)}</p>` : "") +
          ((it.url || it.source) ? `<p class="em-d-go"><a href="${esc(it.url || it.source)}" target="_blank" rel="noreferrer">${it.url ? "open it" : "source"}<span class="arw">↗</span></a></p>` : "");
        detail.hidden = false;
      }));
      detail.querySelector(".em-close").onclick = () => { detail.hidden = true; };
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") detail.hidden = true; });
    })();
  </script>
</Layout>
