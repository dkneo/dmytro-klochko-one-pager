---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import path from "node:path";
import sharp from "sharp";
import EidosLayout from "../../layouts/EidosLayout.astro";
import EidosHeader from "../../components/eidos/EidosHeader.astro";
import EidosHero from "../../components/eidos/EidosHero.astro";
import EidosMoodboard from "../../components/eidos/EidosMoodboard.astro";
import { buildProfile } from "../../lib/eidos-view.mjs";
import map from "../../data/map.json";
import palettes from "../../data/palettes.json";

const profile = buildProfile(map, palettes);
const visuals = profile.collection.filter((item: any) => item.src);
const plateFor = (src: string) => src.replace("/images/", "/images/plates/").replace(/\.[^.]+$/, ".webp");
const dimensions: Record<string, { width: number; height: number }> = {};
const dominantColors: Record<string, { hex: string; key: number }> = {};
const hueKey = (red: number, green: number, blue: number) => {
  const [r, g, b] = [red, green, blue].map((value) => value / 255);
  const max = Math.max(r, g, b), min = Math.min(r, g, b);
  const lightness = (max + min) / 2;
  const delta = max - min;
  if (delta < 0.08) return 720 + Math.round(lightness * 100);
  let hue = max === r ? ((g - b) / delta) % 6 : max === g ? (b - r) / delta + 2 : (r - g) / delta + 4;
  hue = Math.round(hue * 60); if (hue < 0) hue += 360;
  return hue;
};
for (const item of visuals) {
  try {
    const image = sharp(path.join(process.cwd(), "public", plateFor(item.src)));
    const [metadata, stats] = await Promise.all([
      image.metadata(),
      image.clone().resize({ width: 64, height: 64, fit: "inside" }).stats(),
    ]);
    if (metadata.width && metadata.height) dimensions[item.id] = { width: metadata.width, height: metadata.height };
    const { r, g, b } = stats.dominant;
    dominantColors[item.id] = {
      hex: `#${[r, g, b].map((value) => value.toString(16).padStart(2, "0")).join("")}`,
      key: hueKey(r, g, b),
    };
  } catch {}
}

const title = "eidos · dmytro's endless moodboard";
const description = "a living moodboard of paintings, photographs, people and objects loved by dmytro klochko.";
const ogVersion = createHash("sha1")
  .update(readFileSync(path.join(process.cwd(), "public", "og-eidos.png")))
  .digest("hex")
  .slice(0, 10);
---

<EidosLayout title={title} description={description} ogImage={`/og-eidos.png?v=${ogVersion}`}>
  <div class="eidos-product">
    <EidosHeader current="moodboard" />
    <EidosHero />
    <EidosMoodboard items={visuals} dimensions={dimensions} colors={dominantColors} />

    <section class="ep-make-yours" aria-labelledby="make-yours-title">
      <div>
        <h2 id="make-yours-title">this is mine. yours would look different.</h2>
        <p>
          keep what stops you. leave what does not. over time, your own moodboard
          becomes a portrait without needing to explain you.
        </p>
        <a class="ep-action ep-action--solid" href="/eidos/deck">play with paintings</a>
      </div>
      <img src="/images/eidos/product/card-back.webp" width="1400" height="1750" alt="Faun and Gryphon waiting beneath an open pink circle" loading="lazy" decoding="async" />
    </section>

    <footer class="ep-footer">
      <a href="/">dmytro klochko <span aria-hidden="true">↗</span></a>
      <a href="/eidos/words">words, elsewhere</a>
      <a href="#eidos-main">back to top ↑</a>
    </footer>
  </div>
</EidosLayout>
