---
// An earlier name for this page. Static hosting has no redirect rules without
// a Worker, so each old path is a meta refresh with a canonical.
const to = "/feed";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta name="robots" content="noindex" />
    <title>moved</title>
  </head>
  <body>
    <p>this page is now the <a href={to}>feed</a>.</p>
  </body>
</html>
