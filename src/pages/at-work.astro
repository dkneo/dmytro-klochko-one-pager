---
// This page shipped under /at-work before it was renamed. Static hosting has
// no redirect rules without a Worker, so the forward is a meta refresh with a
// canonical pointing at the real page.
const to = "/modus-operandi";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta name="robots" content="noindex" />
    <title>moved</title>
  </head>
  <body>
    <p>this page is now at <a href={to}>modus operandi</a>.</p>
  </body>
</html>
