---
// Shipped under this path before the rename. Static hosting has no redirect
// rules without a Worker, so this is a meta refresh with a canonical.
const to = "/archive";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta name="robots" content="noindex" />
    <title>moved</title>
  </head>
  <body>
    <p>this page is now the <a href={to}>archive</a>.</p>
  </body>
</html>
