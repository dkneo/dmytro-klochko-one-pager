---
// Not linked from anywhere. A bench for looking at art before it ships.
import Layout from "../layouts/Layout.astro";
import AsciiShader from "../components/AsciiShader.astro";
---

<Layout title="lab" description="not for shipping">
  <section class="shell session">
    <div class="card"><p class="card-no">a</p><h1 class="card-title">joi</h1></div>
    <div style="max-width: 26rem">
      <AsciiShader
        src="/ascii/joi.jpg"
        cols={72}
        black={0.3}
        white={0.99}
        gamma={1.5}
        label="move the cursor over her"
      />
    </div>
  </section>

  <section class="shell session">
    <div class="card"><p class="card-no">b</p><h2 class="card-title">bebop</h2></div>
    <div style="max-width: 40rem">
      <AsciiShader
        src="/ascii/bebop-sheet.jpg"
        frames={28}
        cols={100}
        fps={11}
        black={0.1}
        white={0.99}
        gamma={1.15}
        label="28 frames"
      />
    </div>
  </section>
</Layout>
