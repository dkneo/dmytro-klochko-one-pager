---
import Layout from "../layouts/Layout.astro";
import AsciiShader from "../components/AsciiShader.astro";

const title = "taste · dmytro klochko";
const description =
  "films and interviews, the people dmytro klochko watches, and what he keeps going back to.";
---

<Layout title={title} description={description} current="taste">
  <section class="shell session" id="taste" data-scene="estuary" aria-labelledby="a6">
    <div class="card">
      <p class="card-no">01</p>
      <h1 class="card-title" id="a6">what i keep going back to</h1>
    </div>

    <div class="solo">
      <a
        class="record"
        href="https://open.spotify.com/playlist/4eD4OFwaWkhh8n6WcEUhUg"
        target="_blank"
        rel="noreferrer"
      >
        <AsciiShader
          class="ascii--vinyl"
          src="/ascii/vinyl-sheet.jpg"
          frames={30}
          cols={68}
          fps={16}
          black={0.02}
          white={0.99}
          gamma={0.9}
        />
        <span class="record-meta">
          <b>space cowboy<span class="arw">↗</span></b>
          <em>the playlist</em>
        </span>
      </a>
    </div>

  </section>

  <a class="onward onward--back" href="/">
    <span class="arw" aria-hidden="true">↖</span><span>back to the main page</span>
  </a>
</Layout>
