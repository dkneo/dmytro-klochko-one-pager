---
import Layout from "../layouts/Layout.astro";
import AsciiShader from "../components/AsciiShader.astro";

// One highlighted phrase per paragraph. Marking more would be marking none.
// Eight, so the board fills four across without a ragged last row. Uncut Gems
// keeps its own ratio: the line is burned into the frame and a square crop
// cuts it in half.
const wall = [
  { src: "/images/wall/w01.jpg", cap: "dieter rams" },
  { src: "/images/wall/w05.jpg", cap: "hajime sorayama" },
  { src: "/images/wall/w06.jpg", cap: "ryuichi sakamoto" },
  { src: "/images/wall/w04.jpg", cap: "steve jobs, on the way" },
  { src: "/images/wall/w08.jpg", cap: "robin williams" },
  { src: "/images/wall/w10.jpg", cap: "daft punk" },
  { src: "/images/wall/w11.jpg", cap: "jony ive" },
  { src: "/images/wall/w12.jpg", cap: "david foster wallace" },
] as const;

const books = [
  "the lord of the rings, j.r.r. tolkien",
  "upstream, mary oliver",
  "gaspard de la nuit, aloysius bertrand (also the ravel suite)",
  "man's search for meaning, viktor frankl",
] as const;

// A justified hang, in explicit rows. Each row is given an aspect-ratio equal
// to the sum of its paintings' ratios, so the row's height resolves to
// width / sum and every painting in it comes out the same height at its own
// true proportions. Rows finish flush at any width and nothing is cropped,
// which flex-wrap alone could not do: it left the last row stretched.
// Eight, in two rows whose ratios happen to sum identically (4.404 each), so
// both rows resolve to exactly the same height with nothing hardcoded.
const rows = [
  [
    { src: "/images/paintings/p01.jpg", ar: 0.865, who: "katherine bradford",
      work: "Swimmers Under Orange Moon, 2025, acrylic on canvas" },
    { src: "/images/paintings/p02.jpg", ar: 0.796, who: "odilon redon", work: "" },
    { src: "/images/paintings/p03.jpg", ar: 1.135, who: "hasui kawase", work: "" },
    { src: "/images/paintings/p04.jpg", ar: 1.608, who: "minami kobayashi",
      work: "Two Men at a Japanese Restaurant, 2024" },
  ],
  [
    { src: "/images/paintings/p05.jpg", ar: 0.85, who: "franz kline",
      work: "Orange and Black Wall, 1959, Museum of Fine Arts, Houston" },
    { src: "/images/paintings/p06.jpg", ar: 1.392, who: "kiyoshi saitō", work: "" },
    { src: "/images/paintings/p07.jpg", ar: 0.75, who: "claude monet", work: "" },
    { src: "/images/paintings/p09.jpg", ar: 1.412, who: "hajime sorayama", work: "" },
  ],
] as const;

const title = "taste · dmytro klochko";
const description =
  "films and interviews, the people dmytro klochko watches, and what he keeps going back to.";
---

<Layout title={title} description={description} current="taste">
  <section class="shell session" id="top" data-scene="estuary" aria-labelledby="a3">
    <div class="card">
      <p class="card-no">01</p>
      <h1 class="card-title" id="a3">literally me</h1>
    </div>

    <div class="wall">
      {
        wall.map((w) => (
          <figure>
            <span class="cell">
              <img src={w.src} alt={w.cap} loading="lazy" />
            </span>
            <figcaption>{w.cap}</figcaption>
          </figure>
        ))
      }
    </div>

  </section>

  <section class="shell session" id="taste" data-scene="estuary" aria-labelledby="a6">
    <div class="card">
      <p class="card-no">02</p>
      <h2 class="card-title" id="a6">what i keep going back to</h2>
    </div>

    <div class="bay">
      <div>
        <ol class="log shelf">
          {books.map((b) => <li><p>{b}</p></li>)}
        </ol>

        <div class="sheet">
          <figure>
            <span class="cell">
              <img src="/images/swag-label.jpg" alt="A garment label reading: glad we're in this together. Replika, 2025" loading="lazy" />
            </span>
            <figcaption>the label</figcaption>
          </figure>
          <figure>
            <span class="cell">
              <img src="/images/swag-hoodie.jpg" alt="A green Replika hoodie on a chair against a deep blue backdrop" loading="lazy" />
            </span>
            <figcaption>the hoodie</figcaption>
          </figure>
          <figure>
            <span class="cell">
              <img src="/images/swag-team.jpg" alt="Dmytro and a colleague in Replika swag by a lake" loading="lazy" />
            </span>
            <figcaption>worn in</figcaption>
          </figure>
        </div>
        <p class="credit">
          replika's 2025 merch. i designed it,{" "}
          <a href="https://x.com/replika/status/1991136959385817336" target="_blank" rel="noreferrer">down
          to the label<span class="arw">↗</span></a>
        </p>
      </div>

      <a
        class="record"
        href="https://open.spotify.com/playlist/4eD4OFwaWkhh8n6WcEUhUg"
        target="_blank"
        rel="noreferrer"
      >
        <AsciiShader
          class="ascii--vinyl"
          src="/ascii/vinyl-sheet.jpg"
          frames={30}
          cols={68}
          fps={16}
          black={0.02}
          white={0.99}
          gamma={0.9}
        />
        <span class="record-meta">
          <b>space cowboy<span class="arw">↗</span></b>
          <em>the playlist</em>
        </span>
      </a>
    </div>

    <p class="poem-by">paintings i loved recently.</p>

    {/* The caption lives inside its figure and is lifted out of flow, so each
        row keeps the aspect maths that justifies it while every name stays
        with its painting however the row reflows. A parallel caption row
        aligned only while both were single rows: at two columns it put the
        first two names under the last two paintings. */}
    <div class="hang">
      {
        rows.map((row) => (
          <div class="hang-plates" style={`--sum: ${row.reduce((t, a) => t + a.ar, 0)}`}>
            {row.map((art) => (
              <figure style={`--ar: ${art.ar}`}>
                <span class="plate-img">
                  <img src={art.src} alt={art.who ? `${art.who}. ${art.work}` : ""} title={art.work || undefined} loading="lazy" />
                </span>
                <figcaption>{art.who}</figcaption>
              </figure>
            ))}
          </div>
        ))
      }
    </div>

    <p class="poem-by">random poems. mine, 2026.</p>

    <div class="poems">
      <blockquote class="poem">
        i am lost in sorrento<br />
        for i am the taste of its lemons and its women's feet<br />
        i'm the salt of its breeze<br />
        i'm so glad i can't breathe<br />
        i'm so tall i am whole twelve feet
      </blockquote>
      <blockquote class="poem">
        this girl is the warm sensation of young sun on my bare chest<br />
        her chestnut irises, and the greens in them, glimmer with playful unrest<br />
        when she whispers her spells, her tricks, and her promises, i couldn't get any slumber<br />
        for she carries inside her an eternal summer, an eternal summer
      </blockquote>
    </div>
  </section>

  <a class="onward onward--back" href="/">
    <span class="arw" aria-hidden="true">↖</span><span>back to the main page</span>
  </a>
</Layout>
