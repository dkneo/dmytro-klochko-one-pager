---
import Layout from "../layouts/Layout.astro";
import portrait from "../ascii/portrait.txt?raw";
import chess from "../ascii/chess.txt?raw";
import lift from "../ascii/lift.txt?raw";

const roles = [
  {
    company: "replika",
    what: "#1 ai friend. 42m users worldwide",
    role: "chief executive, product and technology officer",
    href: "https://replika.com",
    mark: "/images/marks/replika.png",
  },
  {
    company: "homa",
    what: "remote team happiness saas",
    role: "founder and chief executive officer",
    mark: "/images/marks/homa.png",
  },
  {
    company: "chatfuel",
    what: "marketing ai agent. 150k+ businesses. meta business partner",
    role: "growth",
    href: "https://chatfuel.com",
    mark: "/images/marks/chatfuel.png",
  },
  {
    company: "hily",
    what: "top 4 dating app in the u.s.",
    role: "product and growth",
    href: "https://hily.com",
    mark: "/images/marks/hily.png",
  },
  {
    company: "vk",
    what: "400m mau social network",
    role: "product and growth",
    href: "https://vk.com",
    mark: "/images/marks/vk.png",
  },
  {
    company: "skyeng",
    what: "top-1 european 1:1 educational platform",
    role: "product and growth",
    href: "https://skyeng.ru",
    mark: "/images/marks/skyeng.png",
  },
] as const;

const log = [
  "5 yo: ukraine's bronze chess champion. blindfold chess child prodigy (sans voir).",
  "6 yo onwards: multiple olympiads winner: math, humanities {later: coding, economics}.",
  "9 yo: best kid actor award.",
  "11 yo: first song. poetry contest winner.",
  "14 yo: toured neighboring countries as band leader.",
  "19 yo: founded student theatre {director, screenwriter}. 50+ members. 700+ audience for the premiere.",
  "to this day: designing fashion items. writing. doing film photography.",
] as const;

const receipts = [
  {
    src: "time",
    href: "https://time.com/collections/davos-2026/7339222/ai-predictions-2026/",
    line: "“what we care about is people getting happier. whether or not it’s good, it’s happening.”",
    meta: "5 predictions for ai in 2026, davos collection, january 2026",
  },
  {
    src: "princeton",
    href: "https://arxiv.org/abs/2311.10599",
    line: "companion chatbot users indicated that these relationships were beneficial to their social health.",
    meta: "guingrich & graziano, oxford intersections: ai in society, 2025",
  },
] as const;

const vlogs = [
  { label: "kbs interview", place: "korea", href: "https://www.instagram.com/p/DYhL6c9Ti8M/", video: "vlog-kbs" },
  { label: "vienna", place: "austria", href: "https://www.instagram.com/p/DYXLh6rI2JI/", video: "vlog-vienna" },
  { label: "in paris", place: "france", href: "https://www.instagram.com/p/DYheZtSNZxM/", video: "vlog-paris" },
  { label: "london", place: "the film", video: "film-london" },
  { label: "live on tvnz", place: "new zealand", video: "tvnz-live" },
  { label: "finding connection", place: "dok.fest münchen", video: "dokfest" },
] as const;

const outs = [
  {
    name: "the replika manifesto",
    what: "ai isn't the problem, it just forgot real life. i wrote it.",
    kind: "essay",
    href: "https://replika.com/manifesto",
  },
  {
    name: "5 predictions for ai in 2026",
    what: "time, davos collection",
    kind: "press",
    href: "https://time.com/collections/davos-2026/7339222/ai-predictions-2026/",
  },
  {
    name: "chatbots as social companions",
    what: "guingrich & graziano, princeton",
    kind: "research",
    href: "https://arxiv.org/abs/2311.10599",
  },
  {
    name: "replika 2025 merch",
    what: "i designed it, down to the label",
    kind: "made",
    href: "https://x.com/replika/status/1991136959385817336",
  },
] as const;

const shelf = [
  "the lord of the rings, j.r.r. tolkien",
  "upstream, mary oliver",
  "gaspard de la nuit, aloysius bertrand (also the ravel suite)",
  "man's search for meaning, viktor frankl",
  "rumours, fleetwood mac",
] as const;

const title = "dmytro klochko";
const description =
  "ceo at replika. product and engineering, out of art, chess and theatre. based between nyc, paris and sf.";
---

<Layout title={title} description={description}>
  <section class="shell session" id="who" aria-labelledby="s1">
    <div class="card">
      <p class="card-no">session #01</p>
      <h1 class="card-title" id="s1">asteroid blues</h1>
      <p class="card-what">who is asking</p>
    </div>

    <p class="lede">
      jaywalker at the intersection of art and technology. product &amp; engineering guy with a
      background in art, chess and theatre.
    </p>
    <p class="dim">
      ceo, <a href="https://replika.com" target="_blank" rel="noreferrer">replika ↗</a> &nbsp;·&nbsp;
      based between nyc, paris &amp; sf.
    </p>

    <div class="plate-wrap">
      <span class="plate" tabindex="0" style="--cols: 104">
        <pre aria-hidden="true">{portrait}</pre>
        <img
          src="/images/about.jpg"
          alt="Dmytro photographed in a mirror, in a cap and worn denim jacket"
        />
      </span>
      <span class="plate-cap">
        <span>plate 01 — the operator</span>
        <span>hover to develop</span>
      </span>
    </div>
  </section>

  <section class="shell session" id="now" aria-labelledby="s2">
    <div class="card">
      <p class="card-no">session #02</p>
      <h2 class="card-title" id="s2">tank!</h2>
      <p class="card-what">what he is doing now</p>
    </div>

    <ol class="reg">
      {
        roles.slice(0, 1).map((r) => (
          <li>
            <span class="reg-mark" style={`--mark: url(${r.mark})`} aria-hidden="true" />
            <span class="reg-co">
              <a href={r.href} target="_blank" rel="noreferrer">
                {r.company} ↗
              </a>
            </span>
            <span class="reg-what">{r.what}</span>
            <span class="reg-role">{r.role}</span>
            <span class="reg-story">
              <span>
                i realized replika could be 100x what it was, so i rebuilt it. replika 2.0 is a
                ground-up rewrite: i wrote the first prototypes myself, ran 400+ user interviews,
                and still write the architecture, the prompts and most of the copy.
              </span>
              <span>
                i rebuilt the team around it: phds, true artists, pirates<img
                  class="mark-pirate"
                  src="/images/pirate-flag-mark.png"
                  alt=""
                />. i'm intense and hands-on, so i don't hire managers.
              </span>
              <span>
                college dropout. i lecture at the university of vienna to grok where conversational
                agentic ai goes next. users love 2.0, retention skyrocketed, and i'm already
                building the company's next era. in stealth.
              </span>
            </span>
          </li>
        ))
      }
    </ol>

    <ul class="receipts">
      {
        receipts.map((r) => (
          <li>
            <a class="receipt-src" href={r.href} target="_blank" rel="noreferrer">
              {r.src} ↗
            </a>
            <p>{r.line}</p>
            <span>{r.meta}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell session" id="before" aria-labelledby="s3">
    <div class="card">
      <p class="card-no">session #03</p>
      <h2 class="card-title" id="s3">gateway shuffle</h2>
      <p class="card-what">everything before replika</p>
    </div>

    <ol class="reg">
      {
        roles.slice(1).map((r) => (
          <li>
            <span class="reg-mark" style={`--mark: url(${r.mark})`} aria-hidden="true" />
            <span class="reg-co">
              {r.href ? (
                <a href={r.href} target="_blank" rel="noreferrer">
                  {r.company} ↗
                </a>
              ) : (
                r.company
              )}
            </span>
            <span class="reg-what">{r.what}</span>
            <span class="reg-role">{r.role}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="shell session" id="origin" aria-labelledby="s4">
    <div class="card">
      <p class="card-no">session #04</p>
      <h2 class="card-title" id="s4">ballad of fallen angels</h2>
      <p class="card-what">where he comes from</p>
    </div>

    <p class="lede">
      born &amp; raised in donetsk, eastern ukraine. very poor household. fled war as a teenager.
      slept on the streets for weeks.
    </p>

    <ol class="log">
      {log.map((item) => <li>{item}</li>)}
    </ol>

    <div class="plate-wrap">
      <span class="plate" tabindex="0" style="--cols: 96">
        <pre aria-hidden="true">{chess}</pre>
        <img
          src="/images/childhood-chess.jpg"
          alt="Dmytro as a small boy at a tournament board, grinning, a row of chess pieces in front of him"
        />
      </span>
      <span class="plate-cap">
        <span>plate 02 — bronze, age five</span>
        <span>hover to develop</span>
      </span>
    </div>
  </section>

  <section class="shell session" id="method" aria-labelledby="s5">
    <div class="card">
      <p class="card-no">session #05</p>
      <h2 class="card-title" id="s5">jamming with edward</h2>
      <p class="card-what">how he works, and what he likes</p>
    </div>

    <div class="prose">
      <p>
        natural aptitude for taste, action bias, &amp; having too much fun shipping. clairvoyance,
        aggressive optimism. following my nose. very fucking clean and direct in my comms.
      </p>
      <p>
        culture in my teams is something i'm incredibly proud of: violent intolerance for mediocre
        work. anime-level fellowship &amp; camaraderie. fearlessness. relentless pursuit of the
        mission.
      </p>
      <p>
        unhealthy excitement about customers {"{more users in my slack than team members lol}"}.
        making my product feel like magic. extensive experience working with the world's best brand
        agencies.
      </p>
    </div>

    <div class="reel">
      {
        vlogs.map((v) =>
          v.href ? (
            <a href={v.href} target="_blank" rel="noreferrer">
              <span class="frame">
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={`/video/${v.video}-poster.jpg`}
                  aria-hidden="true"
                >
                  <source src={`/video/${v.video}.webm`} type="video/webm" />
                  <source src={`/video/${v.video}.mp4`} type="video/mp4" />
                </video>
              </span>
              <span class="cap">
                {v.label} — {v.place} ↗
              </span>
            </a>
          ) : (
            <figure>
              <span class="frame">
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={`/video/${v.video}-poster.jpg`}
                  aria-hidden="true"
                >
                  <source src={`/video/${v.video}.webm`} type="video/webm" />
                  <source src={`/video/${v.video}.mp4`} type="video/mp4" />
                </video>
              </span>
              <span class="cap">
                {v.label} — {v.place}
              </span>
            </figure>
          )
        )
      }
    </div>

    <ul class="outs">
      {
        outs.map((o) => (
          <li>
            <a href={o.href} target="_blank" rel="noreferrer">
              <b>{o.name} ↗</b>
              <span>{o.what}</span>
              <em>{o.kind}</em>
            </a>
          </li>
        ))
      }
    </ul>

    <ol class="log shelf">
      {shelf.map((item) => <li>{item}</li>)}
    </ol>

    <div class="poems">
      <blockquote class="poem">
        i am lost in sorrento<br />
        for i am the taste of its lemons and its women's feet<br />
        i'm the salt of its breeze<br />
        i'm so glad i can't breathe<br />
        i'm so tall i am whole twelve feet
      </blockquote>
      <blockquote class="poem">
        this girl is the warm sensation of young sun on my bare chest<br />
        her chestnut irises, and the greens in them, glimmer with playful unrest<br />
        when she whispers her spells, her tricks, and her promises, i couldn't get any slumber<br />
        for she carries inside her an eternal summer, an eternal summer
      </blockquote>
    </div>
  </section>

  <section class="shell session" id="contact" aria-labelledby="s6">
    <div class="card">
      <p class="card-no">session #06</p>
      <h2 class="card-title" id="s6">the real folk blues</h2>
      <p class="card-what">come say hi</p>
    </div>

    <p class="say">
      write to me at <a href="mailto:1@dmklochko.com">1@dmklochko.com</a>, or
      <a href="mailto:1@replika.com">1@replika.com</a> for anything replika. i'm also on
      <a href="https://x.com/dkreplika" target="_blank" rel="noreferrer">x</a>,
      <a href="https://instagram.com/dmytrotoday" target="_blank" rel="noreferrer">instagram</a> and
      <a href="https://www.linkedin.com/in/heydmytro/" target="_blank" rel="noreferrer">linkedin</a>.
    </p>

    <div class="plate-wrap">
      <span class="plate" tabindex="0" style="--cols: 84">
        <pre aria-hidden="true">{lift}</pre>
        <img src="/images/elevator.jpg" alt="Dmytro photographed head to toe in a mirrored lift" />
      </span>
      <span class="plate-cap">
        <span>plate 03 — the lift</span>
        <span>hover to develop</span>
      </span>
    </div>
  </section>
</Layout>
