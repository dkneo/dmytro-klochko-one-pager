  <script is:inline>
    // A cv printed or saved as a pdf has no clicks in it, so every row opens
    // for the print and closes again after. The css in @media print tries the
    // same thing, but ::details-content is not everywhere yet; this is the
    // part that is true in every browser. Without javascript the rows still
    // open by hand, which is the whole reason they are <details>.
    (() => {
      const jobs = [...document.querySelectorAll("details.cv-job")];
      if (!jobs.length) return;
      let shut = [];
      addEventListener("beforeprint", () => {
        shut = jobs.filter((d) => !d.open);
        for (const d of shut) d.open = true;
      });
      addEventListener("afterprint", () => {
        for (const d of shut) d.open = false;
        shut = [];
      });
    })();
  </script>

  <script>
    import { fitEaselFrame } from "../scripts/easel-frame.js";

    // The frame beside the road. Nothing is drawn between them — a rule
    // floating in open water read as a stray mark. The pairing is said in
    // one colour instead: the line you are on and the frame light together,
    // and the frame stays level with your reading rather than sliding to
    // the bottom of the section. On touch screens the same pictures unfold
    // inline under the line you tap.
    (() => {
      const bay = document.querySelector(".journey-bay");
      const easel = document.querySelector(".easel");
      if (!bay || !easel) return;
      const layers = [...easel.querySelectorAll(".easel-layer")];
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const wide = matchMedia("(hover: hover) and (min-width: 861px)");
      const easelOn = () => wide.matches;
      const beads = [...bay.querySelectorAll(".log--journey li")];
      let active = null;
      let layerIndex = 0;
      let swapToken = 0;

      const announce = (shown) => {
        for (const bead of beads) bead.setAttribute("aria-expanded", String(bead === shown));
      };

      const sizeFrame = (li) => {
        const maxHeight = Math.min(336, Math.round(innerHeight * 0.68));
        const frame = fitEaselFrame(
          Number(li.dataset.width),
          Number(li.dataset.height),
          { maxHeight },
        );
        easel.style.setProperty("--easel-width", `${frame.width}px`);
        easel.style.setProperty("--easel-ratio", String(frame.ratio));
      };

      const setMedia = (li, imgEl, vidEl) => {
        const src = li.dataset.easel;
        if (li.dataset.kind === "video" && !still) {
          if (vidEl.dataset.src !== src) {
            vidEl.src = src;
            vidEl.dataset.src = src;
            // A poster means the frame is never briefly empty while the
            // clip decodes, and it is what shows if autoplay is refused.
            if (li.dataset.poster) vidEl.poster = li.dataset.poster;
          }
          imgEl.hidden = true; vidEl.hidden = false;
          vidEl.play().catch(() => {});
        } else {
          vidEl.pause(); vidEl.hidden = true; imgEl.hidden = false;
          const want = li.dataset.kind === "video" ? li.dataset.poster : src;
          if (want && !imgEl.src.endsWith(want)) imgEl.src = want;
          return imgEl.decode?.().catch(() => {});
        }
      };

      const crossfadeMedia = async (li) => {
        const token = ++swapToken;
        const nextIndex = (layerIndex + 1) % layers.length;
        const next = layers[nextIndex];
        const current = layers[layerIndex];
        const nextImg = next.querySelector("img");
        const nextVid = next.querySelector("video");
        await setMedia(li, nextImg, nextVid);
        if (token !== swapToken) return;
        next.classList.add("is-active");
        current.classList.remove("is-active");
        current.querySelector("video").pause();
        layerIndex = nextIndex;
      };

      const activate = (li) => {
        if (active && active !== li) active.classList.remove("is-shown");
        active = li;
        li.classList.add("is-shown");
        announce(li);
        sizeFrame(li);
        easel.classList.add("is-lit");
        crossfadeMedia(li);
      };

      for (const li of beads) {
        li.addEventListener("pointerenter", () => {
          if (easelOn() && li.dataset.easel) activate(li);
        });
        li.addEventListener("focus", () => {
          if (easelOn() && li.dataset.easel) activate(li);
        });
        li.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          if (easelOn()) activate(li);
          else li.click();
        });
      }

      // Scrolling changes the picture too, so the road tells its story to
      // someone who never moves the mouse: whichever bead with a picture
      // sits nearest the middle of the screen is the one the frame holds.
      // Measured straight from the rects on each scroll rather than through
      // an IntersectionObserver — fourteen rects is nothing, and it works
      // in every context an observer's callbacks might not reach.
      const withMedia = beads.filter((li) => li.dataset.easel);
      const pick = () => {
        if (!easelOn()) return;
        const box = bay.getBoundingClientRect();
        if (box.bottom < 0 || box.top > innerHeight) return;
        const mid = innerHeight / 2;
        let best = null, bestD = Infinity;
        for (const li of withMedia) {
          const r = li.getBoundingClientRect();
          const d = Math.abs(r.top + r.height / 2 - mid);
          if (d < bestD) { bestD = d; best = li; }
        }
        if (best && best !== active) activate(best);
      };
      addEventListener("scroll", pick, { passive: true });
      addEventListener("resize", () => {
        if (active) sizeFrame(active);
        pick();
      });

      const first = withMedia[0];
      const preset = () => { if (first && !active && easelOn()) activate(first); };
      preset();
      wide.addEventListener("change", preset);

      // ── the shoebox, for fingers ──
      const print = document.createElement("figure");
      print.className = "bead-print";
      print.innerHTML =
        '<span class="cell"><img alt="" hidden /><video muted loop playsinline preload="none" hidden></video></span>';
      const pImg = print.querySelector("img");
      const pVid = print.querySelector("video");
      let open = null;

      for (const li of beads) {
        li.addEventListener("click", (e) => {
          if (easelOn() || !li.dataset.easel) return;
          if (e.target.closest("a")) return;
          if (open === li) {
            pVid.pause(); print.remove(); li.classList.remove("is-shown");
            open = null; announce(null); return;
          }
          open?.classList.remove("is-shown");
          open = li;
          li.classList.add("is-shown");
          announce(li);
          li.appendChild(print);
          setMedia(li, pImg, pVid);
        });
      }
    })();
  </script>

