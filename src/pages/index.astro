---
import Layout from "../layouts/Layout.astro";
import ExternalLink from "../components/ExternalLink.astro";
import FramedPhoto from "../components/FramedPhoto.astro";
import PhotoFill from "../components/PhotoFill.astro";

// Company names and titles are capitalised; the running copy is not. A
// credentials list is scanned, not read, and lowercase proper nouns are what
// made this section hard to parse.
type Role = {
  readonly company: string;
  readonly what: string;
  readonly title: string;
  readonly href?: string;
  readonly logo?: string;
};

const roles = [
  {
    company: "Replika",
    what: "the #1 AI friend. 42m+ users across 145+ countries",
    title: "Chief Executive Officer. Previously COO, CPO, CTO",
    href: "https://replika.com",
    logo: "/images/logos/replika.png",
  },
  {
    company: "Homa Industries",
    what: "HR platform and marketplace for remote teams",
    title: "Founder and Chief Executive Officer",
  },
  {
    company: "Chatfuel",
    what: "marketing AI agents. Meta Business Partner",
    title: "Head of Marketing and Expansion",
    href: "https://chatfuel.com",
    logo: "/images/logos/chatfuel.png",
  },
  {
    company: "Hily",
    what: "top-3 dating app in the U.S. by downloads",
    title: "Strategic Product Manager",
    href: "https://hily.com",
    logo: "/images/logos/hily.png",
  },
  {
    company: "VK",
    what: "the largest social network in Russia and the CIS",
    title: "Senior Product Manager",
    href: "https://vk.com",
    logo: "/images/logos/vk.png",
  },
  {
    company: "Skyeng",
    what: "the largest edtech company in Eastern Europe",
    title: "Product Manager",
    href: "https://skyeng.ru",
    logo: "/images/logos/skyeng.png",
  },
] as const satisfies readonly Role[];

const upbringing = [
  "5 yo: ukraine's bronze chess champion. blindfold chess child prodigy (sans voir).",
  "6 yo onwards: multiple olympiads winner: math, humanities {later: coding, economics}.",
  "9 yo: best kid actor award.",
  "11 yo: first song. poetry contest winner.",
  "14 yo: toured neighboring countries as band leader.",
  "19 yo: founded student theatre {director, screenwriter}. 50+ members. 700+ audience for the premiere.",
  "to this day: designing fashion items. writing. doing film photography.",
] as const;

// Both verified against the source, not paraphrased from memory. The Princeton
// line is the study the Replika manifesto itself cites.
const proof = [
  {
    source: "time",
    href: "https://time.com/collections/davos-2026/7339222/ai-predictions-2026/",
    line: "“what we care about is people getting happier. whether or not it’s good, it’s happening.”",
    meta: "5 predictions for ai in 2026, davos collection, january 2026",
  },
  {
    source: "princeton",
    href: "https://arxiv.org/abs/2311.10599",
    line: "companion chatbot users indicated that these relationships were beneficial to their social health.",
    meta: "guingrich & graziano, oxford intersections: ai in society, 2025",
  },
] as const;

const socials = [
  { label: "x", href: "https://x.com/dkreplika" },
  { label: "instagram", href: "https://instagram.com/dmytrotoday" },
  { label: "linkedin", href: "https://www.linkedin.com/in/heydmytro/" },
] as const;

const title = "dmytro klochko";
const description =
  "ceo at replika. product and engineering, out of art, chess and theatre. based between nyc, paris and sf.";
---

<Layout title={title} description={description}>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-collage" aria-hidden="true">
      <PhotoFill class="hero-photo hero-photo--left" src="/images/hero-left.jpg" alt="" eager />
      <PhotoFill class="hero-photo hero-photo--center" src="/images/hero-center.jpg" alt="" eager />
      <PhotoFill class="hero-photo hero-photo--right" src="/images/hero-right.jpg" alt="" />
    </div>

    <div class="hero-copy">
      <h1 id="hero-title">
        jaywalker at the intersection of <em>art and technology.</em>
      </h1>
    </div>
  </section>

  <section class="about" id="about" aria-labelledby="about-title">
    <div class="about-inner">
      <PhotoFill
        class="about-photo"
        src="/images/about.jpg"
        alt="Dmytro photographed in a mirror, in a cap and worn denim jacket"
      />
      <div class="about-copy">
        <h2 id="about-title">about <em>me</em></h2>
        <p class="about-role">
          <ExternalLink class="role-link" href="https://replika.com" label="ceo, replika" />
        </p>
        <p class="about-lede">
          product &amp; engineering guy with a background in art, chess and theatre.
        </p>
        <p class="about-note">based between nyc, paris &amp; sf.</p>
      </div>
    </div>
  </section>

  <section class="page-shell section" id="career" aria-labelledby="career-title">
    <p class="eyebrow">01</p>
    <h2 class="section-title" id="career-title">career</h2>

    <ol class="roles">
      {
        roles.map((role) => (
          <li class="role">
            <span class="role-mark" aria-hidden="true">
              {role.logo ? <img src={role.logo} alt="" loading="lazy" /> : <span>H</span>}
            </span>
            <span class="role-body">
              <span class="role-head">
                {role.href ? (
                  <a href={role.href} target="_blank" rel="noreferrer">
                    {role.company} <span aria-hidden="true" class="arrow">↗</span>
                  </a>
                ) : (
                  <span>{role.company}</span>
                )}
                <span class="role-what">{role.what}</span>
              </span>
              <span class="role-title">{role.title}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="career-note-block">
      <p>
        i realized replika could be 100x what it was, so i rebuilt it. replika 2.0 is a ground-up
        rewrite: i wrote the first prototypes myself, ran 400+ user interviews, and still write the
        architecture, the prompts and most of the copy.
      </p>
      <p>
        i rebuilt the team around it: phds, true artists, pirates<img
          class="mark-pirate"
          src="/images/pirate-flag-mark.png"
          alt=""
        />. i'm intense and hands-on, so i don't hire managers.
      </p>
      <p>
        college dropout. i lecture at the university of vienna to grok where conversational agentic
        ai goes next. users love 2.0, retention skyrocketed, and i'm already building the company's
        next era. in stealth.
      </p>
    </div>

    <ul class="career-proof">
      {
        proof.map((item) => (
          <li>
            <ExternalLink class="proof-source" href={item.href} label={item.source} />
            <p>{item.line}</p>
            <span class="proof-meta">{item.meta}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-shell section" id="upbringing" aria-labelledby="upbringing-title">
    <p class="eyebrow">02</p>
    <h2 class="section-title" id="upbringing-title">upbringing</h2>

    <p class="section-lede">
      born &amp; raised in donetsk, eastern ukraine. very poor household. fled war as a teenager.
      slept on the streets for weeks.
    </p>

    <div class="upbringing-body">
      <ol class="timeline">
        {
          upbringing.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <p>{item}</p>
            </li>
          ))
        }
      </ol>

      <div class="childhood-collage">
        <FramedPhoto
          class="childhood-photo childhood-photo--chess"
          src="/images/childhood-chess.jpg"
          alt="Dmytro as a small boy at a tournament board, grinning, a row of chess pieces in front of him"
        />
        <FramedPhoto
          class="childhood-photo childhood-photo--piano"
          src="/images/childhood-music.jpg"
          alt="Dmytro as a child in studio headphones, grinning at a microphone"
        />
        <FramedPhoto
          class="childhood-photo childhood-photo--now"
          src="/images/childhood-geese.jpg"
          alt="Dmytro as a toddler running through a garden, laughing, a gaggle of geese behind him"
        />
      </div>
    </div>
  </section>

  <section class="ways" aria-labelledby="ways-title">
    <div class="page-shell ways-inner">
      <div class="ways-head">
        <p class="eyebrow">03</p>
        <h2 class="section-title" id="ways-title">ways of working</h2>
        <figure class="ways-inspo">
          <img
            src="/images/lynch.jpg"
            alt="David Lynch at a desk, subtitled: we never get any time to experiment, we never get any time to, you know, go dreamy"
            loading="lazy"
          />
        </figure>
      </div>
      <div class="ways-grid">
        <p>
          natural aptitude for taste, action bias, &amp; having too much fun shipping. clairvoyance,
          aggressive optimism. following my nose. very fucking clean and direct in my comms.
        </p>
        <p>
          culture in my teams is something i'm incredibly proud of: violent intolerance for mediocre
          work. anime-level fellowship &amp; camaraderie. fearlessness. relentless pursuit of the
          mission.
        </p>
        <p>
          unhealthy excitement about customers {"{more users in my slack than team members lol}"}.
          making my product feel like magic. extensive experience working with the world's best
          brand agencies.
        </p>
      </div>
    </div>
  </section>

  <section class="page-shell section deep-dives" aria-labelledby="more-title">
    <p class="eyebrow">04</p>
    <h2 class="section-title" id="more-title">more</h2>
    <div class="dive-grid">
      <a class="dive" href="/watch">
        <span class="dive-name">watch &amp; listen <span aria-hidden="true" class="arrow">↗</span></span>
        <span class="dive-what">vlogs, broadcast interviews, the documentary, the manifesto.</span>
      </a>
      <a class="dive" href="/taste">
        <span class="dive-name">taste <span aria-hidden="true" class="arrow">↗</span></span>
        <span class="dive-what">books, records, colours and two poems.</span>
      </a>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="page-shell contact-inner">
      <p class="eyebrow">05</p>
      <h2 class="section-title" id="contact-title">come say <em>hi.</em></h2>
      <p class="contact-copy">
        write to me at <a href="mailto:1@dmklochko.com">1@dmklochko.com</a>, or{" "}
        <a href="mailto:1@replika.com">1@replika.com</a> for anything replika. i answer everything
        that isn't a pitch deck for a browser extension. i'm also on{" "}{
          socials.map((s, i) => (
            <>
              <a href={s.href} target="_blank" rel="noreferrer">
                {s.label}
              </a>
              {i < socials.length - 2 ? ", " : i === socials.length - 2 ? " and " : "."}
            </>
          ))
        }
      </p>
      <FramedPhoto
        class="contact-photo"
        src="/images/elevator.jpg"
        alt="Dmytro photographed head to toe in a mirrored lift"
      />
    </div>
  </section>
</Layout>
