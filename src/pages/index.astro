---
import Layout from "../layouts/Layout.astro";
import mark from "../ascii/mark.json";

const roles = [
  {
    company: "replika",
    what: "#1 ai friend. 42m users worldwide",
    role: "chief executive, product and technology officer",
    href: "https://replika.com",
    mark: "/images/marks/replika.png",
  },
  {
    company: "homa",
    what: "remote team happiness saas",
    role: "founder and chief executive officer",
    mark: "/images/marks/homa.png",
  },
  {
    company: "chatfuel",
    what: "marketing ai agent. 150k+ businesses. meta business partner",
    role: "growth",
    href: "https://chatfuel.com",
    mark: "/images/marks/chatfuel.png",
  },
  {
    company: "hily",
    what: "#3 dating app in the u.s. by downloads",
    role: "product and growth",
    href: "https://hily.com",
    mark: "/images/marks/hily.png",
  },
  {
    company: "vk",
    what: "largest european social network. 100m+ mau",
    role: "product and growth",
    href: "https://vk.com",
    mark: "/images/marks/vk.png",
  },
  {
    company: "skyeng",
    what: "#1 1:1 education platform in europe",
    role: "product and growth",
    href: "https://skyeng.ru",
    mark: "/images/marks/skyeng.png",
  },
] as const;

// The photograph sits on the line it is evidence for, rather than in a strip
// beside the list where the reader has to work out which is which.
const log = [
  {
    text: "5 yo: ukraine's bronze chess champion. blindfold chess child prodigy (sans voir).",
    shot: "/images/childhood-chess.jpg",
    alt: "Dmytro as a small boy at a tournament board, grinning, a row of chess pieces in front of him",
  },
  { text: "6 yo onwards: multiple olympiads winner: math, humanities {later: coding, economics}." },
  { text: "9 yo: best kid actor award." },
  {
    text: "11 yo: wrote my first song. poetry contest winner.",
    shot: "/images/childhood-music.jpg",
    alt: "Dmytro as a child in studio headphones, grinning at a microphone",
  },
  { text: "14 yo: toured neighboring countries as band leader." },
  { text: "19 yo: founded student theatre {director, screenwriter}. 50+ members. 700+ audience for the premiere." },
  { text: "to this day: designing fashion items. writing. doing film photography." },
] as const;

const receipts = [
  {
    src: "time",
    href: "https://time.com/collections/davos-2026/7339222/ai-predictions-2026/",
    line: "“what we care about is people getting happier. whether or not it’s good, it’s happening.”",
    meta: "5 predictions for ai in 2026, davos collection, january 2026",
  },
  {
    src: "princeton",
    href: "https://arxiv.org/abs/2311.10599",
    line: "companion chatbot users indicated that these relationships were beneficial to their social health.",
    meta: "guingrich & graziano, oxford intersections: ai in society, 2025",
  },
] as const;

const title = "dmytro klochko";
const description =
  "ceo at replika. product and engineering, out of art, chess and theatre. based between nyc, paris and sf.";
---

<Layout title={title} description={description} current="home">
  <section class="shell session" id="top" aria-labelledby="s1">
    <div class="card">
      <p class="card-no">01</p>
      <h1 class="card-title" id="s1">dmytro klochko</h1>
      <p class="card-what">
        <a href="https://replika.com" target="_blank" rel="noreferrer">ceo, replika ↗</a>
      </p>
    </div>

    <div class="bay">
      <div>
        <p class="lede">jaywalker at the intersection of art and technology.</p>
        <p class="cathedrals">relentless pursuer. beholder of cathedrals all around.</p>

        <div class="prose">
          <p>
            product &amp; engineering guy with a background in art, chess and theatre. based
            between nyc, paris &amp; sf.
          </p>
        </div>
      </div>

      <figure class="portrait">
        <span class="cell">
          <img
            src="/images/about.jpg"
            alt="Dmytro photographed in a mirror, in a cap and worn denim jacket"
          />
        </span>
        <figcaption><b>01</b> paris, 2025</figcaption>
      </figure>
    </div>
  </section>

  <section class="shell session" id="now" aria-labelledby="s2">
    <div class="card">
      <p class="card-no">02</p>
      <h2 class="card-title" id="s2">replika</h2>
    </div>

    <div class="bay">
      <div>
        <ol class="reg">
          {
            roles.slice(0, 1).map((r) => (
              <li>
                <span class="reg-mark" style={`--mark: url(${r.mark})`} aria-hidden="true" />
                <span class="reg-co">
                  <a href={r.href} target="_blank" rel="noreferrer">
                    {r.company} ↗
                  </a>
                </span>
                <span class="reg-what">{r.what}</span>
                <span class="reg-role">{r.role}</span>
              </li>
            ))
          }
        </ol>

        <p class="lede" style="margin-top: var(--sp-3)">
          i believe ai with real eq can help millions understand themselves and be happier.
        </p>

        <div class="prose">
          <p>i joined as coo and cpo. a year later i was ceo.</p>
          <p>
            replika 2.0 is a ground-up rewrite. i wrote the first prototypes myself and ran 400+
            user interviews. i still write the architecture, the prompts and most of the copy.
          </p>
          <p>
            i rebuilt the team around it: phds, true artists, pirates<img
              class="mark-pirate"
              src="/images/pirate-flag-mark.png"
              alt=""
            />. i'm intense and hands-on, so i don't hire managers.
          </p>
          <p>
            retention skyrocketed. replika is more engaging than at any point in its ten years.
            the next one is in stealth.
          </p>
          <p>
            we run independent research with harvard, stanford and{" "}
            <a href="https://arxiv.org/abs/2311.10599" target="_blank" rel="noreferrer">princeton ↗</a>.
            i am a college dropout who became a lecturer at the university of vienna, to
            understand conversational ai properly and to teach the sociologists, entrepreneurs
            and philosophers coming next.
          </p>
        </div>
      </div>

      <div>
        <div class="decode" aria-hidden="true">
          {mark.map((f: string, i: number) => <pre style={`--i: ${i}`}>{f}</pre>)}
        </div>

        <ul class="receipts receipts--stack">
          {
            receipts.map((r) => (
              <li>
                <a class="receipt-src" href={r.href} target="_blank" rel="noreferrer">
                  {r.src} ↗
                </a>
                <p>{r.line}</p>
                <span>{r.meta}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="shell session" id="before" aria-labelledby="s3">
    <div class="card">
      <p class="card-no">03</p>
      <h2 class="card-title" id="s3">before replika</h2>
    </div>

    <ol class="reg">
      {
        roles.slice(1).map((r) => (
          <li>
            <span class="reg-mark" style={`--mark: url(${r.mark})`} aria-hidden="true" />
            <span class="reg-co">
              {r.href ? (
                <a href={r.href} target="_blank" rel="noreferrer">
                  {r.company} ↗
                </a>
              ) : (
                r.company
              )}
            </span>
            <span class="reg-what">{r.what}</span>
            <span class="reg-role">{r.role}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="shell session" id="origin" aria-labelledby="s4">
    <div class="card">
      <p class="card-no">04</p>
      <h2 class="card-title" id="s4">upbringing</h2>
    </div>

    <p class="lede">
      born &amp; raised in donetsk, eastern ukraine. very poor household. fled war as a teenager.
      slept on the streets for weeks.
    </p>

    <ol class="log log--shots">
      {
        log.map((item) => (
          <li>
            <p>{item.text}</p>
            {item.shot ? (
              <span class="log-shot">
                <img src={item.shot} alt={item.alt} loading="lazy" />
              </span>
            ) : (
              <span />
            )}
          </li>
        ))
      }
    </ol>

    <div class="sheet sheet--one">
      <figure>
        <span class="cell">
          <img
            src="/images/childhood-geese.jpg"
            alt="Dmytro as a toddler running through a garden, laughing, a gaggle of geese behind him"
            loading="lazy"
          />
        </span>
        <figcaption><b>00</b> before all of it</figcaption>
      </figure>
    </div>
  </section>

  <section class="shell session" id="contact" aria-labelledby="s5">
    <div class="card">
      <p class="card-no">05</p>
      <h2 class="card-title" id="s5">say hi</h2>
    </div>

    <div class="bay">
      <div>
        <ul class="ways">
          <li><a href="mailto:1@dmklochko.com">1@dmklochko.com</a> <em>personal</em></li>
          <li><a href="mailto:1@replika.com">1@replika.com</a> <em>replika</em></li>
          <li><a href="https://x.com/dkreplika" target="_blank" rel="noreferrer">@dkreplika ↗</a> <em>x</em></li>
          <li><a href="https://instagram.com/dmytrotoday" target="_blank" rel="noreferrer">@dmytrotoday ↗</a> <em>instagram</em></li>
          <li><a href="https://www.linkedin.com/in/heydmytro/" target="_blank" rel="noreferrer">heydmytro ↗</a> <em>linkedin</em></li>
        </ul>
      </div>


    </div>
  </section>
</Layout>
