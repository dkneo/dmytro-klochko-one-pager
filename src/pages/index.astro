---
import Layout from "../layouts/Layout.astro";
import ExternalLink from "../components/ExternalLink.astro";
import MediaCard from "../components/MediaCard.astro";
import FramedPhoto from "../components/FramedPhoto.astro";
import PhotoFill from "../components/PhotoFill.astro";

type LinkItem = {
  readonly label: string;
  readonly href: string;
};

type MediaLink = LinkItem & {
  readonly video: string;
  readonly alt: string;
  readonly className: string;
};

const upbringing = [
  "5 yo: ukraine's bronze chess champion. blindfold chess child prodigy (sans voir).",
  "6 yo onwards: multiple olympiads winner: math, humanities {later: coding, economics}.",
  "9 yo: best kid actor award.",
  "11 yo: first song. poetry contest winner.",
  "14 yo: toured neighboring countries as band leader.",
  "19 yo: founded student theatre {director, screenwriter}. 50+ members. 700+ audience for the premiere.",
  "to this day: designing fashion items. writing. doing film photography.",
] as const;

// The three featured cards below already link to paris / kbs / vienna,
// so this list only carries what those cards don't.
const watchLinks = [
  { label: "the replika manifesto", href: "https://replika.com/manifesto" },
  { label: "youtube channel (main)", href: "https://youtube.com/@dmytroklochko" },
  { label: "vlog with giorgio", href: "https://www.instagram.com/p/DYm87SroZHJ/" },
  { label: "short reel", href: "https://www.instagram.com/p/DYj9W6yITif/" },
] as const satisfies readonly LinkItem[];

const featuredVlogs = [
  {
    label: "kbs interview (korea)",
    href: "https://www.instagram.com/p/DYhL6c9Ti8M/",
    video: "vlog-kbs",
    alt: "A film crew, lights and two cameras set up around Dmytro for a broadcast interview",
    className: "media-card media-card--portrait",
  },
  {
    label: "vienna",
    href: "https://www.instagram.com/p/DYXLh6rI2JI/",
    video: "vlog-vienna",
    alt: "The opening of Dmytro's Vienna vlog, over the Votivkirche",
    className: "media-card media-card--landscape",
  },
  {
    label: "in paris",
    href: "https://www.instagram.com/p/DYheZtSNZxM/",
    video: "vlog-paris",
    alt: "Dmytro walking toward the camera in front of Les Invalides in Paris",
    className: "media-card media-card--tall",
  },
] as const satisfies readonly MediaLink[];

const contactLinks = [
  { label: "1@dmklochko.com", href: "mailto:1@dmklochko.com" },
  { label: "1@replika.com", href: "mailto:1@replika.com" },
] as const satisfies readonly LinkItem[];

const socialLinks = [
  { label: "x (twitter)", href: "https://x.com/dkreplika" },
  { label: "instagram", href: "https://instagram.com/dmytrotoday" },
  { label: "youtube", href: "https://youtube.com/@dmytroklochko" },
  { label: "linkedin", href: "https://www.linkedin.com/in/heydmytro/" },
] as const satisfies readonly LinkItem[];

const books = [
  "the lord of the rings, j.r.r. tolkien",
  "upstream, mary oliver",
  "gaspard de la nuit, aloysius bertrand (also the ravel suite)",
  "man's search for meaning, viktor frankl",
] as const;

const records = ["rumours, fleetwood mac", "gaspard de la nuit, ravel"] as const;

const title = "dmytro klochko · art & technology";
const description =
  "dmytro klochko: jaywalker at the intersection of art and technology. tech entrepreneur & tinkerer.";
---

<Layout title={title} description={description}>
  <a class="skip-link" href="#main-content"> skip to content </a>

  <header class="site-header" aria-label="primary navigation">
    <a class="say-hi" href="#contact">
      say hi <span aria-hidden="true" class="arrow">↗</span>
    </a>

    <a class="masthead" href="#top" aria-label="dmytro klochko, home">
      <span>dmytro</span> <em>klochko</em>
    </a>

    <details class="menu">
      <summary>menu</summary>
      <nav aria-label="main menu">
        <a href="#about">about</a>
        <a href="#career">career</a>
        <a href="#upbringing">upbringing</a>
        <a href="#watch">watch</a>
        <a href="#taste">taste</a>
        <a href="#contact">contact</a>
      </nav>
    </details>
  </header>

  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-collage" aria-hidden="true">
        <PhotoFill
          class="hero-photo hero-photo--left"
          src="/images/hero-left.jpg"
          alt=""
          eager
        />
        <PhotoFill
          class="hero-photo hero-photo--center"
          src="/images/hero-center.jpg"
          alt=""
          eager
        />
        <PhotoFill class="hero-photo hero-photo--right" src="/images/hero-right.jpg" alt="" />
      </div>

      <div class="hero-copy">
        <h1 id="hero-title">
          jaywalker at the intersection of <em>art and technology.</em>
        </h1>
      </div>

      <span class="scribble scribble--hero" aria-hidden="true"></span>
    </section>

    <section class="about" id="about" aria-labelledby="about-title">
      <div class="about-inner">
        <div class="about-title">
          <h2 id="about-title">about <em>me</em></h2>
          <p>product &amp; engineering guy with a background in art, chess and theatre.</p>
          <p class="about-role">
            <ExternalLink class="role-link" href="https://replika.com" label="ceo, replika" />
          </p>
        </div>
        <PhotoFill
          class="about-photo"
          src="/images/about.jpg"
          alt="Dmytro photographed in a mirror, in a cap and worn denim jacket"
        />
        <p class="about-story">
          relentless pursuer. beholder of cathedrals all around. tech entrepreneur &amp; tinkerer.
        </p>
        <p class="about-note">based between nyc, paris &amp; sf.</p>
      </div>
    </section>

    <section class="before page-shell" id="before" aria-labelledby="before-title">
      <h2 id="before-title">career <em>before</em></h2>
      <div class="before-cols">
        <p>
          first job at 6 yo {"{busking, improv}"}. first filmmaking gig at 13 yo. a hundred gigs and strange little jobs in between.
        </p>
        <p>
          10 years of product management. 6 years building ml-powered products {"{incl. 400m mau products}"}. 5 years hands-on gtm across global ai &amp; social products. former founder.
        </p>
      </div>
    </section>

    <section class="career page-shell" id="career" aria-labelledby="career-title">
      <h2 id="career-title">career <em>now</em></h2>

      <p class="career-lede">
        42m+ users worldwide. the #1 ai friend. research with stanford, harvard, princeton.
      </p>

      <div class="career-main">
        <div class="career-story">
          <p>coo, then cpo, then cto, then ceo, all inside a year. not ambition: the product could be far more than it was.</p>
          <p>
            so i rebuilt it. replika 2.0 is a ground-up rewrite of the app. i wrote the first prototypes myself, ran 400+ user interviews, and still write most of the product copy.
          </p>
          <p>
            i rebuilt the team around it: phds, true artists, pirates. no managers sit between me and the work; everyone reports to me directly.
          </p>
          <p>
            the press was ugly when i arrived. now replika is back in the zeitgeist, making some of the best media in ai.
          </p>
          <p>
            college dropout. i took a lectureship at the university of vienna to grok where conversational agentic ai goes next. teaching it is how i learn it.
          </p>
          <p class="career-note">
            users love 2.0. retention skyrocketed, and replika is more engaging now than at any point in the company's ten years. so naturally i'm already building the next thing, more ambitious.
          </p>
        </div>

        <FramedPhoto
          class="career-art"
          src="/images/dmytro-lecture.png"
          alt="Dmytro presenting Replika product slides to a lecture room"
          caption="teaching"
        />
      </div>

    </section>


    <section class="ways" aria-labelledby="ways-title">
      <div class="page-shell ways-inner">
        <h2 id="ways-title">ways of <em>working</em></h2>
        <div class="ways-grid">
          <p>
            natural aptitude for taste, action bias, &amp; having too much fun shipping.<br />
            clairvoyance, aggressive optimism. following my nose.<br />
            very fucking clean and direct in my comms.
          </p>
          <p>
            culture in my teams is something i'm incredibly proud of: violent intolerance for mediocre work. anime-level fellowship &amp; camaraderie. fearlessness. relentless pursuit of the mission.
          </p>
          <p>
            unhealthy excitement about customers {"{more users in my slack than team members lol}"}. making my product feel like magic. extensive experience working with the world's best brand agencies.
          </p>
        </div>
      </div>
    </section>

    <section class="upbringing page-shell" id="upbringing" aria-labelledby="upbringing-title">
      <div class="upbringing-heading">
        <h2 id="upbringing-title">upbringing</h2>
      </div>

      <p class="upbringing-lede">
        born &amp; raised in donetsk, eastern ukraine. very poor household. fled war as a teenager. slept on the streets for weeks.
      </p>

      <ol class="timeline">
        {upbringing.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{item}</p>
          </li>
        ))}
      </ol>

      <div class="childhood-collage">
        <FramedPhoto
          class="childhood-photo childhood-photo--chess"
          src="/images/childhood-chess.jpg"
          alt="Dmytro as a small boy leaning over a chess board mid-game"
          caption="first obsession"
        />
        <FramedPhoto
          class="childhood-photo childhood-photo--piano"
          src="/images/childhood-music.jpg"
          alt="Dmytro as a child in studio headphones, grinning at a microphone"
          caption="second obsession"
        />
        <FramedPhoto
          class="childhood-photo childhood-photo--now"
          src="/images/now.jpg"
          alt="Dmytro stretched out in a striped deckchair in a London park"
          caption="now"
        />
        <span class="hand-arrow" aria-hidden="true">↗</span>
      </div>
    </section>

    <section class="watch page-shell" id="watch" aria-labelledby="watch-title">
      <div class="watch-heading">
        <h2 id="watch-title">watch &amp; <em>listen</em></h2>
        <p>field notes, interviews and conversations from everywhere.</p>
      </div>

      <div class="media-grid">
        {featuredVlogs.map((item) => (
          <MediaCard
            href={item.href}
            video={item.video}
            alt={item.alt}
            label={item.label}
            class={item.className}
          />
        ))}
      </div>

      <div class="press-feature">
        <FramedPhoto
          class="press-interview"
          src="/images/interview-connection.jpg"
          alt="Dmytro mid-sentence during a filmed interview, boom microphone overhead"
        />
        <div class="press-copy">
          <h3>finding connection.</h3>
          <p class="press-caption">poetry, the human condition, and making technology feel a little more alive.</p>
          <p class="press-meta">a documentary at cph:dox, copenhagen 2026.</p>
        </div>
      </div>

      <div class="watch-links" aria-label="more to read and watch">
        {watchLinks.map((item, index) => (
          <ExternalLink
            class="text-link"
            href={item.href}
            label={`${String(index + 1).padStart(2, "0")} / ${item.label}`}
          />
        ))}
      </div>
    </section>

    <section class="personal" id="taste" aria-labelledby="taste-title">
      <div class="page-shell personal-inner">
        <div class="personal-heading">
          <h2 id="taste-title"><em>taste.</em></h2>
          <div class="swatches" aria-label="favorite colors">
            <span style="background: #a7cbe8"></span>
            <span style="background: #6b7648"></span>
            <span style="background: #d7a1bb"></span>
            <span style="background: #90672d"></span>
            <span style="background: #202f62"></span>
          </div>
        </div>

        <div class="shelf-grid">
          <div class="shelf-list">
            <h3>books</h3>
            <ol>
              {books.map((book) => <li>{book}</li>)}
            </ol>
          </div>
          <div class="shelf-list">
            <h3>records</h3>
            <ol>
              {records.map((record) => <li>{record}</li>)}
            </ol>
          </div>
          <FramedPhoto
            class="museum-photo"
            src="/images/taste-museum.jpg"
            alt="Dmytro standing in a gallery in front of a large Monet water lilies canvas"
          />
        </div>

        <div class="poems" aria-labelledby="poems-title">
          <h3 id="poems-title">poems</h3>
          <blockquote class="poem poem--one">
            <p>
              i am lost in sorrento<br />
              for i am the taste of its lemons and its women's feet<br />
              i'm the salt of its breeze<br />
              i'm so glad i can't breathe<br />
              i'm so tall i am whole twelve feet
            </p>
          </blockquote>
          <blockquote class="poem poem--two">
            <p>
              this girl is the warm sensation of young sun on my bare chest<br />
              her chestnut irises, and the greens in them, glimmer with playful unrest<br />
              when she whispers her spells, her tricks, and her promises, i couldn't get any slumber<br />
              for she carries inside her an eternal summer, an eternal summer
            </p>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="social" id="contact" aria-labelledby="social-title">
      <div class="page-shell social-inner">
        <h2 id="social-title">come say <em>hi.</em></h2>

        <PhotoFill class="social-cutout" src="/images/dmytro-cutout.png" alt="" hidden />
        <PhotoFill class="social-reading" src="/images/dmytro-reading-cutout.png" alt="" hidden />

        <div class="social-links">
          {contactLinks.map((item) => (
            <ExternalLink class="text-link" href={item.href} label={item.label} />
          ))}
          {socialLinks.map((item) => (
            <ExternalLink class="text-link" href={item.href} label={item.label} />
          ))}
        </div>
        <span class="scribble scribble--social" aria-hidden="true"></span>
      </div>

      <footer class="page-shell footer">
        <p>© 2026 dmytro klochko</p>
        <p>art × technology</p>
        <a class="to-top" href="#top">
          back to top <span aria-hidden="true" class="arrow">↑</span>
        </a>
      </footer>
    </section>
  </main>
</Layout>
