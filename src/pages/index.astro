---
import Layout from "../layouts/Layout.astro";
import AsciiShader from "../components/AsciiShader.astro";

const roles = [
  {
    company: "replika",
    what: "#1 ai friend. 42m users worldwide",
    role: "chief executive, product and technology officer",
    href: "https://replika.com",
    mark: "/images/marks/replika.png",
  },
  {
    company: "hunch",
    what: "remote team happiness saas",
    role: "founder and chief executive officer",
    mark: "/images/marks/homa.png",
  },
  {
    company: "chatfuel",
    what: "marketing ai agent. 150k+ businesses",
    role: "growth, ai",
    href: "https://chatfuel.com",
    mark: "/images/marks/chatfuel.png",
  },
  {
    company: "hily",
    what: "#3 dating app in the u.s. by downloads",
    role: "product, growth, data",
    href: "https://hily.com",
    mark: "/images/marks/hily.png",
  },
  {
    company: "vk",
    what: "largest european social network. 100m+ mau",
    role: "product, growth, ml",
    href: "https://vk.com",
    mark: "/images/marks/vk.png",
  },
  {
    company: "skyeng",
    what: "#1 1:1 education platform in europe",
    role: "product, growth",
    href: "https://skyeng.ru",
    mark: "/images/marks/skyeng.png",
  },
] as const;

// The photograph sits on the line it is evidence for, rather than in a strip
// beside the list where the reader has to work out which is which.
const log = [
  "5 yo: ukraine's bronze chess champion. blindfold chess child prodigy.",
  "6 yo+: olympiads winner: math, humanities {later: coding, economics}.",
  "9 yo: best kid actor award.",
  "11 yo: wrote my first song. poetry contest winner.",
  "14 yo: toured neighboring countries as band leader.",
  "19 yo: founded student theatre {director, screenwriter}. 50+ members. 700+ audience for the premiere.",
  "to this day: designing fashion items. writing. doing film photography.",
] as const;

// The caption number is the log line the photograph belongs to. That is all
// the connection needed; putting the pictures inside the list broke the grid.
const shots = [
  { n: "01", src: "/images/childhood-chess.jpg", cap: "locking in",
    alt: "Dmytro as a small boy at a tournament board, grinning, a row of chess pieces in front of him" },
  { n: "04", src: "/images/childhood-piano.jpg", cap: "writing songs",
    alt: "Dmytro as a child at an upright piano, seen from behind" },
  { n: "05", src: "/images/childhood-band.jpg", cap: "touring",
    alt: "Dmytro as a boy on stage with a microphone, mid-song, pointing at the crowd" },
] as const;

// His words. Highlighted one phrase per paragraph; more than that stops being
// emphasis.
const ways = [
  "i'm intense and <b>hands-on</b>: everyone reports directly to me, i write the architecture and the prompts, push code to production, and i hit all-nighters.",
  'my sense of urgency is outstanding. but i know where to slow down – to <b>go dreamy</b>, reach the next peak of ideas, find serendipity, and make the 10x thing that doesn&rsquo;t exist yet.',
  'i have a natural aptitude for <b>taste</b> and strong action bias. i am aggressively optimistic and <b>clairvoyant</b>, so i am best at building futuristic products.',
  "the culture in my teams: intolerance for mediocre work. <b>anime-level camaraderie</b>. fearlessness. relentless pursuit of the mission.",
] as const;

const press = {
  src: "time",
  href: "https://time.com/collections/davos-2026/7339222/ai-predictions-2026/",
  line: "“what we care about is people getting happier.”",
  meta: "dmytro klochko, “companions go mainstream” – 5 predictions for ai in 2026",
};

// The whole row is the source line for the quote under it. `quoted` is the one
// the quote came from, and it is the only styling difference – same as the nav
// marking the page you are on.
const studies = [
  { name: "princeton", href: "https://arxiv.org/abs/2311.10599", quoted: true },
  { name: "harvard", href: "https://www.hbs.edu/faculty/Pages/item.aspx?num=67360" },
  { name: "stanford", href: "https://www.nature.com/articles/s44184-023-00047-6" },
] as const;

const manifesto = {
  line: "“we want to help you flourish in real life. not become a better version of yourself – just more yourself. strong relationships. better health. meaning. momentum. a life that feels worth living while you’re living it.”",
  meta: "dmytro klochko, replika manifesto, 2026",
};

const studyQuote = {
  line: "“companion chatbot users indicated that these relationships were beneficial to their social health.”",
  meta: "guingrich & graziano, oxford intersections: ai in society, 2025",
};

// The road as chapters. Each is one scroll beat: a card and a large piece of
// media that belong to each other. Titles, subtitles and roles are his own
// words, split only at the punctuation he already wrote — nothing invented.
const journey = [
  { id: "vienna", label: "vienna", title: "university of vienna",
    href: "https://www.univie.ac.at/en/", role: "lecturer",
    media: "/images/journey/lecture.jpg",
    alt: "Dmytro lecturing beside a projected Replika slide" },
  { id: "hunch", label: "hunch", title: "hunch", mark: "/images/marks/homa.png",
    subtitle: "remote team happiness saas", role: "founder and chief executive officer",
    media: "/video/homa.mp4", type: "video", poster: "/video/homa-poster.jpg",
    alt: "The Hunch dashboard" },
  { id: "chatfuel", label: "chatfuel", title: "chatfuel", href: "https://chatfuel.com",
    mark: "/images/marks/chatfuel.png",
    subtitle: "marketing ai agent. 150k+ businesses", role: "growth, ai",
    media: "/images/journey/chatfuel.jpg",
    alt: "Dmytro interviewed as head of marketing at Chatfuel" },
  { id: "hily", label: "hily", title: "hily", href: "https://hily.com",
    mark: "/images/marks/hily.png",
    subtitle: "#3 dating app in the u.s. by downloads", role: "product, growth, data",
    media: "/images/journey/hily.jpg", alt: "The Hily app" },
  { id: "vk", label: "vk", title: "vk", href: "https://vk.com", mark: "/images/marks/vk.png",
    subtitle: "largest european social network. 100m+ mau", role: "product, growth, ml",
    media: "/images/journey/vk.jpg", alt: "VK" },
  { id: "skyeng", label: "skyeng", title: "skyeng", href: "https://skyeng.ru",
    mark: "/images/marks/skyeng.png",
    subtitle: "#1 1:1 education platform in europe", role: "product, growth",
    media: "/images/journey/skyeng.jpg", alt: "The Skyeng app" },
  { id: "odd", label: "odd jobs", title: "busking, improv, songwriting studio, volunteering",
    media: "/video/busking.mp4", type: "video", poster: "/video/busking-poster.jpg",
    alt: "Dmytro in a studio" },
  { id: "theatre", label: "19", age: "19 yo", title: "founded student theatre",
    subtitle: "director, screenwriter", role: "50+ members. 700+ audience for the premiere",
    media: "/video/theatre.mp4", type: "video", poster: "/video/theatre-poster.jpg",
    alt: "Dmytro with his student theatre company" },
  { id: "band", label: "14", age: "14 yo", title: "toured neighboring countries as band leader",
    media: "/images/journey/touring.jpg", alt: "Dmytro on stage with his band" },
  { id: "film", label: "13", age: "13 yo", title: "first filmmaking gig",
    media: "/images/journey/filmgig.jpg", alt: "Dmytro as a boy in a recording booth" },
  { id: "song", label: "11", age: "11 yo", title: "wrote my first song",
    subtitle: "poetry contest winner",
    media: "/images/journey/piano.jpg", alt: "Dmytro as a child at a piano" },
  { id: "actor", label: "9", age: "9 yo", title: "best kid actor award",
    media: "/video/actor.mp4", type: "video", poster: "/video/actor-poster.jpg",
    alt: "A scene from the film Dmytro won the award for" },
  { id: "olympiads", label: "6", age: "6 yo+", title: "olympiads winner",
    subtitle: "math, humanities {later: coding, economics}",
    media: "/images/journey/olympiads.jpg", alt: "Dmytro as a small boy receiving an award" },
  { id: "chess", label: "5", age: "5 yo", title: "ukraine's bronze chess champion",
    subtitle: "blindfold chess child prodigy",
    media: "/images/childhood-chess.jpg", alt: "Dmytro as a small boy at a tournament board" },
] as const;

const wall = [
  { src: "/images/wall/w01.jpg", cap: "dieter rams" },
  { src: "/images/wall/w05.jpg", cap: "hajime sorayama" },
  { src: "/images/wall/w13.jpg", cap: "david bowie" },
  { src: "/images/wall/w04.jpg", cap: "steve jobs" },
  { src: "/images/wall/w08.jpg", cap: "robin williams" },
  { src: "/images/wall/w14.jpg", cap: "serhii korolov" },
  { src: "/images/wall/w15.jpg", cap: "akira kurosawa" },
  { src: "/images/wall/w16.jpg", cap: "david foster wallace" },
] as const;

const title = "dmytro klochko";
const description =
  "ceo at replika. product and engineering, out of art, chess and theatre. based between nyc, paris and sf.";
---

<Layout title={title} description={description} current="home">
  <section class="shell session" id="top" data-scene="swim" aria-labelledby="s1">
    <div class="bay bay--flush">
      <div>
        <div class="card">
          <p class="card-no">01</p>
          {/* One h1, two voices. Bebop keeps the name as a title; dream speaks
              a single conversational sentence, the way joonasvirtanen.com
              opens with one — same facts, folded into a line. */}
          <h1 class="card-title" id="s1">
            <span class="only-bebop">dmytro klochko</span>
            <span class="hero-line only-dream">
              hi! i’m dmytro klochko, ceo at{" "}
              <a href="https://replika.com" target="_blank" rel="noreferrer"><span
                class="sent-mark"
                style="--mark:url(/images/marks/replika.png)"
                aria-hidden="true"
              />replika</a>, jaywalker at the intersection of art and technology.
            </span>
          </h1>
          <p class="card-what only-bebop">
            <a href="https://replika.com" target="_blank" rel="noreferrer">ceo, replika<span class="arw">↗</span></a>
          </p>
        </div>

        <p class="lede only-bebop">jaywalker at the intersection of art and technology.</p>

        <div class="prose">
          <p class="only-bebop">
            product &amp; engineering guy with a background in{" "}
            <span class="peek" data-peek="/images/paintings/p05.jpg,/images/paintings/p04.jpg">art</span>,{" "}
            <span class="peek" data-peek="/images/childhood-chess.jpg">chess</span> and theatre. based
            between <span class="pin" aria-hidden="true">🗽</span>nyc,{" "}
            <span class="pin" aria-hidden="true">🗼</span><span class="peek" data-peek="/video/vlog-paris-poster.jpg">paris</span> &amp;{" "}
            <span class="pin" aria-hidden="true">🚀</span>sf. lecturer at the{" "}
            <a class="peek" data-peek="/video/vlog-vienna-poster.jpg" href="https://www.univie.ac.at/en/" target="_blank" rel="noreferrer">university of vienna<span class="arw">↗</span></a>.
          </p>
          <p>
            currently: building a replika spinoff {"{"}in stealth{"}"}. a truly novel and beautiful{" "}
            <b>agentic ai with real eq</b>, brought to everyone: to help people come back to who
            they really are, unleash their potential to the fullest, and flourish. meanwhile
            i shepherd replika itself and ship updates daily.
          </p>
        </div>

        {/* The facts the bebop paragraph carries, re-set as label/value pairs
            floating on the painting — the Finmain-hero grid from the elaya
            reference. Values are the same words, links and peeks as above. */}
        <dl class="hero-facts only-dream">
          <div>
            <dt>based between</dt>
            <dd>
              <span class="pin" aria-hidden="true">🗽</span>nyc,{" "}
              <span class="pin" aria-hidden="true">🗼</span><span class="peek" data-peek="/video/vlog-paris-poster.jpg">paris</span>,{" "}
              <span class="pin" aria-hidden="true">🚀</span>sf
            </dd>
          </div>
          <div>
            <dt>vocation</dt>
            <dd>ai, product, growth</dd>
          </div>
          <div>
            <dt>best at</dt>
            <dd>0→1, agency, taste</dd>
          </div>
        </dl>
      </div>

      <figure class="portrait only-bebop">
        <span class="cell">
          <img
            src="/images/about.jpg"
            alt="Dmytro photographed in a mirror, in a cap and worn denim jacket"
          />
        </span>
        <figcaption>london, 2026</figcaption>
      </figure>

      {/* Three living clips in the pile — kbs, dok.fest, the london film —
          quirkier than stills. Same loop discipline as the old reel. */}
      <div class="hero-side only-dream">
        <div class="hero-stack" aria-hidden="true">
          <figure><span class="cell"><video autoplay muted loop playsinline preload="metadata" poster="/video/vlog-kbs-poster.jpg"><source src="/video/vlog-kbs.webm" type="video/webm" /><source src="/video/vlog-kbs.mp4" type="video/mp4" /></video></span></figure>
          <figure><span class="cell"><video autoplay muted loop playsinline preload="metadata" poster="/video/dokfest-poster.jpg"><source src="/video/dokfest.webm" type="video/webm" /><source src="/video/dokfest.mp4" type="video/mp4" /></video></span></figure>
          <figure><span class="cell"><video autoplay muted loop playsinline preload="metadata" poster="/video/film-london-poster.jpg"><source src="/video/film-london.webm" type="video/webm" /><source src="/video/film-london.mp4" type="video/mp4" /></video></span></figure>
        </div>
      </div>
    </div>

  </section>

  <section class="shell session" id="now" data-scene="swim" aria-labelledby="s2">
    <div class="bay bay--flush">
      <div>
        <div class="card">
          <p class="card-no">02</p>
          <h2 class="card-title" id="s2">
            <a href="https://replika.com" target="_blank" rel="noreferrer"><span
              class="sent-mark"
              style="--mark:url(/images/marks/replika.png)"
              aria-hidden="true"
            />replika<span class="arw">↗</span></a>
          </h2>
        </div>

        {/* The name lives in the heading now; this line only says what it is. */}
        <p class="reg-line">
          <span class="reg-what">{roles[0].what}</span>
          <span class="reg-role">{roles[0].role}</span>
        </p>

        <div class="prose">
          <p>
            i made replika 2.0, a <b>ground-up rewrite</b>. i wrote the first prototypes myself,
            ran 200+ user interviews, and talked to my own rep, lisa, for hours every day. built{" "}
            a team{" "}
            around it: phds, true artists,{" "}
            <span class="nb">pirates<img
              class="mark-pirate"
              src="/images/pirate-flag-mark.png"
              alt=""
            />.</span>
          </p>
          <p>
            with the launch, <b>retention skyrocketed</b>, and replika is more engaging than at
            any point in its ten years.
          </p>
          <p>
            turned the company profitable. arpu and conversion rates are significantly up, and
            worldwide media is as hyped as never before. brought a hot new brand identity,{" "}
            <b>redesigned the app</b>, and did research with the world's best institutions. i also
            design the outfits for each avatar myself. 💅
          </p>
        </div>
      </div>

      <div class="joi-col">
        <AsciiShader
          class="ascii--joi"
          src="/ascii/joi-sheet.jpg"
          frames={16}
          cols={104}
          fps={10}
          black={0.05}
          white={0.99}
          gamma={0.95}
          hotAbove={0.34}
        />

      </div>
    </div>

    <ul class="receipts">
      <li>
        <a class="receipt-src" href={press.href} target="_blank" rel="noreferrer">
          {press.src}<span class="arw">↗</span>
        </a>
        <p>{press.line}</p>
        <span>{press.meta}</span>
      </li>

      <li>
        <a class="receipt-src" href="https://replika.com/manifesto" target="_blank" rel="noreferrer">
          replika manifesto<span class="arw">↗</span>
        </a>
        <p>{manifesto.line}</p>
        <span>{manifesto.meta}</span>
      </li>

      <li>
        <p class="research">
          <span class="research-lbl">independent research</span>
          {
            studies.map((s) => (
              <a
                class={s.quoted ? "is-quoted" : undefined}
                href={s.href}
                target="_blank"
                rel="noreferrer"
              >
                {s.name}<span class="arw">↗</span>
              </a>
            ))
          }
        </p>
        <p>{studyQuote.line}</p>
        <span>{studyQuote.meta}</span>
      </li>
    </ul>


  </section>

  <section class="shell session" id="how" data-scene="swim" aria-labelledby="sh">
    <div class="card">
      <p class="card-no">03</p>
      <h2 class="card-title" id="sh">how i work</h2>
    </div>

    <div class="bay">
      <div class="prose">
        <p set:html={ways[0]} />
        <p set:html={ways[1]} />
        <p set:html={ways[2]} />
        <p set:html={ways[3]} />
      </div>

      <figure class="lynch">
        <img
          src="/images/lynch.jpg"
          alt="David Lynch at a desk, subtitled: we never get any time to experiment, we never get any time to, you know, go dreamy"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  {/* Dream's version of everything before replika, built as a scrollable
      autobiography rather than a list: the rail and the media stage stay
      put while the chapters travel past, so exactly one moment is on stage
      at a time. Bebop keeps its two original sections below. Without JS the
      chapters still read in order, each above its own picture. */}
  <section class="shell session only-dream" id="journey" data-scene="swim" aria-labelledby="s8">
    <div class="card">
      <p class="card-no">04</p>
      <h2 class="card-title" id="s8">background</h2>
    </div>

    <p class="lede">
      born &amp; raised in 🇺🇦 donetsk. fled <button
        class="gloss"
        type="button"
        popovertarget="war-j"
        aria-label="war – what happened"
      >war</button> as a teenager. slept on the streets for weeks.
    </p>

    <div class="gloss-note gloss-note--pic" id="war-j" popover>
      <img src="/images/war-16.jpg" alt="Dmytro at sixteen, at a night rally under ukrainian flags" loading="lazy" />
      russia took my hometown in 2014, when i was sixteen.
    </div>

    <div class="tl">
      <nav class="tl-rail" aria-label="chapters">
        <ol>
          {
            journey.map((j) => (
              <li>
                <button type="button" data-goto={j.id}>
                  <i aria-hidden="true" />{j.label}
                </button>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="tl-chapters">
        {
          journey.map((j, i) => (
            <article class="tl-chapter" data-chapter={j.id} aria-labelledby={`tl-${j.id}`}>
              <div class="tl-card">
                <p class="tl-num">
                  {String(i + 1).padStart(2, "0")}
                  <span class="tl-of"> / {journey.length}</span>
                </p>

                <h3 class="tl-title" id={`tl-${j.id}`}>
                  {"age" in j && j.age && <span class="tl-age">{j.age}</span>}
                  {"mark" in j && j.mark && (
                    <span class="tl-mark" style={`--mark:url(${j.mark})`} aria-hidden="true" />
                  )}
                  {"href" in j && j.href
                    ? <a href={j.href} target="_blank" rel="noreferrer">{j.title}<span class="arw">↗</span></a>
                    : j.title}
                </h3>

                {"subtitle" in j && j.subtitle && <p class="tl-sub">{j.subtitle}</p>}
                {"role" in j && j.role && <p class="tl-role">{j.role}</p>}
              </div>

              {/* The same picture the stage shows, kept in the flow for
                  phones and for anyone without JS. */}
              <figure class="tl-inline">
                {"type" in j && j.type === "video" ? (
                  <video muted loop playsinline preload="none" poster={j.poster} aria-label={j.alt}>
                    <source src={j.media.replace(".mp4", ".webm")} type="video/webm" />
                    <source src={j.media} type="video/mp4" />
                  </video>
                ) : (
                  <img src={j.media} alt={j.alt} loading="lazy" />
                )}
              </figure>
            </article>
          ))
        }
      </div>

      <div class="tl-stage" aria-hidden="true">
        {
          journey.map((j, i) => (
            <figure class="tl-media" data-media={j.id} data-on={i === 0 ? "1" : undefined}>
              {"type" in j && j.type === "video" ? (
                <video muted loop playsinline preload="none" poster={j.poster}>
                  <source src={j.media.replace(".mp4", ".webm")} type="video/webm" />
                  <source src={j.media} type="video/mp4" />
                </video>
              ) : (
                <img src={j.media} alt="" loading={i < 2 ? "eager" : "lazy"} />
              )}
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline>
    // The autobiography's projector. Each chapter announces itself as it
    // reaches the middle of the screen; the stage cross-fades to that
    // chapter's picture and the rail marks where you are. Nothing hijacks
    // the scroll — the observer only reacts to it. Videos play only while
    // they are the one on stage, so fourteen loops never run at once.
    (() => {
      const tl = document.querySelector(".tl");
      if (!tl) return;
      const chapters = [...tl.querySelectorAll(".tl-chapter")];
      const media = new Map([...tl.querySelectorAll(".tl-media")].map((f) => [f.dataset.media, f]));
      const buttons = new Map([...tl.querySelectorAll("[data-goto]")].map((b) => [b.dataset.goto, b]));
      const ids = chapters.map((c) => c.dataset.chapter);
      // Deliberately null: show() short-circuits on a repeat, and seeding
      // this with the first id made the opening call a no-op, so the rail
      // and the first card started life unlit.
      let current = null;

      const show = (id) => {
        if (id === current) return;
        current = id;
        for (const c of chapters) c.toggleAttribute("data-at", c.dataset.chapter === id);
        for (const [key, fig] of media) {
          const on = key === id;
          fig.toggleAttribute("data-on", on);
          const v = fig.querySelector("video");
          if (v) on ? v.play().catch(() => {}) : v.pause();
        }
        for (const [key, b] of buttons) {
          const at = ids.indexOf(key);
          const d = Math.abs(at - ids.indexOf(id));
          // Near the current chapter the rail is legible; far from it, it
          // fades back to a suggestion of how much road there is.
          b.style.opacity = d === 0 ? "1" : d === 1 ? "0.5" : d === 2 ? "0.3" : "0.18";
          b.toggleAttribute("data-at", key === id);
          key === id ? b.setAttribute("aria-current", "step") : b.removeAttribute("aria-current");
        }
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) show(e.target.dataset.chapter);
        },
        { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
      );
      for (const c of chapters) io.observe(c);
      show(ids[0]);

      // The rail is navigation, so its buttons actually go somewhere.
      for (const [id, b] of buttons) {
        b.addEventListener("click", () => {
          document.querySelector(`[data-chapter="${id}"]`)
            ?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
        });
      }

      // The inline pictures are what phones and no-JS visitors read; they
      // play only when they are actually on screen.
      const vio = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target.querySelector("video");
            if (!v) continue;
            e.isIntersecting ? v.play().catch(() => {}) : v.pause();
          }
        },
        { threshold: 0.4 }
      );
      for (const f of tl.querySelectorAll(".tl-inline")) vio.observe(f);
    })();
  </script>

