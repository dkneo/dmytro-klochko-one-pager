---
import Layout from "../layouts/Layout.astro";
import data from "../data/today.json";

// Every chord ships in the markup and one is revealed by date, because the
// site is static assets: a build-time pick would freeze whatever day it was
// deployed on. Only the chosen painting gets a src, so the rest never load.
const chords = data.chords;

const title = "today · dmytro klochko";
const description =
  "a painting, a poem, a line and a song. one a day, chosen so the four agree.";
---

<Layout title={title} description={description} current="home" scenes={["nightcourt"]}>
  <section class="shell session today" data-scene="nightcourt" aria-labelledby="td">
    <div class="card">
      <h1 class="card-title" id="td">today</h1>
    </div>

    <p class="lede">
      four things a day, from one collection: a painting, a poem, a line and a
      song.
    </p>

    <p class="today-how">
      they are not picked separately. every day has a weather, and the four are
      chosen because they agree about it, so the painting and the poem and the
      line are the same thought arriving four ways. today’s is
      <b class="today-weather"></b><span class="today-weather-note"></span>
    </p>

    {
      chords.map((c, i) => (
        <article class="chord" data-i={i} data-weather={c.weather} hidden>
          {/* ── the painting ── */}
          <section class="bit bit--art" aria-label="the painting">
            <figure class="chord-art">
              <img
                data-src={c.painting.src}
                alt={`${c.painting.title}, ${c.painting.who}`}
                width="1500"
                height="1000"
                decoding="async"
              />
            </figure>
            <p class="bit-title">
              <b>{c.painting.who}</b>
              <i>{c.painting.title}</i>
            </p>
            <p class="bit-where">
              {c.painting.year} · {c.painting.where} ·{" "}
              <a href={c.painting.source} target="_blank" rel="noreferrer">
                source<span class="arw">↗</span>
              </a>
            </p>
            {c.painting.note && <p class="chord-note">{c.painting.note}</p>}
            <p class="bit-share">
              <button type="button" data-post="painting">post the painting<span class="arw" aria-hidden="true">↗</span></button>
              <button type="button" data-story="painting">save a story<span class="arw" aria-hidden="true">↓</span></button>
            </p>
          </section>

          {/* ── the line ── */}
          <section class="bit" aria-label="the line">
            <p class="bit-label">the line</p>
            <blockquote class="chord-quote">
              <p class="chord-line">{c.quote.english}</p>
              {c.quote.english !== c.quote.text && (
                <p class="chord-original">{c.quote.text}</p>
              )}
              <cite>{c.quote.who}<span>{c.quote.where}</span></cite>
            </blockquote>
            <p class="bit-share">
              <button type="button" data-post="quote">post the line<span class="arw" aria-hidden="true">↗</span></button>
              <button type="button" data-story="quote">save a story<span class="arw" aria-hidden="true">↓</span></button>
            </p>
          </section>

          {/* ── the poem ── */}
          <section class="bit" aria-label="the poem">
            <p class="bit-label">the poem</p>
            <p class="chord-verse">{c.poem.english || c.poem.text}</p>
            {c.poem.english && c.poem.english !== c.poem.text && (
              <p class="chord-verse chord-verse--orig">{c.poem.text}</p>
            )}
            <p class="bit-where">
              <b>{c.poem.who}</b>{c.poem.where}
              {c.poem.roman && <em>{c.poem.roman}</em>}
            </p>
            {c.poem.note && <p class="chord-note">{c.poem.note}</p>}
            <p class="bit-share">
              <button type="button" data-post="poem">post the poem<span class="arw" aria-hidden="true">↗</span></button>
              <button type="button" data-story="poem">save a story<span class="arw" aria-hidden="true">↓</span></button>
            </p>
          </section>

          {/* ── the song ── */}
          {c.song && (
            <section class="bit" aria-label="the song">
              <p class="bit-label">the song</p>
              <p class="chord-song">
                <b>{c.song.title}</b>
                <span>{c.song.who}, {c.song.year}</span>
              </p>
              <p class="song-links">
                <a href={c.song.youtube} target="_blank" rel="noreferrer">youtube<span class="arw">↗</span></a>
                <a href={c.song.spotify} target="_blank" rel="noreferrer">spotify<span class="arw">↗</span></a>
              </p>
              {c.song.note && <p class="chord-note">{c.song.note}</p>}
              <p class="bit-share">
                <button type="button" data-post="song">post the song<span class="arw" aria-hidden="true">↗</span></button>
              </p>
            </section>
          )}
        </article>
      ))
    }

    <p class="chord-when">
      <span class="today-date"></span> · from
      <a href="/map">the collection</a>
    </p>

    <canvas class="story-canvas" width="1080" height="1920" hidden></canvas>
  </section>

  <script is:inline define:vars={{ chords, weathers: data.weathers }}>
    (() => {
      const root = document.querySelector(".today");
      if (!root) return;
      const cards = [...root.querySelectorAll(".chord")];

      // The same chord for everyone on the same calendar day, so a link you
      // send points at what you were looking at. Days counted in UTC.
      const now = new Date();
      const day = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000);
      const at = ((day % cards.length) + cards.length) % cards.length;

      const card = cards[at];
      const chord = chords[at];
      const img = card.querySelector("img");
      img.src = img.dataset.src;
      card.hidden = false;

      root.querySelector(".today-date").textContent = now.toLocaleDateString("en-GB", {
        day: "numeric", month: "long", year: "numeric",
      }).toLowerCase();
      root.querySelector(".today-weather").textContent = chord.weather;
      const wnote = (weathers.find((w) => w.name === chord.weather) || {}).note;
      if (wnote) root.querySelector(".today-weather-note").textContent = ": " + wnote;

      const URL_ = "https://dmklochko.com/today";

      // What each part says when it goes out on its own.
      const posts = {
        painting: () =>
          `the painting of the day: ${chord.painting.who}, ${chord.painting.title}, ${chord.painting.year}.`,
        quote: () => `“${chord.quote.english}”\n— ${chord.quote.who}`,
        poem: () => {
          const t = (chord.poem.english || chord.poem.text).split("\n").slice(0, 4).join("\n");
          return `${t}\n— ${chord.poem.who}`;
        },
        song: () => `the song of the day: ${chord.song.title}, ${chord.song.who}.`,
      };

      for (const b of card.querySelectorAll("[data-post]")) {
        b.addEventListener("click", () => {
          open("https://twitter.com/intent/tweet?text=" + encodeURIComponent(posts[b.dataset.post]()) +
               "&url=" + encodeURIComponent(URL_), "_blank", "noopener");
        });
      }

      // The story is drawn here rather than fetched: the page already has the
      // painting and the font, so the card costs one canvas and no network.
      const stories = {
        painting: () => ({ big: chord.painting.title, small: `${chord.painting.who}, ${chord.painting.year}` }),
        quote: () => ({ big: "“" + chord.quote.english + "”", small: chord.quote.who }),
        poem: () => ({
          big: (chord.poem.english || chord.poem.text).split("\n").slice(0, 5).join("\n"),
          small: chord.poem.who,
        }),
      };

      for (const b of card.querySelectorAll("[data-story]")) {
        b.addEventListener("click", async () => {
          const { big, small } = stories[b.dataset.story]();
          const cv = root.querySelector(".story-canvas");
          const g = cv.getContext("2d");
          const W = cv.width, H = cv.height;

          try { await document.fonts.load("300 74px Zodiak"); } catch {}
          try { await document.fonts.load("400 26px 'JetBrains Mono'"); } catch {}

          const s = Math.max(W / img.naturalWidth, H / img.naturalHeight);
          const w = img.naturalWidth * s, h = img.naturalHeight * s;
          g.fillStyle = "#131a2b";
          g.fillRect(0, 0, W, H);
          g.drawImage(img, (W - w) / 2, (H - h) * 0.34, w, h);

          // the site's own smoked glass, not a slab over the art
          g.fillStyle = "rgba(16, 20, 34, 0.46)";
          g.fillRect(0, 0, W, H);
          const grad = g.createLinearGradient(0, H * 0.35, 0, H);
          grad.addColorStop(0, "rgba(12, 16, 28, 0)");
          grad.addColorStop(1, "rgba(12, 16, 28, 0.78)");
          g.fillStyle = grad;
          g.fillRect(0, 0, W, H);

          const pad = 96;
          const wrap = (text, font, max) => {
            g.font = font;
            const out = [];
            for (const para of text.split("\n")) {
              let cur = "";
              for (const word of para.split(" ")) {
                const t = cur ? cur + " " + word : word;
                if (g.measureText(t).width > max && cur) { out.push(cur); cur = word; }
                else cur = t;
              }
              out.push(cur);
            }
            return out;
          };

          const size = big.length > 150 ? 50 : big.length > 120 ? 58 : big.length > 70 ? 68 : 78;
          const lines = wrap(big, `300 ${size}px Zodiak, Georgia, serif`, W - pad * 2);
          const lead = size * 1.28;
          let y = H - pad - 150 - lines.length * lead;

          g.fillStyle = "#ece6d9";
          g.textBaseline = "top";
          for (const l of lines) { g.fillText(l, pad, y); y += lead; }

          y += 26;
          g.font = "400 30px 'JetBrains Mono', ui-monospace, monospace";
          g.fillStyle = "#ff9bc0";
          g.fillText(small.toLowerCase(), pad, y);

          // Stacked rather than set at both ends: a long painting title and
          // the url were running into each other in the middle.
          g.font = "400 24px 'JetBrains Mono', ui-monospace, monospace";
          g.fillStyle = "rgba(236, 230, 217, 0.62)";
          const credit = `${chord.painting.who.toLowerCase()}, ${chord.painting.title.toLowerCase()}, ${chord.painting.year}`;
          for (const l of wrap(credit, g.font, W - pad * 2).slice(0, 1)) {
            g.fillText(l, pad, H - pad - 86);
          }
          g.fillStyle = "rgba(236, 230, 217, 0.42)";
          g.fillText("dmklochko.com/today", pad, H - pad - 40);

          cv.toBlob((blob) => {
            const a = document.createElement("a");
            a.href = URL.createObjectURL(blob);
            a.download = `today-${chord.id}-${b.dataset.story}.png`;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 4000);
          }, "image/png");
        });
      }
    })();
  </script>
</Layout>
