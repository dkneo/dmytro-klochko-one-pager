---
import Layout from "../layouts/Layout.astro";
import AsciiShader from "../components/AsciiShader.astro";

// One highlighted phrase per paragraph. Marking more would be marking none.
const ways = [
  'natural aptitude for <b>taste</b>, action bias, &amp; having too much fun shipping. <b>clairvoyance</b>, aggressive optimism. following my nose. very fucking clean and direct in my comms.',
  "culture in my teams is something i'm incredibly proud of: violent intolerance for mediocre work. anime-level <b>fellowship</b> &amp; camaraderie. fearlessness. relentless pursuit of the mission.",
  "unhealthy excitement about customers {more users in my slack than team members lol}. making my products <b>feel like magic</b>. extensive experience working with the world's best brand agencies.",
] as const;

// Eight, so the board fills four across without a ragged last row. Uncut Gems
// keeps its own ratio: the line is burned into the frame and a square crop
// cuts it in half.
const wall = [
  { src: "/images/wall/w01.jpg", cap: "dieter rams" },
  { src: "/images/wall/w05.jpg", cap: "hajime sorayama" },
  { src: "/images/wall/w06.jpg", cap: "ryuichi sakamoto" },
  { src: "/images/wall/w07.jpg", cap: "brian eno" },
  { src: "/images/wall/w02.jpg", cap: "steve jobs, at home" },
  { src: "/images/wall/w04.jpg", cap: "steve jobs, on the way" },
  { src: "/images/wall/w08.jpg", cap: "robin williams" },
  { src: "/images/wall/w09.jpg", cap: "matthew mcconaughey" },
] as const;

const vlogs = [
  { label: "kbs interview", place: "korea", href: "https://www.instagram.com/p/DYhL6c9Ti8M/", video: "vlog-kbs" },
  { label: "vienna", place: "austria", href: "https://www.instagram.com/p/DYXLh6rI2JI/", video: "vlog-vienna" },
  { label: "in paris", place: "france", href: "https://www.instagram.com/p/DYheZtSNZxM/", video: "vlog-paris" },
  { label: "london", place: "the film", video: "film-london" },
  { label: "live on tvnz", place: "new zealand", video: "tvnz-live" },
  { label: "finding connection", place: "dok.fest münchen", video: "dokfest" },
] as const;

const books = [
  "the lord of the rings, j.r.r. tolkien",
  "upstream, mary oliver",
  "gaspard de la nuit, aloysius bertrand (also the ravel suite)",
  "man's search for meaning, viktor frankl",
] as const;

const title = "modus operandi · dmytro klochko";
const description =
  "how dmytro klochko works, what he is building next, and everything on the wall.";
---

<Layout title={title} description={description} current="modus-operandi">
  <section class="shell session" id="top" aria-labelledby="a1">
    <div class="card">
      <p class="card-no">01</p>
      <h1 class="card-title" id="a1">how i work</h1>
    </div>
    <div class="bay">
      <div class="prose">
        {ways.map((w) => <p set:html={w} />)}
      </div>

      <figure class="lynch">
        <img
          src="/images/lynch.jpg"
          alt="David Lynch at a desk, subtitled: we never get any time to experiment, we never get any time to, you know, go dreamy"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="shell session" id="next" aria-labelledby="a2">
    <div class="card">
      <p class="card-no">02</p>
      <h2 class="card-title" id="a2">what i am working on now</h2>
    </div>

    <div class="bay">
      <div>
        <p class="lede">a new era for replika.</p>
        <div class="prose">
          <p>
            a truly novel product, and a beautiful one: agentic ai with real eq, brought to
            everyone, to help people become themselves and flourish.
          </p>
          <p>in stealth.</p>
          <p>
            the thinking behind it is in{" "}
            <a href="https://replika.com/manifesto" target="_blank" rel="noreferrer">the manifesto<span class="arw">↗</span></a>,
            which i wrote.
          </p>
        </div>
      </div>

      <figure class="wall-wide">
        <img src="/images/wall/w10.jpg" alt="Uncut Gems: let's fucking bet on this" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="shell session" id="camera" aria-labelledby="a4">
    <div class="card">
      <p class="card-no">03</p>
      <h2 class="card-title" id="a4">on camera</h2>
    </div>

    <div class="reel">
      {
        vlogs.map((v) =>
          v.href ? (
            <a href={v.href} target="_blank" rel="noreferrer">
              <span class="frame">
                <video autoplay muted loop playsinline preload="metadata" poster={`/video/${v.video}-poster.jpg`} aria-hidden="true">
                  <source src={`/video/${v.video}.webm`} type="video/webm" />
                  <source src={`/video/${v.video}.mp4`} type="video/mp4" />
                </video>
              </span>
              <span class="cap">{v.label} — {v.place}<span class="arw">↗</span></span>
            </a>
          ) : (
            <figure>
              <span class="frame">
                <video autoplay muted loop playsinline preload="metadata" poster={`/video/${v.video}-poster.jpg`} aria-hidden="true">
                  <source src={`/video/${v.video}.webm`} type="video/webm" />
                  <source src={`/video/${v.video}.mp4`} type="video/mp4" />
                </video>
              </span>
              <span class="cap">{v.label} — {v.place}</span>
            </figure>
          )
        )
      }
    </div>
  </section>

  <section class="shell session" id="wall" aria-labelledby="a3">
    <div class="card">
      <p class="card-no">04</p>
      <h2 class="card-title" id="a3">literally me</h2>
    </div>

    <div class="wall">
      {
        wall.map((w) => (
          <figure>
            <span class="cell">
              <img src={w.src} alt={w.cap} loading="lazy" />
            </span>
            <figcaption>{w.cap}</figcaption>
          </figure>
        ))
      }
    </div>

  </section>

  <section class="shell session" id="taste" aria-labelledby="a6">
    <div class="card">
      <p class="card-no">05</p>
      <h2 class="card-title" id="a6">taste</h2>
    </div>

    <div class="bay">
      <ol class="log shelf">
        {books.map((b) => <li><p>{b}</p></li>)}
      </ol>

      <a
        class="record"
        href="https://open.spotify.com/playlist/4eD4OFwaWkhh8n6WcEUhUg"
        target="_blank"
        rel="noreferrer"
      >
        <AsciiShader
          class="ascii--vinyl"
          src="/ascii/vinyl-sheet.jpg"
          frames={30}
          cols={54}
          fps={16}
          black={0.02}
          white={0.99}
          gamma={0.9}
        />
        <span class="record-meta">
          <b>space cowboy<span class="arw">↗</span></b>
          <em>the playlist</em>
        </span>
      </a>
    </div>

    <div class="sheet">
      <figure>
        <span class="cell">
          <img src="/images/swag-label.jpg" alt="A garment label reading: glad we're in this together. Replika, 2025" loading="lazy" />
        </span>
        <figcaption>the label</figcaption>
      </figure>
      <figure>
        <span class="cell">
          <img src="/images/swag-hoodie.jpg" alt="A green Replika hoodie on a chair against a deep blue backdrop" loading="lazy" />
        </span>
        <figcaption>the hoodie</figcaption>
      </figure>
      <figure>
        <span class="cell">
          <img src="/images/swag-team.jpg" alt="Dmytro and a colleague in Replika swag by a lake" loading="lazy" />
        </span>
        <figcaption>worn in</figcaption>
      </figure>
    </div>
    <p class="poem-by">
      replika's 2025 merch. i designed it, down to the label
      <a href="https://x.com/replika/status/1991136959385817336" target="_blank" rel="noreferrer">↗</a>
    </p>

    <p class="poem-by">random poems. mine, 2026.</p>

    <div class="poems">
      <blockquote class="poem">
        i am lost in sorrento<br />
        for i am the taste of its lemons and its women's feet<br />
        i'm the salt of its breeze<br />
        i'm so glad i can't breathe<br />
        i'm so tall i am whole twelve feet
      </blockquote>
      <blockquote class="poem">
        this girl is the warm sensation of young sun on my bare chest<br />
        her chestnut irises, and the greens in them, glimmer with playful unrest<br />
        when she whispers her spells, her tricks, and her promises, i couldn't get any slumber<br />
        for she carries inside her an eternal summer, an eternal summer
      </blockquote>
    </div>
  </section>
</Layout>
