---
import map from "../data/map.json";
import palettes from "../data/palettes.json";
import sharp from "sharp";

// The portrait: what the library says about him in one look.
//
// Every sentence and every bar is computed from the vault at build time.
// Nothing is written by hand here, so it cannot drift from what the rooms
// below it actually hold, and it cannot flatter — it says which room is the
// thinnest as plainly as which is the fullest.
//
// It renders twice: whole at the top of /eidos, and compact on the homepage,
// where it is the door to the library. Same component, same numbers.

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const HANGS = new Set(["painting", "object", "building", "poster", "print", "photograph"]);
const shelved = map.items.filter((i) => i.type !== "link");
const isHim = (who: string) => /^dmytro klochko$/i.test((who || "").trim());

const weathers = map.weathers.slice().sort((a, b) => a.x - b.x).map((w) => ({
  name: w.name,
  why: w.why,
  slug: w.name.replace(/\W+/g, "-"),
  n: shelved.filter((i) => i.weather === w.name).length,
  stops: (palettes.palettes.find((p) => p.weather === w.name) || { stops: [] }).stops,
}));
const total = shelved.length;
const filed = weathers.reduce((s, w) => s + w.n, 0);
const ring = total - filed;

const art = shelved.filter((i) => HANGS.has(i.type));
const own = art.filter((i) => isHim(i.who));
const years = art
  .map((i) => (String(i.year || "").match(/\b(1[0-9]{3}|20[0-9]{2})\b/) || [])[1])
  .filter(Boolean).map(Number);
const span = years.length ? [Math.min(...years), Math.max(...years)] : null;

const makers = new Map<string, number>();
for (const i of shelved) if (i.who && !isHim(i.who)) makers.set(i.who, (makers.get(i.who) || 0) + 1);
const recurring = [...makers].filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1]).map(([w]) => w);
const painters = recurring.filter((w) => art.some((i) => i.who === w)).slice(0, 4);
const writers = recurring.filter((w) => !art.some((i) => i.who === w)).slice(0, 3);
const tongues = [...new Set(shelved.map((i: any) => i.lang).filter(Boolean))];
const byFullness = weathers.slice().sort((a, b) => b.n - a.n);
const fullest = byFullness[0], thinnest = byFullness[byFullness.length - 1];

const plateFor = (src: string) => src.replace("/images/", "/images/plates/").replace(/\.[^.]+$/, ".webp");
// his own pictures first, then one by each painter who recurs, then the rest
const seen = new Set<string>();
const plates: typeof art = [];
for (const i of [...own, ...painters.map((w) => art.find((a) => a.who === w)), ...art]) {
  if (!i || seen.has(i.id) || !i.src) continue;
  seen.add(i.id);
  plates.push(i);
  if (plates.length >= (compact ? 8 : 12)) break;
}
const plateDims: Record<string, { w: number; h: number }> = {};
for (const pl of plates) {
  const m = await sharp(`public${plateFor(pl.src)}`).metadata();
  plateDims[pl.id] = { w: m.width || 0, h: m.height || 0 };
}
const list = (xs: string[]) => xs.length <= 1 ? xs.join("") : xs.slice(0, -1).join(", ") + " and " + xs[xs.length - 1];
const lower = (s: string) => s.toLowerCase();
---

<div class={`eidos-portrait${compact ? " is-compact" : ""}`}>
  <p class="ep-line">
    {total} real things i love, filed under eight weathers i made up.
    {" "}it runs cold to warm; <b>{fullest.name}</b> is the fullest room and{" "}
    <b>{thinnest.name}</b> the thinnest.
    {" "}{own.length ? `${own.length} of the ${art.length} pictures are mine; the rest lean to ${list(painters.map(lower))}.` : `${art.length} pictures, leaning to ${list(painters.map(lower))}.`}
    {" "}{writers.length ? `the words keep coming back to ${list(writers.map(lower))}, in ${tongues.length} languages.` : `the words come in ${tongues.length} languages.`}
    {" "}nothing here was generated: every mark is a real thing, attributed.
  </p>

  {/* the weathers as a strip of their own paint, each as wide as it is full */}
  <ol class="ep-strip" aria-label="the eight weathers, cold to warm, sized by how much each holds">
    {weathers.map((w) => (
      <li style={`--w:${w.n};--g:linear-gradient(90deg,${w.stops.join(",")})`}>
        <a href={compact ? `/eidos#w-${w.slug}` : `#w-${w.slug}`} title={`${w.name} · ${w.n}`} aria-label={`${w.name}, ${w.n} things`}><i aria-hidden="true"></i></a>
      </li>
    ))}
  </ol>
  <ul class="ep-legend" aria-hidden="true">
    {weathers.map((w) => (
      <li><i style={`background:${w.stops[Math.floor(w.stops.length / 2)] || "#888"}`}></i>{w.name}<b>{w.n}</b></li>
    ))}
  </ul>

  <ul class="ep-plates" aria-label="a few of the pictures">
    {plates.map((p) => (
      <li>
        <a href={compact ? `/eidos#${p.id}` : `#${p.id}`} title={`${p.title || p.line}${p.who ? " — " + p.who : ""}`}>
          <img src={plateFor(p.src)} alt={`${p.title || p.line}${p.who ? ", " + p.who : ""}`}
               width={plateDims[p.id]?.w} height={plateDims[p.id]?.h} loading="lazy" decoding="async" />
        </a>
      </li>
    ))}
  </ul>

  <dl class="ep-counts">
    <div><dt>things</dt><dd>{total}</dd></div>
    <div><dt>makers</dt><dd>{makers.size + (own.length ? 1 : 0)}</dd></div>
    <div><dt>languages</dt><dd>{tongues.length}</dd></div>
    {span && <div><dt>years</dt><dd>{span[0]}–{span[1]}</dd></div>}
    <div class="is-open"><dt>unfiled</dt><dd>{ring}</dd></div>
  </dl>

  {compact && (
    <a class="ep-go" href="/eidos">the whole library<span class="arw" aria-hidden="true">↗</span></a>
  )}
</div>

<style>
  /* A component, so the rules are scoped; the tokens are the site's. */
  .eidos-portrait {
    display: grid;
    gap: var(--sp-3);
    max-width: 62rem;
  }

  .ep-line {
    margin: 0;
    max-width: 58ch;
    font-family: var(--serif);
    font-size: var(--t-lede);
    font-style: italic;
    line-height: 1.45;
    color: var(--bone);
  }
  .ep-line b { font-weight: 400; color: var(--hot); }
  .is-compact .ep-line { font-size: var(--t-lg); }

  /* the strip: one bar per weather, flex-grown by its count, painted with
     its own palette. The names sit under it in mono; on the compact card
     they yield to the title attribute and a hover. */
  .ep-strip {
    display: flex;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ep-strip li { flex: max(var(--w), 1) 1 0; min-width: 24px; }
  .ep-strip a {
    display: flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
  }
  .ep-strip i {
    display: block;
    width: 100%;
    height: 14px;
    border-radius: var(--r-print);
    background: var(--g);
    transition: transform var(--dur) var(--ease), filter var(--dur) var(--ease);
  }
  .ep-strip a:hover i, .ep-strip a:focus-visible i { transform: translateY(-2px); filter: brightness(1.15); }
  .is-compact .ep-strip i { height: 10px; }

  /* the names, in one row that wraps, so no weather is ever cut short */
  .ep-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem var(--sp-2);
    margin: calc(var(--sp-1) - var(--sp-3)) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .ep-legend li { display: inline-flex; align-items: center; gap: 0.45em; white-space: nowrap; }
  .ep-legend i { width: 8px; height: 8px; border-radius: 50%; }
  .ep-legend b { font-weight: 400; color: var(--quiet); }
  .is-compact .ep-legend { display: none; }

  /* the plates: a row of pictures at their own proportions, one height */
  .ep-plates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ep-plates li { flex: none; }
  .ep-plates a { display: block; }
  .ep-plates img {
    display: block;
    height: 84px;
    width: auto;
    border-radius: var(--r-print);
    box-shadow: 0 2px 6px var(--shadow-deep);
    transition: transform var(--dur) var(--ease);
  }
  .is-compact .ep-plates img { height: 64px; }
  .ep-plates a:hover img, .ep-plates a:focus-visible img { transform: translateY(-2px); }

  .ep-counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    margin: 0;
  }
  .ep-counts dt {
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .ep-counts dd {
    margin: 0.1rem 0 0;
    font-family: var(--display);
    font-weight: 300;
    font-size: var(--dream-fact, 1.22rem);
    color: var(--bone);
  }
  .ep-counts .is-open dd { color: var(--hot); }

  .ep-go {
    justify-self: start;
    font-family: var(--mono);
    font-size: var(--t-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--hot);
    border-bottom: 1px solid rgb(255 155 192 / 30%);
    padding-bottom: 1px;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .ep-go:hover { border-color: var(--hot); }

  @media (prefers-reduced-motion: reduce) {
    .ep-strip i, .ep-plates img { transition: none; }
  }
</style>
