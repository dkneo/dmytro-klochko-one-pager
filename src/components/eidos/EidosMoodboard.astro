---
interface Props {
  items: any[];
  dimensions: Record<string, { width: number; height: number }>;
  colors: Record<string, { hex: string; key: number }>;
}
const { items, dimensions, colors } = Astro.props;
const plateFor = (src: string) => src.replace("/images/", "/images/plates/").replace(/\.[^.]+$/, ".webp");
const glue = (text: string) => String(text ?? "").replace(/\s+([!?;:»])/g, "\u202F$1").replace(/(«)\s+/g, "$1\u202F");
const kind = (type: string) => type === "person" ? "person" : type;
---
<section class="ep-moodboard" id="collection" aria-labelledby="collection-title" data-visual-moodboard>
  <header class="ep-moodboard-head">
    <h2 id="collection-title">things that stop me.</h2>
    <p>{items.length} paintings, photographs, people and objects. every one real, every one credited.</p>
  </header>

  <div class="ep-mood-views" role="group" aria-label="change how the moodboard is arranged">
    <span>arrange</span>
    <button type="button" data-mood-view="salon" aria-pressed="true">salon</button>
    <button type="button" data-mood-view="color" aria-pressed="false">sort by color</button>
    <button type="button" data-mood-view="favorites" aria-pressed="false">absolute favorites</button>
  </div>

  <div class="ep-mood-grid">
    {items.map((item: any, index: number) => (
      <figure
        class={`ep-visual ep-visual--${index % 7}`}
        data-visual-piece
        data-id={item.id}
        data-index={index}
        data-color-key={colors[item.id]?.key ?? 999}
        data-favorite={item.favorite ? "true" : "false"}
        style={`--piece-color:${colors[item.id]?.hex || "transparent"}`}
      >
        <button type="button" class="ep-visual-open" aria-label={`open ${glue(item.title || item.line)}`}>
          <img
            src={plateFor(item.src)}
            alt={glue(item.title || item.line || item.type)}
            width={dimensions[item.id]?.width}
            height={dimensions[item.id]?.height}
            loading={index < 8 ? "eager" : "lazy"}
            decoding="async"
          />
        </button>
        <figcaption>
          <span><i aria-hidden="true"></i>{kind(item.type)}</span>
          <b>{glue(item.line || item.title)}</b>
          {item.who && <small>{item.who}{item.year ? ` · ${item.year}` : ""}</small>}
        </figcaption>
      </figure>
    ))}
  </div>
  <p class="ep-mood-empty" data-mood-empty hidden>
    nothing has been marked absolute yet. <a href="/eidos/inbox">choose one in Studio.</a>
  </p>

  <dialog class="ep-detail" data-mood-detail>
    <button type="button" class="ep-detail-close" aria-label="close image">close</button>
    <div data-detail-body></div>
  </dialog>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-visual-moodboard]");
    if (!root) return;
    const detail = root.querySelector("[data-mood-detail]");
    const body = root.querySelector("[data-detail-body]");
    const grid = root.querySelector(".ep-mood-grid");
    const pieces = [...root.querySelectorAll("[data-visual-piece]")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const arrange = (view, button) => {
      const paint = () => {
        const ordered = view === "color"
          ? pieces.slice().sort((a, b) => Number(a.dataset.colorKey) - Number(b.dataset.colorKey) || Number(a.dataset.index) - Number(b.dataset.index))
          : pieces;
        grid.append(...ordered);
        pieces.forEach((piece) => { piece.hidden = view === "favorites" && piece.dataset.favorite !== "true"; });
        root.dataset.view = view;
        root.querySelector("[data-mood-empty]").hidden = view !== "favorites" || pieces.some((piece) => piece.dataset.favorite === "true");
        root.querySelectorAll("[data-mood-view]").forEach((choice) => choice.setAttribute("aria-pressed", String(choice === button)));
      };
      paint();
      if (!reduce.matches) grid.animate(
        [{ opacity: 0.72, transform: "translateY(4px)" }, { opacity: 1, transform: "none" }],
        { duration: 220, easing: "cubic-bezier(.2,0,.2,1)" },
      );
    };
    root.querySelectorAll("[data-mood-view]").forEach((button) => button.addEventListener("click", () => arrange(button.dataset.moodView, button)));
    root.querySelectorAll(".ep-visual-open").forEach((button) => button.addEventListener("click", () => {
      const piece = button.closest("[data-visual-piece]");
      const clone = piece.cloneNode(true);
      clone.querySelector(".ep-visual-open").disabled = true;
      body.replaceChildren(clone);
      detail.showModal();
    }));
    root.querySelector(".ep-detail-close")?.addEventListener("click", () => detail.close());
    detail?.addEventListener("click", (event) => {
      if (event.target === detail) detail.close();
    });
  })();
</script>
