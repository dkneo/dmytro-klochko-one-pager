---
interface Props {
  current?: "moodboard" | "atlas" | "experiment" | "play" | "studio" | "places";
  studio?: boolean;
}
const { current = "moodboard", studio = false } = Astro.props;
---
<header class="ep-header">
  <a class="ep-wordmark" href="/eidos" aria-label="Eidos home">
    <span>eidos</span><i aria-hidden="true"></i>
  </a>
  <nav class="ep-nav" aria-label={studio ? "studio" : "Eidos"}>
    <a href="/eidos#collection" aria-current={current === "moodboard" ? "page" : undefined}>moodboard</a>
    <a href="/eidos/deck" aria-current={current === "experiment" || current === "play" ? "page" : undefined}>play</a>
    <a href="/eidos/inbox" aria-current={current === "studio" ? "page" : undefined}>studio</a>
    <a href="/eidos/places" aria-current={current === "places" ? "page" : undefined}>where</a>
  </nav>
  <a class="ep-parent" href="/">
    <span class="ep-parent-name">dmytro klochko</span>
    <span class="ep-parent-mobile">site</span>
    <span class="ep-parent-arrow" aria-hidden="true">↗</span>
  </a>
</header>
