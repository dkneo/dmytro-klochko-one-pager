---
interface Props {
  current?: "moodboard" | "atlas" | "experiment" | "play" | "discover" | "studio" | "map" | "reads" | "portrait";
  studio?: boolean;
}
const { current = "moodboard", studio = false } = Astro.props;
---
<header class="ep-header">
  <a class="ep-wordmark" href="/eidos" aria-label="Eidos home">
    <span>eidos</span>
    <img class="ep-faun-mark" src="/images/responsive/eidos/faun-mark-540.webp" srcset="/images/responsive/eidos/faun-mark-96.webp 96w, /images/responsive/eidos/faun-mark-540.webp 540w" sizes="34px" width="720" height="720" alt="" aria-hidden="true" />
  </a>
  <nav class="ep-nav" aria-label={studio ? "discover" : "Eidos"}>
    <a href="/eidos#collection" aria-current={current === "moodboard" ? "page" : undefined}>moodboard</a>
    <a href="/eidos/inbox" aria-current={current === "discover" || current === "studio" ? "page" : undefined}>discover</a>
    <a href="/eidos/portrait" aria-current={current === "portrait" ? "page" : undefined}>portrait</a>
    <a href="/eidos/map" aria-current={current === "map" ? "page" : undefined}>map</a>
  </nav>
  <a class="ep-parent" href="/">
    <span class="ep-parent-name">dmytro klochko</span>
    <span class="ep-parent-mobile">site</span>
    <span class="ep-parent-arrow" aria-hidden="true">↗</span>
  </a>
</header>
