---
interface Props {
  /** Omit for footage that has no post to link out to yet; the tile renders
      as a plain figure and drops the arrow, rather than faking a destination. */
  href?: string;
  /** Basename in /video, e.g. "vlog-kbs" — resolves to .webm, .mp4 and -poster.jpg */
  video?: string;
  image?: string;
  alt: string;
  label: string;
  class: string;
}

const { href, video, image, alt, label, class: className } = Astro.props;
const Tag = href ? "a" : "figure";
const linkProps = href ? { href, target: "_blank", rel: "noreferrer" } : {};
---

<Tag class={className} {...linkProps}>
  <span class="media-image">
    {
      video ? (
        // aria-hidden: the visible label already names this clip, so
        // announcing it again would just duplicate it.
        <video
          class="media-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={`/video/${video}-poster.jpg`}
          aria-hidden="true"
        >
          <source src={`/video/${video}.webm`} type="video/webm" />
          <source src={`/video/${video}.mp4`} type="video/mp4" />
        </video>
      ) : (
        <img src={image} alt={alt} loading="lazy" />
      )
    }
  </span>
  <span class="media-label">
    {label} {href && <span aria-hidden="true" class="arrow">↗</span>}
  </span>
</Tag>
