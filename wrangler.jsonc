{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmytro-klochko-one-pager",
  "compatibility_date": "2026-08-07",
  // The site is still static assets. The worker exists only for the curation
  // queue and hands every other path straight to ASSETS, so the pages are
  // served the same way they were before it existed.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every path the worker owns must be listed here. The asset layer runs
    // first for anything else, and with a 404 page in dist it answers an
    // unknown path itself — the worker never sees it. On 8 Sep 2026 a 404
    // page shipped and /names, /eidos/sit and every /api/* door returned the
    // 404 page for fifteen hours. tests/pages.test.mjs pins this list against
    // the routes in worker/index.js; scripts/ship.sh knocks on the doors after
    // every deploy.
    "run_worker_first": [
      "/names", "/names/*",
      "/ask", "/ask/*",
      "/scout", "/scout/*",
      "/api/*",
      "/eidos/sit", "/eidos/sit/",
      "/curate", "/curate/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "VAULT",
      "id": "d5e466fe143e4b8aadce72dd01da4507"
    }
  ],
  "vars": {
    // Set once the Cloudflare Access application exists. Until both are real
    // the curation routes answer 503 and nothing can be written.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "CURATOR": "1@dmklochko.com"
  }
}
