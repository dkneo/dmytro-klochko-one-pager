 "narrative": {
  "northStar": "Two skies over one page: a woodblock dusk (dream, default) and a terminal in deep space (bebop).",
  "overview": "Dream is sampled, never invented: Bradford's dusk and moon, Kawase's pink clouds and water, Sait\u014d's quiet and his red seal. Serif speaks sentences; mono keeps machinery. Pink is his favourite colour and the accent.",
  "keyCharacteristics": [
   "sampled palette",
   "hanko seals",
   "mounted prints",
   "petals & parallax sky",
   "serif/mono two-voice"
  ],
  "rules": [
   "Sampled Sky",
   "Seal Hugs Its Number",
   "Moon Yields",
   "Arrow Is Inline",
   "Peek is hover-only"
  ],
  "dos": [
   "derive colour/art from the paintings",
   "one compensating serif size step",
   "answer hover with lift+settle"
  ],
  "donts": [
   "no invented captions",
   "no hand-drawn figurative art",
   "no desaturated family photos",
   "no free hairlines"
  ]
